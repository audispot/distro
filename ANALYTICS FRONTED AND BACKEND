                    </div>
                    <div class="bg-brand-card border border-brand-border p-6 rounded-2xl">
                        <h2 class="text-sm font-semibold text-white mb-4">Streams Over Time</h2>
                        <div class="relative w-full h-72"><canvas id="analyticsOverviewChart"></canvas></div>
                    </div>
                    <div class="bg-brand-card border border-brand-border rounded-2xl p-6">

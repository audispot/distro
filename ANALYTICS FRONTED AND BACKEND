    function filterPlatformsList() {
        const query = (document.getElementById('platform-search-input')?.value || '').toLowerCase();
        const buttons = document.querySelectorAll('#platform-grid-items button');
        buttons.forEach(btn => {
            const text = btn.innerText.toLowerCase();

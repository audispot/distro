    function renderAnalyticsView() {
        return `
            <div class="max-w-7xl mx-auto space-y-6">
                <!-- Header & Filters -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-2xl font-bold text-white">Analytics & Performance</h1>
                        <p class="text-xs text-gray-400 mt-1">Real-time performance across DSPs</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <select id="analytics-period-select" class="bg-brand-card border border-brand-border text-white text-xs rounded-xl px-3 py-2 outline-none focus:border-brand-primary">
                            <option value="lastSevenDays">Last 7 Days</option>
                            <option value="lastThirtyDays" selected>Last 30 Days</option>
                            <option value="lastThreeMonths">Last 3 Months</option>
                            <option value="lastSixMonths">Last 6 Months</option>
                            <option value="lastYear">Last Year</option>
                            <option value="allTime">All Time</option>
                        </select>
                    </div>
                </div>

                <!-- Sub-Navigation Bar -->
                <div class="flex items-center gap-2 border-b border-brand-border pb-2 overflow-x-auto">
                    <button onclick="switchAnalyticsTab('overview')" id="tab-btn-overview" class="analytics-tab-btn text-xs font-semibold px-4 py-2 rounded-lg text-white bg-brand-primary">Overview</button>
                    <button onclick="switchAnalyticsTab('platforms')" id="tab-btn-platforms" class="analytics-tab-btn text-xs font-semibold px-4 py-2 rounded-lg text-gray-400 hover:text-white">Platforms</button>
                    <button onclick="switchAnalyticsTab('demographics')" id="tab-btn-demographics" class="analytics-tab-btn text-xs font-semibold px-4 py-2 rounded-lg text-gray-400 hover:text-white">Demographics</button>
                </div>

                <!-- Inline Alert Message Area -->
                <div id="analytics-alert-area" class="hidden"></div>

                <!-- Tab Content Viewport -->
                <div id="analytics-tab-viewport"></div>
            </div>
        `;
    }

    async function initAnalyticsDashboard(period = 'lastThirtyDays') {
        currentAnalyticsPeriod = period;

        const periodSelect = document.getElementById('analytics-period-select');
        if (periodSelect) {
            periodSelect.value = period;
            if (!periodSelect.dataset.listenerAttached) {
                periodSelect.dataset.listenerAttached = "true";
                periodSelect.addEventListener('change', (e) => initAnalyticsDashboard(e.target.value));
            }
        }

        renderActiveTabContent();
    }

    function switchAnalyticsTab(tabName) {
        activeAnalyticsTab = tabName;
        document.querySelectorAll('.analytics-tab-btn').forEach(btn => {
            btn.classList.remove('bg-brand-primary', 'text-white');
            btn.classList.add('text-gray-400');
        });
        const selectedBtn = document.getElementById(`tab-btn-${tabName}`);
        if (selectedBtn) {
            selectedBtn.classList.add('bg-brand-primary', 'text-white');
            selectedBtn.classList.remove('text-gray-400');
        }
        renderActiveTabContent();
    }

    async function renderActiveTabContent() {
        const viewport = document.getElementById('analytics-tab-viewport');
        if (!viewport) return;

        if (activeAnalyticsTab === 'overview') {
            viewport.innerHTML = `
                <div class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4" id="analytics-kpi-container">
                        <div class="bg-brand-card border border-brand-border p-5 rounded-2xl animate-pulse h-20"></div>
                        <div class="bg-brand-card border border-brand-border p-5 rounded-2xl animate-pulse h-20"></div>
                        <div class="bg-brand-card border border-brand-border p-5 rounded-2xl animate-pulse h-20"></div>

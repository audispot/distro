    async function getAuthToken() {
        if (!window.currentUser) return null;
        return typeof window.currentUser.getIdToken === 'function'
            ? await window.currentUser.getIdToken(true)
            : window.currentUser.accessToken || null;
    }

    async function fetchOverviewData() {
        const token = await getAuthToken();
        if (!token) return showAlert("Authentication required. Please sign in again.", "error");

        const workerUrl = window.WORKER_BASE_URL || 'https://audiorydistribution.dandredurkofficial.workers.dev';

        try {
            const [overviewRes, tracksRes] = await Promise.all([
                fetch(`${workerUrl}/api/analytics/overview?period=${currentAnalyticsPeriod}`, { headers: { 'Authorization': `Bearer ${token}` } }),
                fetch(`${workerUrl}/api/analytics/tracks?period=${currentAnalyticsPeriod}&page=1&perPage=10`, { headers: { 'Authorization': `Bearer ${token}` } })
            ]);

            if (overviewRes.ok) {
                const overviewJson = await overviewRes.json();
                const data = overviewJson.data || overviewJson;
                renderKPIs(data);
                renderChart(data.chart || []);
            }

            if (tracksRes.ok) {
                const tracksJson = await tracksRes.json();
                renderTracksTable(tracksJson.data || []);
            }
        } catch (err) {
            showAlert("Failed to load analytics overview.", "error");
        }
    }

    async function fetchPlatformData(platform = 'spotify') {
        const token = await getAuthToken();
        if (!token) return;

        const workerUrl = window.WORKER_BASE_URL || 'https://audiorydistribution.dandredurkofficial.workers.dev';

        try {
            const res = await fetch(`${workerUrl}/api/analytics/platforms?platform=${platform}&period=${currentAnalyticsPeriod}`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const json = await res.json();

            if (res.ok) {
                const payload = json.data || json;
                const totalStreams = payload.totalStreams || payload.streams || 0;
                
                const streamsCountEl = document.getElementById('platform-streams-count');
                if (streamsCountEl) {
                    streamsCountEl.innerText = Number(totalStreams).toLocaleString();
                }

                renderPlatformChart(payload.chart || []);
                renderPlatformTracks(payload.tracks || []);
                renderPlatformCountries(payload.countries || []);
            }
        } catch (err) {
            showAlert("Error loading platform streams.", "error");
        }
    }

    function renderPlatformChart(chartData) {
        const canvas = document.getElementById('platformStreamsChart');
        if (!canvas) return;

        if (platformChartInstance) {
            platformChartInstance.destroy();
        }

        const labels = chartData.length > 0 ? chartData.map(p => p.date) : ['2026-05-28', '2026-06-27'];
        const streams = chartData.length > 0 ? chartData.map(p => p.streams || p.totalStreams) : [0, 0];

        const ctx = canvas.getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(124, 58, 237, 0.35)');
        gradient.addColorStop(1, 'rgba(124, 58, 237, 0.0)');

        platformChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Total Streams',
                    data: streams,
                    borderColor: '#8b5cf6',
                    backgroundColor: gradient,
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(255, 255, 255, 0.03)' }, ticks: { color: '#6b7280', font: { size: 10 } } },
                    y: { grid: { color: 'rgba(255, 255, 255, 0.03)' }, ticks: { color: '#6b7280', font: { size: 10 } } }
                }
            }
        });
    }

    function renderPlatformTracks(tracks) {
        const container = document.getElementById('platform-tracks-list');
        if (!container) return;

        if (!tracks || tracks.length === 0) {
            container.innerHTML = `<div class="text-xs text-gray-500 text-center py-6">No track data for this platform.</div>`;
            return;
        }

        const maxStreams = Math.max(...tracks.map(t => t.streams || 0)) || 1;

        container.innerHTML = tracks.map(t => {
            const pct = Math.round(((t.streams || 0) / maxStreams) * 100);
            return `
                <div class="flex items-center justify-between p-2 rounded-xl hover:bg-white/5 transition-colors">
                    <div class="flex items-center gap-3">
                        <img src="${t.coverUrl || 'https://via.placeholder.com/40'}" class="w-9 h-9 rounded-lg object-cover" />
                        <div>
                            <p class="text-xs font-semibold text-white truncate max-w-[150px]">${t.title || 'Untitled Track'}</p>
                            <p class="text-[10px] text-gray-400">${t.artist || 'Unknown Artist'}</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="text-xs font-bold text-indigo-400">${pct.toFixed(2)}%</span>
                        <p class="text-[10px] text-gray-400">${Number(t.streams || 0).toLocaleString()} streams</p>
                    </div>
                </div>
            `;
        }).join('');
    }

    function renderPlatformCountries(countries) {
        const container = document.getElementById('platform-countries-list');
        if (!container) return;

        if (!countries || countries.length === 0) {
            container.innerHTML = `<div class="text-xs text-gray-500 text-center py-6">No country data for this platform.</div>`;
            return;
        }

        container.innerHTML = countries.map(c => `
            <div class="flex items-center justify-between p-2 rounded-xl hover:bg-white/5 transition-colors">
                <div class="flex items-center gap-3">
                    <span class="text-sm">${c.flag || '🌐'}</span>
                    <span class="text-xs font-medium text-white">${c.name || 'Unknown'}</span>
                </div>
                <span class="text-xs font-bold text-indigo-400">${c.percentage ? Number(c.percentage).toFixed(2) + '%' : '-'}</span>
            </div>
        `).join('');
    }

    async function fetchDemographicData() {
        const token = await getAuthToken();
        const container = document.getElementById('demographics-content-area');
        if (!token || !container) return;

        const workerUrl = window.WORKER_BASE_URL || 'https://audiorydistribution.dandredurkofficial.workers.dev';

        try {
            const res = await fetch(`${workerUrl}/api/analytics/platforms?platform=spotify&period=${currentAnalyticsPeriod}`, {
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const json = await res.json();

            if (res.ok && json.data) {
                const data = json.data;
                container.innerHTML = `
                    <div class="grid grid-cols-2 gap-3 p-2">
                        <div class="p-3 bg-brand-border/20 rounded-lg">
                            <span class="text-xs text-gray-400">Total Streams</span>
                            <p class="text-lg font-bold text-emerald-400 mt-1">${Number(data.streams || data.totalStreams || 0).toLocaleString()}</p>
                        </div>
                        <div class="p-3 bg-brand-border/20 rounded-lg">
                            <span class="text-xs text-gray-400">Listeners</span>
                            <p class="text-lg font-bold text-white mt-1">${Number(data.listeners || 0).toLocaleString()}</p>
                        </div>
                    </div>
                `;
            } else {
                container.innerHTML = `<p class="text-gray-400 text-xs py-4 text-center">Demographic breakdown unavailable for this period.</p>`;
            }
        } catch (err) {
            container.innerHTML = `<p class="text-gray-400 text-xs py-4 text-center">Unable to load demographic metrics.</p>`;
        }
    }

    function togglePlatformDropdown() {
        const menu = document.getElementById('platform-dropdown-menu');

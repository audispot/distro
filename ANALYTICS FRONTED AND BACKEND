    function renderTracksTable(tracks) {
        const tbody = document.getElementById('analytics-tracks-tbody');
        if (!tbody) return;

        if (!tracks.length) {
            tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-gray-500">No track metrics found for this period.</td></tr>`;

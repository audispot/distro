                    </div>
                </div>
            `;
            await fetchOverviewData();
        } else if (activeAnalyticsTab === 'platforms') {
            renderPlatformsView();
        } else if (activeAnalyticsTab === 'demographics') {
            viewport.innerHTML = `
                <div class="bg-brand-card border border-brand-border rounded-2xl p-6 space-y-4">

window.searchPreferencePlatform = async function() {

    const platform =
        document.getElementById(
            'pref-platform-search-type'
        )?.value || 'spotify';

    const term =
        document.getElementById(
            'pref-platform-search-term'
        )?.value?.trim() || '';

    const resultsBox =
        document.getElementById(
            'pref-platform-search-results'
        );

    const status =
        document.getElementById(
            'pref-platform-search-status'
        );

    const button =
        document.getElementById(
            'btn-pref-platform-search'
        );

    if (!term) {

        window.showPrefToast(
            'Enter an artist or channel name first.',
            'error'
        );

        return;
    }

    const token =
        window.currentUser?.getIdToken
            ? await window.currentUser.getIdToken()
            : '';

    const baseUrl =
        window.WORKER_BASE_URL || '';

    button.disabled = true;

    button.innerHTML =
        `<i class="fa-solid fa-spinner fa-spin mr-1"></i> Searching...`;

    status.innerText =
        'Searching...';

    resultsBox.classList.remove('hidden');

    resultsBox.innerHTML = `
        <div class="text-center py-5 text-xs text-gray-500">
            <i class="fa-solid fa-spinner fa-spin mr-2"></i>
            Searching...
        </div>
    `;

    try {

        const res =
            await fetch(
                `${baseUrl}/api/preferences/search/artist-platform`,
                {
                    method: 'POST',

                    headers: {
                        'Authorization':
                            `Bearer ${token}`,

                        'Content-Type':
                            'application/json'
                    },

                    body: JSON.stringify({
                        platform,
                        term,
                        limit: 10
                    })
                }
            );

        const body =
            await res.json()
                .catch(() => ({}));

        if (!res.ok) {

            throw new Error(
                body?.error ||
                body?.message ||
                'Platform search failed.'
            );
        }


        const results =
            body?.data?.results ||
            body?.data ||
            [];


        if (!Array.isArray(results) || !results.length) {

            status.innerText =
                'No results';

            resultsBox.innerHTML = `
                <div class="text-center py-5 text-xs text-gray-500">
                    No matching profiles found.
                </div>
            `;

            return;
        }


        window._preferencePlatformSearchResults =
            results;

        window._preferencePlatformSearchPlatform =
            platform;


        status.innerText =
            `${results.length} result${results.length === 1 ? '' : 's'}`;


        resultsBox.innerHTML =
            results.map((item, index) => {

                const name =
                    String(
                        item.name ||
                        'Unknown Artist'
                    )
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');


                const url =
                    String(
                        item.url || ''
                    )
                    .replace(/"/g, '&quot;');


                const image =
                    String(
                        item.image || ''
                    )
                    .replace(/"/g, '&quot;');


                const followers =
                    Number.isFinite(
                        Number(item.followers)
                    )
                        ? Number(item.followers)
                            .toLocaleString()
                        : '';


                return `
                    <button
                        type="button"
                        onclick="window.selectPreferencePlatformResult(${index})"
                        class="w-full text-left bg-black/30 hover:bg-white/5 border border-brand-border/30 hover:border-brand-border/60 rounded-xl p-3 transition-all"
                    >

                        <div class="flex items-center gap-3">

                            ${
                                image
                                    ? `
                                        <img
                                            src="${image}"
                                            class="w-10 h-10 rounded-lg object-cover bg-black/40 shrink-0"
                                            onerror="this.style.display='none'"
                                        >
                                      `
                                    : `
                                        <div class="w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center shrink-0">
                                            <i class="fa-solid fa-user text-gray-600"></i>
                                        </div>
                                      `
                            }


                            <div class="min-w-0 flex-1">

                                <div class="text-xs font-bold text-white truncate">
                                    ${name}
                                </div>

                                ${
                                    followers
                                        ? `
                                            <div class="text-[10px] text-gray-500 mt-0.5">
                                                ${followers} followers
                                            </div>
                                          `
                                        : ''
                                }

                                <div class="text-[10px] text-gray-600 truncate mt-0.5">
                                    ${url}
                                </div>

                            </div>


                            <div class="text-[10px] text-brand-primary font-bold shrink-0">
                                Select
                            </div>

                        </div>

                    </button>
                `;

            }).join('');


    } catch (error) {

        console.error(
            'Preference platform search failed:',
            error
        );

        status.innerText =
            'Search failed';

        resultsBox.innerHTML = `
            <div class="text-center py-5 text-xs text-red-400">
                ${String(
                    error?.message ||
                    'Unable to search this platform.'
                ).replace(/</g, '&lt;')}
            </div>
        `;

    } finally {

        button.disabled = false;

        button.innerHTML =
            `<i class="fa-solid fa-magnifying-glass mr-1"></i> Search`;
    }
};



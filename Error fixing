};


window.removeLabelArtist = async function(
    artistId
) {

    if (!artistId) {
        return;
    }

    window.showPreferenceConfirm(
        'Remove this artist from label management?',
        async () => {

            const token =
                window.currentUser?.getIdToken
                    ? await window.currentUser.getIdToken()
                    : '';

            const baseUrl =
                window.WORKER_BASE_URL || '';

            try {

                const res =
                    await fetch(
                        `${baseUrl}/api/preferences/label/artist/remove`,
                        {
                            method: 'POST',

                            headers: {
                                'Authorization':
                                    `Bearer ${token}`,

                                'Content-Type':
                                    'application/json',

                                'Accept':
                                    'application/json'
                            },

                            body:
                                JSON.stringify({
                                    artistId:
                                        Number(
                                            artistId
                                        )
                                })
                        }
                    );

                const text =
                    await res.text();

                let body = {};

                try {
                    body =
                        text
                            ? JSON.parse(text)
                            : {};
                } catch {
                    body = {
                        raw: text
                    };
                }

                if (!res.ok) {
                    throw new Error(
                        body?.error ||
                        body?.message ||
                        body?.details ||
                        `Failed to remove artist (${res.status}).`
                    );
                }

                window.showPrefToast(
                    'Artist removed from label.',
                    'success'
                );

                await window.loadLabelPreferences();

            } catch (err) {

                console.error(
                    'Remove label artist error:',
                    err
                );

                window.showPrefToast(
                    err.message ||
                    'Failed to remove artist.',
                    'error'
                );
            }
        }
    );
};


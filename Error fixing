window.selectPreferencePlatformResult =
    function(index) {

        const results =
            window._preferencePlatformSearchResults ||
            [];

        const platform =
            window._preferencePlatformSearchPlatform ||
            'spotify';

        const selected =
            results[index];

        if (!selected) {
            return;
        }

        const url =
            selected.url || '';

        if (!url) {

            window.showPrefToast(
                'This result does not contain a profile URL.',
                'error'
            );

            return;
        }


        if (platform === 'spotify') {

            const field =
                document.getElementById(
                    'pref-platform-spotify'
                );

            if (field) {
                field.value = url;
            }

        } else if (platform === 'apple') {

            const field =
                document.getElementById(
                    'pref-platform-appleMusic'
                );

            if (field) {
                field.value = url;
            }

        } else if (platform === 'youtube') {

            const field =
                document.getElementById(
                    'pref-platform-youtube'
                );

            if (field) {
                field.value = url;
            }

        } else if (platform === 'audiomack') {

            const field =
                document.getElementById(
                    'pref-audiomack-link'
                );

            if (field) {
                field.value = url;
            }

            const status =
                document.getElementById(
                    'pref-audiomack-status'
                );

            if (status) {
                status.checked = true;
            }
        }


        window.showPrefToast(
            `${platform === 'apple'
                ? 'Apple Music'
                : platform.charAt(0).toUpperCase() + platform.slice(1)
            } profile selected.`,
            'success'
        );


        const resultsBox =
            document.getElementById(
                'pref-platform-search-results'
            );

        if (resultsBox) {
            resultsBox.classList.add('hidden');
        }


        const searchStatus =
            document.getElementById(
                'pref-platform-search-status'
            );

        if (searchStatus) {
            searchStatus.innerText =
                'Profile selected';
        }
    };

window.savePreferences = async function() {

    const btn =
        document.getElementById(
            'btn-save-preferences'
        );

    if (btn) {
        btn.disabled = true;
        btn.innerText = 'Saving...';
    }

    const token =
        window.currentUser?.getIdToken
            ? await window.currentUser.getIdToken()
            : '';

    const baseUrl =
        window.WORKER_BASE_URL || '';

    try {

        const payload =
            window.buildArtistPayload();

        if (
          window.prefState?.artistData?.id
      ) {
          payload.id =
              window.prefState.artistData.id;
      }

        /*
         * Preserve the existing Artist payload.
         * Only make sure the uploaded profile image URL
         * is included in the existing `img` field.
         */
        payload.img =
            typeof toNullableString === 'function'
                ? toNullableString(
                    prefValue('pref-artist-profileImg')
                  )
                : (
                    prefValue('pref-artist-profileImg') ||
                    null
                  );

        const res = await fetch(
            `${baseUrl}/api/preferences/artist/submit`,
            {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            }
        );

        const body =
            await res.json().catch(() => ({}));

        if (!res.ok) {

            throw new Error(
                body.error ||
                body.message ||
                'Failed to save artist preferences.'
            );
        }

        window.prefState.artistData =
            body.data || payload;

        window.prefState.mode = 'view';

        window.updateUIMode();

        window.showPrefToast(
            'Artist preferences saved successfully!',
            'success'
        );

    } catch (err) {

        console.error(
            'Error saving artist preferences:',
            err
        );

        window.showPrefToast(
            err.message ||
            'Error connecting to the server.',
            'error'
        );

    } finally {

        if (btn) {
            btn.disabled = false;
            btn.innerHTML =
                `<i class="fa-solid fa-floppy-disk"></i> Save Preferences`;
        }
    }
};



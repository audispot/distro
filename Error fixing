window.initPreferencesPage = async function() {

    const token =
        window.currentUser?.getIdToken
            ? await window.currentUser.getIdToken()
            : '';

    const baseUrl = window.WORKER_BASE_URL || '';

    try {

        const artistRes = await fetch(
            `${baseUrl}/api/preferences/artist`,
            {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            }
        );

        if (artistRes.ok) {

            const body = await artistRes.json();

            const artist =
                body.data?.artist || {};

            window.prefState.artistData = artist;

            const artistImageUrl =
                artist.profileImg ||
                artist.img ||
                '';

            const artistImageInput =
                document.getElementById(
                    'pref-artist-profileImg'
                );

            const artistImagePreview =
                document.getElementById(
                    'pref-artist-image-preview'
                );

            if (artistImageInput) {
                artistImageInput.value =
                    artistImageUrl;
            }

            if (artistImagePreview) {

                if (artistImageUrl) {

                    artistImagePreview.src =
                        artistImageUrl;

                    artistImagePreview.classList.remove(
                        'hidden'
                    );

                } else {

                    artistImagePreview.removeAttribute(
                        'src'
                    );

                    artistImagePreview.classList.add(
                        'hidden'
                    );
                }
            }

            window.fillArtistPreferences(artist);

            window.prefState.mode =
                artist.artistName
                    ? 'view'
                    : 'edit';

            window.updateUIMode();
        }

        await window.loadLabelPreferences();

    } catch (err) {

        console.error(
            'Failed to load preferences:',
            err
        );

        window.showPrefToast(
            'Failed to load preferences from server.',
            'error'
        );
    }
};


window.renderLabelArtists = function(artists) {

    const container =
        document.getElementById(
            'pref-label-artists'
        );

    const count =
        document.getElementById(
            'pref-label-artist-count'
        );

    if (!container) return;

    if (count) {
        count.innerText =
            `${artists.length} artist${artists.length === 1 ? '' : 's'}`;
    }

    if (!artists.length) {
        container.innerHTML =
            `<p class="text-xs text-gray-500">

        document.getElementById('tab-btn-label');

    const artistSec =
        document.getElementById('pref-section-artist');

    const labelSec =
        document.getElementById('pref-section-label');

    const submittedView =
        document.getElementById('pref-submitted-view');

    const headerActions =
        document.getElementById('pref-header-actions');

    if (tab === 'artist') {

        artistTab.className =
            "px-3 sm:px-4 py-1.5 text-xs font-bold rounded-lg bg-brand-dark text-brand-accent border border-brand-border/80";

        labelTab.className =
            "px-3 sm:px-4 py-1.5 text-xs font-bold rounded-lg text-gray-400 hover:text-white transition-all";

        labelSec.classList.add('hidden');


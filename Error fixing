window.handlePreferenceProfileImage = async function(input, type) {

    const file = input?.files?.[0];

    if (!file) {
        return;
    }

    const isArtist = type === 'artist';

    const folder =
        isArtist
            ? 'artists'
            : 'labels';

    const hiddenId =
        isArtist
            ? 'pref-artist-profileImg'
            : 'pref-label-profileImg';

    const previewId =
        isArtist
            ? 'pref-artist-image-preview'
            : 'pref-label-image-preview';

    const statusId =
        isArtist
            ? 'pref-artist-image-status'
            : 'pref-label-image-status';

    const hidden =
        document.getElementById(hiddenId);

    const preview =
        document.getElementById(previewId);

    const status =
        document.getElementById(statusId);

    if (status) {
        status.innerHTML =
            `<i class="fa-solid fa-spinner fa-spin mr-1"></i> Uploading image...`;
    }

    try {

        const imageUrl =
            await window.uploadPreferenceImage(
                file,
                folder
            );

        if (hidden) {
            hidden.value = imageUrl;
        }


        if (preview) {

            preview.innerHTML = `
                <img
                    src="${imageUrl}"
                    alt="${isArtist ? 'Artist' : 'Label'} profile image"
                    class="w-full h-full object-cover"
                >
            `;

        }


        if (status) {
            status.innerHTML =
                `<i class="fa-solid fa-circle-check text-emerald-400 mr-1"></i> Image uploaded`;
        }


        window.showPrefToast(
            `${isArtist ? 'Artist' : 'Label'} profile image uploaded successfully.`,
            'success'
        );

    } catch (error) {

        console.error(
            'Preference profile image upload failed:',
            error
        );

        if (status) {
            status.innerHTML =
                `<span class="text-red-400">Image upload failed.</span>`;
        }

        window.showPrefToast(
            error?.message ||
            'Profile image upload failed.',
            'error'
        );

        input.value = '';

    }
};

window.renderPreferenceProfileImage = function(
    imageUrl,
    previewId,
    placeholderId
) {

    const preview =
        document.getElementById(
            previewId
        );

    const placeholder =
        document.getElementById(
            placeholderId
        );

    const url =
        String(imageUrl || '').trim();

    if (!preview) {
        return;
    }

    if (url) {

        preview.src = url;

        preview.classList.remove(
            'hidden'
        );

        preview.onerror = function() {

            preview.classList.add(
                'hidden'
            );

            if (placeholder) {
                placeholder.classList.remove(
                    'hidden'
                );
            }
        };

        if (placeholder) {
            placeholder.classList.add(
                'hidden'
            );
        }

    } else {

        preview.removeAttribute(
            'src'
        );

        preview.classList.add(
            'hidden'
        );

        if (placeholder) {
            placeholder.classList.remove(
                'hidden'
            );
        }
    }
};


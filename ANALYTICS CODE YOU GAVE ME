                });


            const [
                overviewResponse,
                tracksResponse
            ] = await Promise.all([

                analyticsApi(
                    `/api/analytics/overview${query}`
                ),

                analyticsApi(
                    `/api/analytics/tracks${buildQuery({
                        period:
                            currentAnalyticsPeriod,

                        page:
                            1,

                        perPage:
                            10
                    })}`
                )

            ]);


            const overview =
                unwrapAnalyticsResponse(
                    overviewResponse
                );


            const tracks =
                Array.isArray(
                    tracksResponse?.data
                )
                    ? tracksResponse.data
                    : [];


            renderOverviewKPIs(
                overview
            );


            renderOverviewChart(
                Array.isArray(
                    overview?.chart
                )
                    ? overview.chart
                    : []
            );


            const dateRange =
                document.getElementById(
                    "overview-date-range"
                );


            if (
                dateRange &&
                overview?.dateRange
            ) {

                dateRange.textContent =
                    `${overview.dateRange.from || ""} → ${overview.dateRange.to || ""}`;

            }


            renderTracksTable(
                tracks,
                "analytics-tracks-tbody"
            );


        } catch (error) {

            showAnalyticsAlert(
                `Failed to load analytics overview: ${error.message}`,
                "error"
            );

        }

    }



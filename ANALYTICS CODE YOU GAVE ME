    async function fetchTracksPage() {

        const tbody =
            document.getElementById(
                "full-tracks-tbody"
            );


        try {

            const response =
                await analyticsApi(
                    `/api/analytics/tracks${buildQuery({

                        period:
                            currentAnalyticsPeriod,

                        page:
                            tracksPage,

                        perPage:
                            ANALYTICS_PER_PAGE

                    })}`
                );


            const rows =
                Array.isArray(
                    response?.data
                )
                    ? response.data
                    : [];


            renderTracksTable(
                rows,
                "full-tracks-tbody"
            );


            renderPagination(
                "tracks-pagination",
                tracksPage,
                numberValue(
                    response?.totalPages
                ) || 1,
                page => {

                    tracksPage =
                        page;

                    fetchTracksPage();

                }
            );


        } catch (error) {

            if (tbody) {

                tbody.innerHTML = `


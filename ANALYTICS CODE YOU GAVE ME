    async function fetchPlatformData(
        platform
    ) {

        if (!platform) {

            return;

        }


        selectedAnalyticsPlatform =
            platform;


        const content =
            document.getElementById(
                "platform-analytics-content"
            );


        if (content) {

            content.innerHTML = `

                <div class="
                    bg-brand-card
                    border
                    border-brand-border
                    rounded-2xl
                    p-8
                    text-center
                    text-xs
                    text-gray-500
                ">
                    Loading ${escapeHtml(
                        platform
                    )} analytics...
                </div>

            `;

        }


        try {

            const query =
                buildQuery({

                    platform:
                        platform,

                    period:
                        currentAnalyticsPeriod,

                    release:
                        selectedAnalyticsRelease ||
                        undefined

                });


            /*
             * THIS is the correct Too Lost selected-platform
             * overview endpoint.
             */

            const overviewResponse =
                await analyticsApi(
                    `/api/analytics/platforms/data${query}`
                );


            const overview =
                unwrapAnalyticsResponse(
                    overviewResponse
                );


            /*
             * Platform total-streams is separately documented.
             *
             * We request it as well, but the UI does not invent
             * undocumented response properties.
             */

            let totalStreamsData =
                null;


            try {

                const response =
                    await analyticsApi(
                        `/api/analytics/platforms/total-streams${query}`
                    );

                totalStreamsData =
                    unwrapAnalyticsResponse(
                        response
                    );

            } catch (error) {

                console.warn(
                    "Platform total-streams endpoint unavailable:",
                    error
                );

            }


            renderPlatformAnalytics(
                platform,
                overview,
                totalStreamsData
            );


        } catch (error) {

            if (content) {

                content.innerHTML = `

                    <div class="
                        bg-brand-card
                        border
                        border-rose-500/20
                        rounded-2xl
                        p-8
                        text-center
                    ">

                        <div class="
                            text-sm
                            font-semibold
                            text-rose-400
                        ">
                            Platform analytics failed
                        </div>

                        <div class="
                            text-xs
                            text-gray-500
                            mt-2
                        ">
                            ${escapeHtml(
                                error.message
                            )}
                        </div>

                    </div>

                `;

            }

        }

    }



    function formatAnalyticsScalar(
        value
    ) {

        if (
            value === null ||
            value === undefined
        ) {

            return "-";

        }


        if (
            typeof value !==
            "object"
        ) {

            return escapeHtml(
                value
            );

        }


        const scalar =
            value.total ??
            value.totalStreams ??
            value.streamsTotal ??
            value.count ??
            value.value;


        if (
            scalar !== undefined
        ) {

            return formatNumber(
                scalar
            );

        }


        return escapeHtml(
            JSON.stringify(
                value
            )
        );

    }


    function renderAdditionalRows(
        data
    ) {

        if (
            Array.isArray(data)
        ) {

            if (
                !data.length
            ) {

                return `

                    <div class="
                        py-8
                        text-center
                        text-xs
                        text-gray-500
                    ">
                        No additional analytics returned.
                    </div>

                `;

            }


            return data
                .map(
                    row => `

                        <div class="
                            flex
                            justify-between
                            gap-3
                            p-3
                            rounded-xl
                            bg-white/[.02]
                            border
                            border-brand-border/50
                        ">

                            <span class="
                                text-xs
                                text-white
                            ">
                                ${escapeHtml(
                                    row?.name ||
                                    row?.label ||
                                    row?.key ||
                                    row?.value ||
                                    "Unknown"
                                )}
                            </span>


                            <span class="
                                text-xs
                                text-indigo-400
                                font-semibold
                            ">
                                ${formatNumber(
                                    row?.total ??
                                    row?.streams ??
                                    row?.count ??
                                    row?.value
                                )}
                            </span>

                        </div>

                    `
                )
                .join("");

        }


        if (
            data &&
            typeof data ===
                "object"
        ) {

            return Object.entries(
                data
            )
                .map(
                    ([key, value]) => `

                        <div class="
                            flex
                            justify-between
                            gap-3
                            p-3
                            rounded-xl
                            bg-white/[.02]
                            border
                            border-brand-border/50
                        ">


    function findAnalyticsArray(
        object,
        keys
    ) {

        if (
            !object ||
            typeof object !==
                "object"
        ) {

            return [];

        }


        for (
            const key of keys
        ) {

            if (
                Array.isArray(
                    object[key]
                )
            ) {

                return object[key];

            }

        }


        return [];

    }


    function renderCountryRows(
        rows

    async function loadAnalyticsPlatforms() {

        const response =
            await analyticsApi(
                "/api/analytics/platforms"
            );


        const data =
            unwrapAnalyticsResponse(
                response
            );


        return {

            platforms:
                Array.isArray(
                    data?.platforms
                )
                    ? data.platforms
                    : [],

            additionalTypes:
                Array.isArray(
                    data?.additionalTypes
                )
                    ? data.additionalTypes
                    : [],

            filters:
                data?.filters ||
                {}

        };


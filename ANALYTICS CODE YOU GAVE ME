    function createLineChart(
        canvasId,
        chartProperty,
        data,
        borderColor
    ) {

        const canvas =
            document.getElementById(
                canvasId
            );


        if (
            !canvas ||
            typeof Chart ===
                "undefined"
        ) {

            return;

        }


        if (
            window[
                chartProperty
            ]
        ) {

            window[
                chartProperty
            ].destroy();

        }


        window[
            chartProperty
        ] =
            new Chart(
                canvas.getContext(
                    "2d"
                ),
                {

                    type:
                        "line",

                    data: {

                        labels:
                            data.map(
                                point =>
                                    point.date
                            ),

                        datasets: [

                            {

                                label:
                                    "Streams",

                                data:
                                    data.map(

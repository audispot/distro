                            </span>


                            <span class="
                                text-xs
                                text-indigo-400
                            ">

                                ${
                                    typeof value ===
                                    "object"
                                        ? escapeHtml(
                                            JSON.stringify(
                                                value
                                            )
                                        )
                                        : formatNumber(
                                            value
                                        )
                                }

                            </span>

                        </div>

                    `
                )
                .join("");

        }


        return `

            <div class="
                p-4
                text-xs
                text-gray-400
            ">
                No additional analytics returned.
            </div>

        `;

    }



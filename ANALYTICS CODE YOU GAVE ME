    // RELEASE FILTER
    // =========================================================

    function analyticsSetRelease(
        releaseId
    ) {

        selectedAnalyticsRelease =
            releaseId ||
            "";

        tracksPage = 1;
        usageSongsPage = 1;
        usageMatchesPage = 1;
        releaseLinksPage = 1;


        renderAnalyticsTab();

    }


    // =========================================================
    // PAGINATION
    // =========================================================

    const analyticsPaginationCallbacks =
        {};


    function renderPagination(
        containerId,
        currentPage,
        totalPages,
        callback
    ) {

        const container =
            document.getElementById(
                containerId
            );


        if (!container) {

            return;

        }


        totalPages =
            Math.max(
                1,
                numberValue(
                    totalPages
                )
            );


        if (
            totalPages <= 1
        ) {

            container.innerHTML =
                "";

            return;

        }


        analyticsPaginationCallbacks[
            containerId
        ] =
            callback;


        const buttons = [];


        buttons.push(`

            <button
                ${
                    currentPage <= 1
                        ? "disabled"
                        : ""
                }
                onclick="
                    window.analyticsPagination(
                        '${containerId}',
                        ${currentPage - 1}
                    )
                "
                class="
                    px-3
                    py-2
                    rounded-lg
                    text-[10px]
                    border
                    border-brand-border
                    ${
                        currentPage <= 1
                            ? "opacity-40"
                            : "hover:bg-white/5"
                    }
                "
            >
                Previous
            </button>

        `);


        const start =
            Math.max(
                1,
                currentPage - 2
            );


        const end =
            Math.min(
                totalPages,
                currentPage + 2
            );


        for (
            let page = start;
            page <= end;
            page++
        ) {

            buttons.push(`

                <button
                    onclick="
                        window.analyticsPagination(
                            '${containerId}',
                            ${page}
                        )
                    "
                    class="
                        px-3
                        py-2
                        rounded-lg
                        text-[10px]
                        border
                        border-brand-border
                        ${
                            page === currentPage
                                ? "bg-brand-primary text-white"
                                : "text-gray-400 hover:text-white"
                        }
                    "
                >
                    ${page}
                </button>

            `);

        }


        buttons.push(`

            <button
                ${
                    currentPage >= totalPages
                        ? "disabled"
                        : ""
                }
                onclick="
                    window.analyticsPagination(
                        '${containerId}',
                        ${currentPage + 1}
                    )
                "
                class="
                    px-3
                    py-2
                    rounded-lg
                    text-[10px]
                    border
                    border-brand-border
                    ${
                        currentPage >= totalPages
                            ? "opacity-40"
                            : "hover:bg-white/5"
                    }
                "
            >
                Next
            </button>

        `);


        container.innerHTML = `

            <div class="
                flex
                justify-center
                gap-2
                flex-wrap
            ">

                ${buttons.join("")}

            </div>

        `;

    }


    function analyticsPagination(
        containerId,
        page
    ) {

        const callback =
            analyticsPaginationCallbacks[
                containerId
            ];


        if (
            typeof callback ===
            "function"
        ) {

            callback(
                page
            );

        }

    }


    // =========================================================
    // ALERT
    // =========================================================

    function showAnalyticsAlert(
        message,
        type = "info"
    ) {

        const area =
            document.getElementById(
                "analytics-alert-area"
            );


        if (!area) {

            console.error(
                message
            );

            return;

        }


        area.classList.remove(
            "hidden"
        );


        area.innerHTML = `

            <div class="
                p-3
                rounded-xl
                text-xs
                ${
                    type === "error"
                        ? "bg-rose-500/10 text-rose-400 border border-rose-500/20"
                        : "bg-indigo-500/10 text-indigo-300 border border-indigo-500/20"
                }
            ">

                ${escapeHtml(
                    message
                )}

            </div>

        `;


        clearTimeout(
            window.analyticsAlertTimer
        );


        window.analyticsAlertTimer =
            setTimeout(
                () => {

                    area.classList.add(
                        "hidden"
                    );

                },
                6000
            );

    }



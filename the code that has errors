        },
        accessToken,
        env
      );

    const upstreamText =
      await upstream.text();

    let upstreamBody =
      {};

    try {
      upstreamBody =
        upstreamText
          ? JSON.parse(
              upstreamText
            )
          : {};
    } catch {
      upstreamBody = {
        raw:
          upstreamText
      };

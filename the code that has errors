            upstream.status,

          tooLostResponse:
            upstreamBody
        },
        upstream.status,
        corsHeaders
      );
    }

    // ---------------------------------------------------------
    // Update USER-SPECIFIC KV.
    // ---------------------------------------------------------

    if (
      env.AUDIORY_KV
    ) {
      const labelKey =
        `PREFERENCES_LABEL_${userId}`;


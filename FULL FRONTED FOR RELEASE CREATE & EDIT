function renderStep2Content() {

    const s = window.releaseState;

    // =========================================================
    // SAFETY MIGRATION / DEFAULT STATE
    // =========================================================

    s.dates = s.dates || {};

    s.dates.releaseDate =
        s.dates.releaseDate || '';

    s.dates.originalReleaseDate =
        s.dates.originalReleaseDate || '';

    s.dates.releaseTime =
        s.dates.releaseTime || '';

    s.dates.timezone =
        s.dates.timezone || 'Africa/Nairobi';


    s.applePreorder =
        s.applePreorder || {
            enabled: false,
            date: ''
        };


    s.applePreorder.enabled =
        Boolean(s.applePreorder.enabled);

    s.applePreorder.date =
        s.applePreorder.date || '';


    s.license =
        s.license || {
            type: 'Copyright',
            info: ''
        };

    s.license.type =
        s.license.type || 'Copyright';

    s.license.info =
        s.license.info || '';


    s.delivery =
        s.delivery || {};


    // =========================================================
    // PLATFORM STATE
    // =========================================================

    if (!Array.isArray(s.dsps)) {
        s.dsps = [];
    }


    // =========================================================
    // TERRITORY STATE
    // =========================================================

    if (!Array.isArray(s.delivery.territories)) {
        s.delivery.territories = [];
    }

    // Remove the old unsupported Worldwide value from
    // any previously saved state.
    s.delivery.territories =
        s.delivery.territories.filter(
            territory =>
                territory &&
                territory !== 'Worldwide' &&
                TOO_LOST_TERRITORY_CODES.includes(territory)
        );


    // Too Lost allows exactly 2.
    // If old state somehow contains more than 2, keep
    // only the first two valid values.
    if (s.delivery.territories.length > 2) {
        s.delivery.territories =
            s.delivery.territories.slice(0, 2);
    }


    // =========================================================
    // BEATPORT
    // =========================================================

    if (typeof s.delivery.beatPort !== 'boolean') {
        s.delivery.beatPort = false;
    }

    if (typeof s.delivery.beatPortHasAccount !== 'boolean') {
        s.delivery.beatPortHasAccount = false;
    }

    s.delivery.beatPortLink =
        s.delivery.beatPortLink || '';


window.renderTerritoryOptions = function(
    searchTerm = ''
) {

    const query =
        String(searchTerm || '')
            .trim()
            .toLowerCase();


    const selected =
        Array.isArray(
            window.releaseState.delivery?.territories
        )
            ? window.releaseState.delivery.territories
            : [];


    const filtered =
        TOO_LOST_TERRITORIES.filter(
            territory =>
                !query ||
                territory.code.toLowerCase().includes(query) ||
                territory.name.toLowerCase().includes(query)
        );


    if (!filtered.length) {

        return `
            <div class="col-span-full text-center py-10 text-gray-500 text-sm">
                No territories found.
            </div>
        `;

    }


    return filtered.map(territory => {

        const isChecked =
            selected.includes(
                territory.code
            );


        const maxReached =
            selected.length >= 2 &&
            !isChecked;


        return `

            <label
                class="p-3 rounded-xl bg-brand-card border border-brand-border flex items-center justify-between gap-3 ${
                    maxReached
                        ? 'opacity-40 cursor-not-allowed'

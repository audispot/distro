window.closeDspModal = function() {

    const modal =
        document.getElementById('dspModal');

    if (modal) {
        modal.remove();
    }


    const container =
        document.getElementById(
            'wizardStepContainer'
        );

    if (
        container &&
        window.currentStep === 2
    ) {

        container.innerHTML =
            renderStep2Content();

    }

};


// =========================================================
// TOGGLE SINGLE DSP
// =========================================================

window.toggleSingleDsp = function(
    id,
    isChecked
) {

    if (!Array.isArray(window.releaseState.dsps)) {
        window.releaseState.dsps = [];
    }


    if (isChecked) {

        if (
            window.releaseState.dsps.length >= 120
        ) {

            alert(
                'Too Lost allows a maximum of 120 platforms per release.'
            );

            return;
        }


        if (
            !window.releaseState.dsps.includes(id)
        ) {

            window.releaseState.dsps.push(id);

        }

    } else {

        window.releaseState.dsps =
            window.releaseState.dsps.filter(
                dspId => dspId !== id
            );

    }


    // Refresh only the modal list.
    const searchInput =
        document.getElementById(
            'dspSearchInput'
        );

    const searchTerm =
        searchInput?.value || '';


    const list =
        document.getElementById(
            'dspPlatformList'
        );

    if (list) {

        list.innerHTML =
            renderDspOptions(searchTerm);

    }


    const count =
        document.getElementById(
            'dspSelectedCount'
        );

    if (count) {

        count.textContent =
            `${window.releaseState.dsps.length} selected`;

    }

};


// =========================================================
// SELECT / DESELECT PLATFORMS
// =========================================================

window.toggleAllDsps = function(selectAll) {

    if (!Array.isArray(window.releaseState.dsps)) {
        window.releaseState.dsps = [];
    }


    if (selectAll) {

        if (!Array.isArray(MASTER_DSP_LIST) ||
            !MASTER_DSP_LIST.length) {

            alert(
                'Distribution platforms have not loaded yet.'
            );

            return;
        }


        window.releaseState.dsps =
            MASTER_DSP_LIST
                .slice(0, 120)
                .map(dsp => dsp.id);

    } else {

        window.releaseState.dsps = [];

    }


    // Refresh modal list.

    const searchInput =
        document.getElementById(
            'dspSearchInput'
        );

    const searchTerm =
        searchInput?.value || '';


    const list =
        document.getElementById(
            'dspPlatformList'
        );

    if (list) {

        list.innerHTML =
            renderDspOptions(searchTerm);

    }


    // Update selected count.

    const count =
        document.getElementById(
            'dspSelectedCount'
        );

    if (count) {

        count.textContent =
            `${window.releaseState.dsps.length} selected`;

    }

};


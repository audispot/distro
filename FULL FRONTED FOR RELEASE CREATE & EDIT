window.filterTerritories = function(
    searchTerm
) {

    const list =
        document.getElementById(
            'territoryList'
        );

    if (!list) {
        return;
    }


    list.innerHTML =
        renderTerritoryOptions(
            searchTerm
        );

};


// =========================================================
// TOGGLE TERRITORY
// =========================================================

window.toggleTerritory = function(
    code,
    isChecked
) {

    window.releaseState.delivery =
        window.releaseState.delivery || {};


    if (
        !Array.isArray(
            window.releaseState.delivery.territories
        )
    ) {

        window.releaseState.delivery.territories =
            [];

    }


    if (isChecked) {

        if (
            window.releaseState.delivery.territories.length >= 2
        ) {

            alert(
                'Too Lost allows exactly 2 distribution territories.'
            );

            return;

        }


        if (
            !window.releaseState.delivery.territories.includes(code)
        ) {

            window.releaseState.delivery.territories.push(code);

        }

    } else {

        window.releaseState.delivery.territories =
            window.releaseState.delivery.territories.filter(
                territory => territory !== code
            );

    }


    const searchInput =
        document.getElementById(
            'territorySearchInput'
        );

    const searchTerm =
        searchInput?.value || '';


    const list =
        document.getElementById(
            'territoryList'
        );

    if (list) {

        list.innerHTML =
            renderTerritoryOptions(
                searchTerm
            );

    }


    // Update the counter without rerendering
    // the whole Step 2 screen.
    const counter =
        document.querySelector(
            '[data-territory-counter]'
        );

    if (counter) {

        counter.textContent =
            `${window.releaseState.delivery.territories.length} / 2`;

    }

};



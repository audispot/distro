window.handleCoverArtSelection = async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    window.releaseState.artwork.file = file;
    const previewContainer = document.getElementById('artworkPreviewContainer');
    const previewImg = document.getElementById('artworkPreviewImg');
    const specsBox = document.getElementById('artworkSpecsBox');

    const previewUrl = URL.createObjectURL(file);
    window.releaseState.artwork.url = previewUrl;
    if (previewImg) previewImg.src = previewUrl;

    const inspected = await inspectImageFile(file);
    window.releaseState.artwork.inspected = inspected;

    if (specsBox) {
        specsBox.innerHTML = `
            <p>File Name: ${inspected.filename}</p>
            <p>Dimensions: ${inspected.width}x${inspected.height} px</p>
            <p>Format: ${inspected.mime}</p>
            <p class="${inspected.valid ? 'text-emerald-400' : 'text-red-400'} font-bold">
                ${inspected.valid ? '✓ Artwork Meets Requirements' : '✗ Invalid Dimensions or Format'}
            </p>
        `;
    }
    if (previewContainer) previewContainer.classList.remove('hidden');
};

async function inspectImageFile(file) {
    return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onloadend = (e) => {
            const arr = (new Uint8Array(e.target.result)).subarray(0, 4);
            let header = "";
            for (let i = 0; i < arr.length; i++) header += arr[i].toString(16);
            
            let mime = "unknown";
            if (header.startsWith("89504e47")) mime = "image/png";
            else if (header.startsWith("ffd8ff")) mime = "image/jpeg";

            const img = new Image();
            img.src = URL.createObjectURL(file);
            img.onload = () => {
                resolve({
                    filename: file.name,
                    mime: mime,
                    width: img.width,
                    height: img.height,
                    fileSize: `${(file.size / (1024 * 1024)).toFixed(2)} MB`,
                    valid: (mime !== "unknown" && img.width >= 3000 && img.height >= 3000)
                });
            };
        };
        reader.readAsArrayBuffer(file.slice(0, 4));
    });
}


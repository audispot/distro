// Save IRS Tax Compliance Details
async function handleSaveTaxDetails(e) {
    e.preventDefault();

    const formType = document.getElementById('tax-form-type')?.value || 'w9';
    const legalName = document.getElementById('tax-legal-name')?.value || '';
    const dbaName = document.getElementById('tax-dba-name')?.value || '';
    const street = document.getElementById('tax-address-street')?.value || '';
    const city = document.getElementById('tax-address-city')?.value || '';
    const state = document.getElementById('tax-address-state')?.value || '';
    const zip = document.getElementById('tax-address-zip')?.value || '';
    const signature = document.getElementById('tax-signature')?.value || '';

    let payload = {
        formType,
        legalName,
        dbaName,
        address: { street, city, state, zip },
        signature,
        certifiedAt: new Date().toISOString()
    };

    if (formType === 'w9') {
        payload.w9Details = {
            classification: document.getElementById('tax-w9-classification')?.value || 'individual',
            tin: document.getElementById('tax-w9-tin')?.value || ''
        };
    } else {
        payload.w8Details = {
            citizenship: document.getElementById('tax-w8-citizenship')?.value || '',
            foreignTin: document.getElementById('tax-w8-ftin')?.value || '',
            usTin: document.getElementById('tax-w8-us-tin')?.value || '',
            dob: document.getElementById('tax-w8-dob')?.value || '',
            treatyClaimed: document.getElementById('tax-w8-treaty-claim')?.checked || false,
            treatyCountry: document.getElementById('tax-treaty-country')?.value || '',
            claimedRate: document.getElementById('tax-treaty-rate')?.value || '0'
        };

        if (formType === 'w8bene') {
            payload.w8Details.fatcaStatus = document.getElementById('tax-w8bene-fatca')?.value || 'active_nffe';
        }
    }

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/tax-details`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        if (!response.ok) throw new Error("Failed to submit tax form.");
        showToast("Tax compliance form successfully verified and saved!");
    } catch (err) {
        showToast(err.message, true);
    }
}


async function submitUserInvite(e) {
    e.preventDefault();
    const emailInput = document.getElementById('invite-user-email');
    if (!emailInput) return;
    const email = emailInput.value;
    
    const selectedRoles = [];
    if (document.getElementById('role-content')?.checked) selectedRoles.push('Content');
    if (document.getElementById('role-royalties')?.checked) selectedRoles.push('Royalties');
    if (document.getElementById('role-analytics')?.checked) selectedRoles.push('Analytics');
    if (document.getElementById('role-splitshare')?.checked) selectedRoles.push('SplitShare');
    if (document.getElementById('role-admin')?.checked) selectedRoles.push('Admin');

    if (selectedRoles.length === 0) {
        showToast("Please select at least one role.", true);
        return;
    }

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/members/invite`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ email, roles: selectedRoles })
        });

        if (!response.ok) throw new Error('Failed to send invitation');

        closeInviteUserModal();
        await loadAccountMembers();
        showToast(`Invite sent to ${email}!`);
    } catch (err) {
        showToast(err.message, true);
    }
}


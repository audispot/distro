                </td>
                <td class="py-3 px-2 text-right">
                    <button type="button" onclick="removeMember('${m.id}')" class="text-gray-500 hover:text-red-400 transition"><i class="fa-solid fa-trash text-xs"></i></button>
                </td>
            </tr>
        `).join('');
    } catch {
        tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-gray-500">No team members added yet.</td></tr>`;
    }
}

async function removeMember(memberId) {
    const confirmed = await showCustomConfirm("Revoke Access", "Are you sure you want to revoke access for this team member?");
    if (!confirmed) return;

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/members/${memberId}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
        });

        if (!response.ok) throw new Error("Failed to remove team member.");

        await loadAccountMembers();
        showToast("Member access revoked.");
    } catch (err) {
        showToast(err.message, true);
    }
}


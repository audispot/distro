// --- ACTION HANDLERS FOR MODALS ---

async function handlePasswordChange(event) {
  event.preventDefault();
  clearModalAlert();

  const currentPassword = document.getElementById('currentPassword').value;
  const newPassword = document.getElementById('newPassword').value;
  const confirmPassword = document.getElementById('confirmPassword').value;

  if (newPassword !== confirmPassword) {
    showModalAlert('New passwords do not match.', true);
    return;
  }

  try {
    let token = "";

    // Re-authenticate via Firebase SDK directly if present
    if (typeof firebase !== 'undefined' && firebase.auth().currentUser) {
      const user = firebase.auth().currentUser;
      const cred = firebase.auth.EmailAuthProvider.credential(user.email, currentPassword);
      await user.reauthenticateWithCredential(cred);
      await user.updatePassword(newPassword);
    } else {
      // Fallback: Call Cloudflare Worker endpoint
      if (typeof auth !== 'undefined' && auth.currentUser) {
        token = await auth.currentUser.getIdToken();
      }

      if (!token) {
        throw new Error('User session expired. Please sign in again.');
      }

      const res = await fetch(`${WORKER_BASE_URL}/api/auth/change-password`, {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ currentPassword, newPassword })
      });

      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Password change failed.');
    }

    showToast('Password updated successfully! Please sign in with your new password.');
    closeSettingsModal();
  } catch (err) {
    showModalAlert(err.message || 'Error updating password.', true);
  }
}
        
async function load2FAStatus() {
  const badge = document.getElementById('2faStatusBadge');
  const setupArea = document.getElementById('2faSetupArea');
  if (!badge) return;

  try {
    const token = await getAuthToken();
    const response = await fetch(`${getWorkerBaseUrl()}/api/auth/2fa/status`, {
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const data = response.ok ? await response.json() : { is_2fa_enabled: false };

    if (data.is_2fa_enabled) {
      badge.textContent = 'Enabled';
      badge.className = 'text-[10px] bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded font-medium';
      if (setupArea) {
        setupArea.innerHTML = `
          <div class="space-y-3">
            <div class="w-12 h-12 mx-auto rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
              <i class="fa-solid fa-shield-check text-emerald-400 text-xl"></i>
            </div>
            <p class="text-xs text-emerald-300 font-semibold">Authenticator 2FA is enabled.</p>
            <p class="text-[10px] text-gray-400">Your account requires an authenticator code during protected login.</p>
            <button onclick="disable2FA()" class="w-full py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 font-medium text-xs rounded-lg transition">Disable 2FA</button>
          </div>`;
      }
      return true;
    }

    badge.textContent = 'Disabled';
    badge.className = 'text-[10px] bg-yellow-500/20 text-yellow-400 px-2 py-0.5 rounded font-medium';
    await begin2FASetup();
    return false;
  } catch (err) {
    if (badge) badge.textContent = 'Unavailable';
    if (setupArea) setupArea.innerHTML = `<p class="text-xs text-red-400">Unable to load 2FA status. Please refresh and try again.</p>`;
    return false;
  }
}

async function begin2FASetup() {
  const loading = document.getElementById('2faSetupLoading');
  const content = document.getElementById('2faSetupContent');
  if (!loading || !content) return;

  try {
    const token = await getAuthToken();
    if (!token) throw new Error('Authentication required.');

    const response = await fetch(`${getWorkerBaseUrl()}/api/auth/2fa/setup`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || !data.qrCodeUrl) throw new Error(data.error || 'Unable to start 2FA setup.');

    const qr = document.getElementById('twoFaQrCode');
    const secret = document.getElementById('twoFaManualSecret');
    if (qr) qr.src = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(data.qrCodeUrl)}`;
    if (secret) secret.textContent = `Manual setup key: ${data.secret || ''}`;

    loading.classList.add('hidden');
    content.classList.remove('hidden');
    window.pending2FARecoveryCodes = data.recoveryCodes || [];
  } catch (err) {
    loading.textContent = err.message || 'Unable to prepare 2FA setup.';
    loading.className = 'text-xs text-red-400';
  }
}

async function verify2FASetup() {
  clearModalAlert();
  const input = document.getElementById('totpCode');
  const code = String(input?.value || '').replace(/\D/g, '');
  if (!/^\d{6}$/.test(code)) {
    showModalAlert('Enter the current 6-digit code from your authenticator app.', true);
    return;
  }

  try {
    const token = await getAuthToken();
    const response = await fetch(`${getWorkerBaseUrl()}/api/auth/2fa/verify`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ code })
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || !data.success) throw new Error(data.error || '2FA verification failed.');

    const codes = data.recovery_codes || window.pending2FARecoveryCodes || [];
    const list = document.getElementById('twoFaRecoveryCodeList');
    const box = document.getElementById('twoFaRecoveryCodes');
    if (list && codes.length) {
      list.innerHTML = codes.map(code => `<span>${escapeHtml(code)}</span>`).join('');
      box?.classList.remove('hidden');
    }

    showToast('Two-Factor Authentication successfully enabled!');
    await load2FAStatus();
  } catch (err) {
    showModalAlert(err.message || 'Unable to enable 2FA.', true);
  }
}

async function disable2FA() {
  const confirmed = await showCustomConfirm('Disable 2FA', 'Disable authenticator protection for this account?');
  if (!confirmed) return;
  try {
    const token = await getAuthToken();
    const response = await fetch(`${getWorkerBaseUrl()}/api/auth/2fa/disable`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${token}` }
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok || !data.success) throw new Error(data.error || 'Unable to disable 2FA.');
    showToast('Two-Factor Authentication disabled.');
    await load2FAStatus();
  } catch (err) {
    showToast(err.message || 'Unable to disable 2FA.', true);
  }
}

function submitAppleClaim() {
  clearModalAlert();
  const url = document.getElementById('appleArtistUrl')?.value?.trim() || '';
  if (!/^https:\/\/music\.apple\.com\//i.test(url)) {
    showModalAlert('Please enter a valid Apple Music artist profile URL.', true);
    return;
  }
  // The Worker owns the OAuth/claim flow. Keep the URL available for the callback flow.
  sessionStorage.setItem('audioryAppleArtistUrl', url);
  startOAuthFlow('Apple Music');
}

function startOAuthFlow(platform) {
  const routes = {
    'SoundCloud': '/api/integrations/soundcloud/connect',
    'Audiomack': '/api/integrations/audiomack/connect',
    'Apple Music': '/api/integrations/apple-music/connect'
  };
  const route = routes[platform];
  if (!route) {
    showToast(`Unsupported integration: ${platform}`, true);
    return;
  }

  const base = getWorkerBaseUrl();
  if (!base) {
    showToast('Worker base URL is not configured.', true);
    return;
  }

  showToast(`Connecting ${platform}...`);
  closeSettingsModal();

  // The integration endpoint must support authenticated browser navigation.
  // Preferred implementation: Worker accepts a short-lived signed/query state generated
  // by an authenticated POST before redirecting to the provider.
  const tokenPromise = getAuthToken();
  tokenPromise.then(token => {
    const separator = route.includes('?') ? '&' : '?';
    window.location.href = `${base}${route}${separator}token=${encodeURIComponent(token)}`;
  }).catch(() => showToast(`Unable to start ${platform} authorization.`, true));
}




// --- ACTION HANDLERS FOR MODALS ---

async function handlePasswordChange(event) {
  event.preventDefault();
  clearModalAlert();

  const currentPassword = document.getElementById('currentPassword').value;
  const newPassword = document.getElementById('newPassword').value;
  const confirmPassword = document.getElementById('confirmPassword').value;

  if (newPassword !== confirmPassword) {
    showModalAlert('New passwords do not match.', true);
    return;
  }

  try {
    if (typeof firebase !== 'undefined' && firebase.auth().currentUser) {
      const user = firebase.auth().currentUser;
      const cred = firebase.auth.EmailAuthProvider.credential(user.email, currentPassword);
      await user.reauthenticateWithCredential(cred);
      await user.updatePassword(newPassword);
    } else {
      const res = await fetch('/api/profile/password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword })
      });
      if (!res.ok) throw new Error('Password change failed.');
    }
    showToast('Password updated successfully!');
    closeSettingsModal();
  } catch (err) {
    showModalAlert(err.message || 'Error updating password.', true);
  }
}

function verify2FASetup() {
  clearModalAlert();
  const code = document.getElementById('totpCode').value;
  if (code.length === 6) {
    showToast('Two-Factor Authentication successfully enabled!');
    closeSettingsModal();
  } else {
    showModalAlert('Please enter a valid 6-digit verification code.', true);
  }
}

function submitSpotifyClaim() {
  clearModalAlert();
  const url = document.getElementById('spotifyArtistUrl').value;
  if (!url || !url.includes('spotify.com')) {
    showModalAlert('Please enter a valid Spotify artist profile URL.', true);
    return;
  }
  showToast('Verification request submitted! Updates will be emailed to you.');
  closeSettingsModal();
}

function startOAuthFlow(platform) {
  showToast(`Redirecting to ${platform} authorization portal...`);
  closeSettingsModal();
}

function saveDiscoveryPreferences() {
  const isChecked = document.getElementById('discoveryAutoOptIn').checked;
  showToast(`Spotify Discovery preferences saved (${isChecked ? 'Opt-in Enabled' : 'Opt-in Disabled'})`);
  closeSettingsModal();
}



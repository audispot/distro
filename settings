// Save IRS Tax Compliance Details
async function handleSaveTaxDetails(e) {
    e.preventDefault();
    const formType = document.getElementById('tax-form-type')?.value || 'w9';
    const legalName = document.getElementById('tax-legal-name')?.value.trim() || '';
    const street = document.getElementById('tax-address-street')?.value.trim() || '';
    const city = document.getElementById('tax-address-city')?.value.trim() || '';
    const state = document.getElementById('tax-address-state')?.value.trim() || '';
    const zip = document.getElementById('tax-address-zip')?.value.trim() || '';
    const signature = document.getElementById('tax-signature')?.value.trim() || '';

    if (!legalName || !street || !city || !zip || !signature || !document.getElementById('tax-certify-check')?.checked) {
      showToast('Complete all required tax fields and certification before submitting.', true);
      return;
    }

    let country = '';
    let tin = '';
    let classification = 'individual';
    if (formType === 'w9') {
      tin = document.getElementById('tax-w9-tin')?.value.trim() || '';
      classification = document.getElementById('tax-w9-classification')?.value || 'individual';
      country = 'United States';
    } else {
      country = document.getElementById('tax-w8-citizenship')?.value.trim() || '';
      tin = document.getElementById('tax-w8-ftin')?.value.trim() || '';
      classification = formType === 'w8bene' ? (document.getElementById('tax-w8bene-fatca')?.value || 'foreign_entity') : 'foreign_individual';
    }

    if (!country || !tin) {
      showToast('Country and foreign tax identification number are required for this form.', true);
      return;
    }

    const payload = {
      formType,
      legalName,
      classification,
      country,
      tin,
      address: { street, city, state, zip },
      dbaName: document.getElementById('tax-dba-name')?.value.trim() || '',
      signature,
      certifiedAt: new Date().toISOString(),
      w9Details: formType === 'w9' ? { classification, tin } : null,
      w8Details: formType !== 'w9' ? {
        citizenship: country,
        foreignTin: tin,
        usTin: document.getElementById('tax-w8-us-tin')?.value.trim() || '',
        dob: document.getElementById('tax-w8-dob')?.value || '',
        treatyClaimed: document.getElementById('tax-w8-treaty-claim')?.checked || false,
        treatyCountry: document.getElementById('tax-treaty-country')?.value.trim() || '',
        claimedRate: document.getElementById('tax-treaty-rate')?.value || '0',
        fatcaStatus: formType === 'w8bene' ? (document.getElementById('tax-w8bene-fatca')?.value || '') : ''
      } : null
    };

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/tax-details`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Failed to submit tax form.');
        showToast('Tax compliance form successfully saved.');
        await loadTaxDetails();
    } catch (err) {
        showToast(err.message || 'Failed to save tax details.', true);
    }
}

// Load Tax Details
async function loadTaxDetails() {
    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/tax-details`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!response.ok) return;

        const data = await response.json();
        if (data && data.formType) {
            selectTaxForm(data.formType);
            if (document.getElementById('tax-legal-name')) document.getElementById('tax-legal-name').value = data.legalName || '';
            if (document.getElementById('tax-dba-name')) document.getElementById('tax-dba-name').value = data.dbaName || '';
            if (data.address) {
                if (document.getElementById('tax-address-street')) document.getElementById('tax-address-street').value = data.address.street || '';
                if (document.getElementById('tax-address-city')) document.getElementById('tax-address-city').value = data.address.city || '';
                if (document.getElementById('tax-address-state')) document.getElementById('tax-address-state').value = data.address.state || '';
                if (document.getElementById('tax-address-zip')) document.getElementById('tax-address-zip').value = data.address.zip || '';
            }
            if (data.w9Details && document.getElementById('tax-w9-tin')) {
                document.getElementById('tax-w9-tin').value = data.w9Details.tin || '';
                document.getElementById('tax-w9-classification').value = data.w9Details.classification || 'individual';
            }
            if (data.w8Details) {
                if (document.getElementById('tax-w8-citizenship')) document.getElementById('tax-w8-citizenship').value = data.w8Details.citizenship || '';
                if (document.getElementById('tax-w8-ftin')) document.getElementById('tax-w8-ftin').value = data.w8Details.foreignTin || '';
                if (document.getElementById('tax-w8-us-tin')) document.getElementById('tax-w8-us-tin').value = data.w8Details.usTin || '';
                if (document.getElementById('tax-w8-dob')) document.getElementById('tax-w8-dob').value = data.w8Details.dob || '';
                if (document.getElementById('tax-treaty-country')) document.getElementById('tax-treaty-country').value = data.w8Details.treatyCountry || '';
                if (document.getElementById('tax-treaty-rate')) document.getElementById('tax-treaty-rate').value = data.w8Details.claimedRate || '0';
            }
        }
    } catch {
        // Fallback default UI state
    }
}

// Login History Controller
async function loadLoginHistory() {
    const tbody = document.getElementById('settings-sessions-tbody');
    if (!tbody) return;

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/login-history`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        const sessions = response.ok ? await response.json() : [];

        if (!Array.isArray(sessions) || sessions.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-gray-500">No recorded login sessions yet.</td></tr>`;
            return;
        }

        tbody.innerHTML = sessions.map(s => `
            <tr class="border-b border-brand-border/30 hover:bg-white/5 transition">
                <td class="py-3 px-2 font-medium text-white flex items-center gap-2">
                    <i class="fa-solid ${String(s.device || '').toLowerCase().includes('mobile') ? 'fa-mobile-screen' : 'fa-desktop'} text-gray-400"></i> ${escapeHtml(s.device || 'Unknown device')}
                </td>
                <td class="py-3 px-2 font-mono text-gray-400">${escapeHtml(s.ip || '—')}</td>
                <td class="py-3 px-2 text-gray-400">${escapeHtml(s.location || '—')}</td>
                <td class="py-3 px-2 text-gray-400">${formatDateTime(s.lastActiveAt || s.lastActive || s.loginAt)}</td>
                <td class="py-3 px-2 text-right">
                    ${s.isCurrent ? `<span class="px-2 py-0.5 text-[10px] rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono">Current Session</span>` : `<button onclick="revokeSession('${escapeHtml(s.id)}')" class="text-gray-500 hover:text-red-400 text-xs transition"><i class="fa-solid fa-right-from-bracket"></i> Revoke</button>`}
                </td>
            </tr>
        `).join('');
    } catch {
        tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-gray-500">Unable to load login history.</td></tr>`;
    }
}

async function revokeAllSessions() {
    const confirm = await showCustomConfirm("Terminate Other Sessions", "Are you sure you want to log out all other active devices?");
    if (!confirm) return;

    try {
        const token = await getAuthToken();
        await fetch(`${getWorkerBaseUrl()}/api/login-history/revoke-all`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` }
        });
        await loadLoginHistory();
        showToast("All other active sessions have been terminated.");
    } catch (err) {
        showToast(err.message, true);
    }
}

async function revokeSession(sessionId) {
    try {
        const token = await getAuthToken();
        await fetch(`${getWorkerBaseUrl()}/api/login-history/${sessionId}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
        });
        await loadLoginHistory();
        showToast("Session revoked successfully.");
    } catch (err) {
        showToast(err.message, true);
    }
}

// User Invites and Team Management
function openInviteUserModal() {
    const modal = document.getElementById('inviteUserModal');
    if (modal) modal.classList.remove('hidden');
}

function closeInviteUserModal() {
    const modal = document.getElementById('inviteUserModal');
    if (modal) modal.classList.add('hidden');
}

async function submitUserInvite(e) {
    e.preventDefault();
    const emailInput = document.getElementById('invite-user-email');
    if (!emailInput) return;
    const email = emailInput.value;
    
    const selectedRoles = [];
    if (document.getElementById('role-content')?.checked) selectedRoles.push('Content');
    if (document.getElementById('role-royalties')?.checked) selectedRoles.push('Royalties');
    if (document.getElementById('role-analytics')?.checked) selectedRoles.push('Analytics');
    if (document.getElementById('role-splitshare')?.checked) selectedRoles.push('SplitShare');
    if (document.getElementById('role-admin')?.checked) selectedRoles.push('Admin');

    if (selectedRoles.length === 0) {
        showToast("Please select at least one role.", true);
        return;
    }

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/members/invite`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ email, roles: selectedRoles })
        });

        if (!response.ok) throw new Error('Failed to send invitation');

        closeInviteUserModal();
        await loadAccountMembers();
        showToast(`Invite sent to ${email}!`);
    } catch (err) {
        showToast(err.message, true);
    }
}

async function loadAccountMembers() {
    const tbody = document.getElementById('settings-members-tbody');
    if (!tbody) return;

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/members`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });

        const members = response.ok ? await response.json() : [];

        if (!members || members.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-gray-500">No team members added yet.</td></tr>`;
            return;
        }

        tbody.innerHTML = members.map(m => `
            <tr class="border-b border-brand-border/50 hover:bg-white/5 transition">
                <td class="py-3 px-2 font-semibold text-white">${m.email}</td>
                <td class="py-3 px-2">
                    <div class="flex flex-wrap gap-1">
                        ${(m.roles || []).map(r => `<span class="px-2 py-0.5 text-[10px] rounded-md bg-white/10 text-gray-300 font-mono">${r}</span>`).join('')}
                    </div>
                </td>
                <td class="py-3 px-2">
                    <span class="px-2 py-0.5 text-[10px] rounded-md ${m.status === 'active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20'}">
                        ${m.status || 'Pending'}
                    </span>
                </td>
                <td class="py-3 px-2 text-right">
                    <button type="button" onclick="removeMember('${m.id}')" class="text-gray-500 hover:text-red-400 transition"><i class="fa-solid fa-trash text-xs"></i></button>
                </td>
            </tr>
        `).join('');
    } catch {
        tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-gray-500">No team members added yet.</td></tr>`;
    }
}

async function removeMember(memberId) {
    const confirmed = await showCustomConfirm("Revoke Access", "Are you sure you want to revoke access for this team member?");
    if (!confirmed) return;

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/members/${memberId}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
        });

        if (!response.ok) throw new Error("Failed to remove team member.");

        await loadAccountMembers();
        showToast("Member access revoked.");
    } catch (err) {
        showToast(err.message, true);
    }
}


            releaseTime: "",
            timeZone: "",
            label: "",
            cLine: "",
            pLine: ""
          };
        }

        return new Response(
          JSON.stringify({
            data: { artist: artistData },
            message: "Artist preferences retrieved successfully"
          }),
          { status: 200, headers: { ...corsHeaders, "Content-Type": "application/json" } }
        );

            status: 401,
            headers: { ...corsHeaders, "Content-Type": "application/json" }
          });
        }

        const prefKey = `PREFERENCES_ARTIST_${userId}`;
        let artistData = null;

        // Try fetching directly from Too Lost API upstream first
        try {
          const upstreamRes = await fetchTooLostAPI("/preferences/artist", "GET", null, env.TOO_LOST_API_KEY);
          if (upstreamRes.ok) {
            const upstreamJson = await upstreamRes.json();
            artistData = upstreamJson.data?.artist || upstreamJson.data || null;
      
            // Update KV cache with fresh upstream data
            if (artistData) {
              await env.AUDIORY_KV.put(prefKey, JSON.stringify(artistData));
            }
          }
        } catch (err) {
          console.error("Too Lost API upstream fetch failed, reading from KV cache:", err);
        }

        // Fallback to KV storage if upstream is unreachable or empty
        if (!artistData) {
          const rawData = await env.AUDIORY_KV.get(prefKey);
          artistData = rawData ? JSON.parse(rawData) : null;
        }

        // Dynamic empty schema if no data has been saved yet

          }
        } catch (err) {
          console.error("Failed to forward preferences to Too Lost API:", err);
        }

        // 2. Save state locally in KV storage
        await env.AUDIORY_KV.put(prefKey, JSON.stringify(updatedData));

        return new Response(
          JSON.stringify({ 
            message: "Preferences updated successfully", 
            data: updatedData,
            syncedWithTooLost: upstreamSuccess

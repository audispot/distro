        // 1. Forward to Too Lost API Upstream
        let upstreamSuccess = false;
        try {
          const upstreamRes = await fetchTooLostAPI("/preferences/artist", "POST", updatedData, env.TOO_LOST_API_KEY);
          if (upstreamRes.ok) {

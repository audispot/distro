            licenseInfo:
                window.releaseState.license?.info?.trim() || null,
            
            dsps: window.releaseState.dsps || [],
            platforms: window.releaseState.dsps || [],
            delivery: window.releaseState.delivery || {},
            
            cover_url: finalCoverUrl,
            coverUrl: finalCoverUrl,
            cover_art: finalCoverUrl,
            artwork: finalCoverUrl,
            compressed_artwork: finalCoverUrl,
            compressedArtwork: finalCoverUrl,
            
            tracks: (window.releaseState.tracks || []).map(t => ({
                title: t.metadata?.title?.trim() || '',
                version: t.metadata?.version?.trim() || null,
                explicit: Boolean(t.metadata?.explicit),
                isrc: t.isrc?.trim() || null,
                audio_url: t.audioUrl || null,
                audioUrl: t.audioUrl || null,
                instrumental_url: t.instrumentalUrl || null,
                instrumentalUrl: t.instrumentalUrl || null,
                tiktok_start_time: t.tiktokStartTime?.trim() || null,
                lyrics: {
                    content: t.lyrics?.content || null,
                    explicit: Boolean(t.lyrics?.explicit),
                    clean_version: Boolean(t.lyrics?.cleanVersion)
                },
                artists: (t.artists || []).filter(a => a.name?.trim()).map(a => ({
                    name: a.name.trim(),
                    role: a.role || 'primary'
                })),

window.renderDspOptions = function(searchTerm = '') {

    const query =
        String(searchTerm || '')
            .trim()
            .toLowerCase();


    const filtered =
        MASTER_DSP_LIST.filter(dsp =>
            !query ||
            dsp.name.toLowerCase().includes(query)
        );


    if (!filtered.length) {

        return `
            <div class="col-span-full text-center py-10 text-gray-500 text-sm">
                No platforms found.
            </div>
        `;

    }


    return filtered.map(dsp => {

        const isChecked =
            window.releaseState.dsps.includes(dsp.id);

        const maxReached =
            window.releaseState.dsps.length >= 120 &&
            !isChecked;


        return `

            <label
                class="p-3 rounded-xl bg-brand-dark border border-brand-border flex items-center justify-between gap-3 ${
                    maxReached
                        ? 'opacity-40 cursor-not-allowed'
                        : 'cursor-pointer hover:border-cyan-500/50'
                } transition"
            >

                <div class="flex items-center gap-3 min-w-0">

                    <i
                        class="${escapeHtml(dsp.icon || '')} text-lg w-6 text-center"
                    ></i>

                    <span
                        class="text-xs font-medium text-white truncate"
                        title="${escapeHtml(dsp.name)}"
                    >
                        ${escapeHtml(dsp.name)}
                    </span>

                </div>


                <input
                    type="checkbox"
                    value="${escapeHtml(dsp.id)}"
                    ${isChecked ? 'checked' : ''}
                    ${maxReached ? 'disabled' : ''}
                    onchange="toggleSingleDsp('${escapeHtml(dsp.id)}', this.checked)"
                    class="rounded bg-brand-card border-brand-border text-brand-accent focus:ring-0"
                >

            </label>

        `;

    }).join('');
};



// Custom Audio Player helper functions for Tailwind UI preview
window.toggleCustomAudioPlay = function(idx) {
    const audio = document.getElementById(`native_audio_${idx}`);
    const playIcon = document.getElementById(`play_icon_${idx}`);
    if (!audio) return;

    if (audio.paused) {
        audio.play();
        if (playIcon) playIcon.className = "fa-solid fa-pause text-xs";
    } else {
        audio.pause();
        if (playIcon) playIcon.className = "fa-solid fa-play text-xs";
    }
};

window.updateCustomAudioProgress = function(idx) {
    const audio = document.getElementById(`native_audio_${idx}`);
    const seekbar = document.getElementById(`audio_seekbar_${idx}`);
    const currentTimeEl = document.getElementById(`current_time_${idx}`);
    if (!audio || !seekbar) return;

    const progressPercent = (audio.currentTime / audio.duration) * 100;
    seekbar.value = isNaN(progressPercent) ? 0 : progressPercent;
    if (currentTimeEl) currentTimeEl.innerText = formatAudioTime(audio.currentTime);
};

window.seekCustomAudio = function(idx, value) {
    const audio = document.getElementById(`native_audio_${idx}`);
    if (!audio || !audio.duration) return;
    audio.currentTime = (value / 100) * audio.duration;
};

window.initCustomAudioMeta = function(idx) {
    const audio = document.getElementById(`native_audio_${idx}`);
    const durationEl = document.getElementById(`duration_${idx}`);
    if (audio && durationEl) {
        durationEl.innerText = formatAudioTime(audio.duration);
    }
};

window.resetCustomAudio = function(idx) {
    const playIcon = document.getElementById(`play_icon_${idx}`);
    if (playIcon) playIcon.className = "fa-solid fa-play text-xs";
};


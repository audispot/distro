    if (!file) return;

    const validTypes = ['audio/wav', 'audio/x-wav', 'audio/flac', 'audio/x-flac'];
    const validExtension = /\.(wav|flac)$/i.test(file.name);

    if (!validTypes.includes(file.type) && !validExtension) {
        input.value = '';
        window.showToast('Instrumental must be a WAV or FLAC file.');
        return;
    }

    window.releaseState.tracks[trackIndex].instrumentalFile = file;
    const url = URL.createObjectURL(file);
    window.releaseState.tracks[trackIndex].instrumentalPreviewUrl = url;

    const nameEl = document.getElementById(`instrumental_file_name_${trackIndex}`);
    if (nameEl) nameEl.innerText = file.name;

    const container = document.getElementById(`instrumental_preview_container_${trackIndex}`);
    if (container) {
        container.innerHTML = `
            <div class="flex items-center gap-3">

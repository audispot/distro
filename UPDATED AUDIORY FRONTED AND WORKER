// Handler functions to keep window.releaseState consistently synchronized
window.handlePrimaryGenreChange = function(genre) {
    window.releaseState.metadata.primaryGenre = genre || null;
    window.releaseState.metadata.secondaryGenre = null;
    
    const subSelect = document.getElementById('secondaryGenreSelect');
    if (!subSelect) return;

    if (genre && GENRE_MAP[genre]) {
        subSelect.disabled = false;
        subSelect.innerHTML = `<option value="">Select Subgenre (Optional)</option>` + 
            GENRE_MAP[genre].map(sub => `<option value="${sub}">${sub}</option>`).join('');
    } else {
        subSelect.disabled = true;
        subSelect.innerHTML = `<option value="">-- Select Primary Genre First --</option>`;
    }
};

window.handleCLineInput = function(val) {
    window.releaseState.label.cLine = val;
    const yearMatch = val.match(/\b(19|20)\d{2}\b/);
    window.releaseState.label.cYear = yearMatch ? yearMatch[0] : new Date().getFullYear().toString();
};

window.handlePLineInput = function(val) {
    window.releaseState.label.pLine = val;
    const yearMatch = val.match(/\b(19|20)\d{2}\b/);
    window.releaseState.label.pYear = yearMatch ? yearMatch[0] : new Date().getFullYear().toString();
};

window.renderArtistInputs = function() {
    const container = document.getElementById('step_1_artists_container');
    if (!container) return;

    container.innerHTML = window.releaseState.artists.map((artist, idx) => `
        <div class="p-3 bg-brand-dark rounded-xl border border-brand-border flex flex-col sm:flex-row gap-3 items-center">
            <div class="flex-1 w-full">
                <input type="text" placeholder="Artist Name *" value="${artist.name || ''}" 
                       oninput="window.releaseState.artists[${idx}].name = this.value" class="too-lost-input" required>
            </div>
            <div class="w-full sm:w-40">
                <select onchange="window.releaseState.artists[${idx}].role = this.value" class="too-lost-input">
                    <option value="primary" ${artist.role === 'primary' ? 'selected' : ''}>Primary Artist</option>
                    <option value="featured" ${artist.role === 'featured' ? 'selected' : ''}>Featured Artist</option>
                    <option value="remixer" ${artist.role === 'remixer' ? 'selected' : ''}>Remixer</option>
                </select>
            </div>
            ${window.releaseState.artists.length > 1 ? `
                <button type="button" onclick="removeArtistFromState(${idx})" class="text-red-400 text-xs px-2 hover:text-red-300">
                    <i class="fa-solid fa-trash"></i>
                </button>
            ` : ''}
        </div>
    `).join('');
};

window.addArtistToState = function() {
    window.releaseState.artists.push({ name: '', role: 'primary' });
    window.renderArtistInputs();
};

window.removeArtistFromState = function(idx) {
    window.releaseState.artists.splice(idx, 1);

function extractApiError(response) {
    if (!response) {
        return 'No response received from the distribution gateway.';
    }

    if (typeof response === 'string') {
        return response;
    }

    if (response.errors) {
        if (Array.isArray(response.errors)) {
            return response.errors
                .map(error => {
                    if (typeof error === 'string') {
                        return error;
                    }
                    return (
                        error.message ||
                        error.detail ||
                        JSON.stringify(error)
                    );
                })
                .join('\n');
        }

        if (typeof response.errors === 'object') {
            return Object.entries(response.errors)
                .map(([field, value]) =>
                    `${field}: ${
                        typeof value === 'string'
                            ? value
                            : JSON.stringify(value)
                    }`
                )
                .join('\n');
        }
    }

    return (
        response.message ||
        response.error ||
        response.detail ||
        'Unknown distribution API error.'
    );
}

window.handleFormSubmission = async function(event) {
    if (event) event.preventDefault();

    const validationErrors = window.validateReleaseForSubmission ? window.validateReleaseForSubmission() : [];
    const deliveryErrors = window.validateDelivery ? window.validateDelivery() : [];
    const allErrors = [...validationErrors, ...deliveryErrors];

    if (allErrors.length > 0) {
        return window.showToast(`Cannot submit: ${allErrors[0]}`);
    }

    if (!window.releaseState.agreements?.termsAccepted) {
        return window.showToast('Please confirm that you are authorized to distribute this release.');
    }

    if (!window.releaseState.agreements?.rightsConfirmed) {
        return window.showToast('Please confirm that all samples, interpolations and performances are cleared.');
    }

    const hasArtworkFile = Boolean(window.releaseState.artwork?.file);
    const existingArtworkUrl = window.releaseState.artwork?.url || '';
    
    if (!hasArtworkFile && !existingArtworkUrl) {
        return window.showToast('Please upload cover artwork before submitting.');
    }

    // =========================================================
    // 1. FAIL-SAFE GENRE & METADATA EXTRACTION (DOM + STATE FALLBACK)
    // =========================================================
    const primaryGenreSelect = document.getElementById('primaryGenreSelect') || 
                               document.getElementById('primaryGenre') || 
                               document.querySelector('[name="primaryGenre"]');
                               
    const secondaryGenreSelect = document.getElementById('secondaryGenreSelect') || 
                                 document.getElementById('secondaryGenre') || 
                                 document.querySelector('[name="secondaryGenre"]');

    const domPrimaryGenre = primaryGenreSelect ? primaryGenreSelect.value : '';
    const domSecondaryGenre = secondaryGenreSelect ? secondaryGenreSelect.value : '';

    const primaryGenre = String(
        window.releaseState.metadata?.primaryGenre ||
        window.releaseState.metadata?.primary_genre ||
        window.releaseState.metadata?.genre ||
        window.releaseState.primaryGenre ||
        window.releaseState.primary_genre ||
        window.releaseState.genre ||
        domPrimaryGenre ||
        ''
    ).trim();

    const secondaryGenre = String(
        window.releaseState.metadata?.secondaryGenre ||
        window.releaseState.metadata?.secondary_genre ||
        window.releaseState.metadata?.subgenre ||
        window.releaseState.secondaryGenre ||
        window.releaseState.secondary_genre ||
        window.releaseState.subgenre ||
        domSecondaryGenre ||
        ''
    ).trim();

    if (!primaryGenre) {
        return window.showToast('Please select a Primary Genre for this release.');
    }

    // Synchronize resolved values back into state to prevent downstream drops
    if (!window.releaseState.metadata) window.releaseState.metadata = {};
    window.releaseState.metadata.primaryGenre = primaryGenre;
    window.releaseState.metadata.secondaryGenre = secondaryGenre;

    const submitBtn = document.getElementById('submitReleaseBtn');
    const progressCard = document.getElementById('submission-progress-card');
    const statusText = document.getElementById('progress-status-text');
    const percentageText = document.getElementById('progress-percentage');
    const progressFill = document.getElementById('progress-bar-fill');

    const updateProgress = (percent, message) => {
        if (progressFill) progressFill.style.width = `${percent}%`;
        if (percentageText) percentageText.innerText = `${Math.round(percent)}%`;
        if (statusText) statusText.innerText = message;
    };

    let originalBtnHTML = '';
    if (submitBtn) {
        originalBtnHTML = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.style.cursor = 'not-allowed';
        submitBtn.style.opacity = '0.7';
        submitBtn.innerHTML = `
            <span style="display: inline-flex; align-items: center; gap: 8px;">
                <svg style="animation: spin 1s linear infinite; width: 16px; height: 16px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
                </svg>
                Submitting...
            </span>
        `;
    }

    if (progressCard) progressCard.style.display = 'block';
    updateProgress(5, 'Initializing submission...');

    try {
        const totalTracks = window.releaseState.tracks?.length || 0;
        const instrumentalCount = (window.releaseState.tracks || []).filter(t => Boolean(t.instrumentalFile)).length;
        const totalUploadSteps = (hasArtworkFile ? 1 : 0) + totalTracks + instrumentalCount;
        let completedSteps = 0;

        let finalCoverUrl = existingArtworkUrl;
        if (hasArtworkFile) {
            updateProgress(10, 'Uploading Cover Artwork...');
            const uploadRes = await uploadFileToR2(window.releaseState.artwork.file, 'artwork');
            finalCoverUrl = typeof uploadRes === 'string' ? uploadRes : (uploadRes?.url || uploadRes?.location || uploadRes?.path || '');

            if (!finalCoverUrl) throw new Error('Artwork upload succeeded but returned an invalid URL.');

            window.releaseState.artwork.url = finalCoverUrl;
            completedSteps++;
            const stepPercent = 10 + Math.floor((completedSteps / (totalUploadSteps || 1)) * 60);
            updateProgress(stepPercent, 'Cover Artwork uploaded successfully!');
        } else {
            updateProgress(20, 'Using existing artwork...');
        }

        for (let i = 0; i < totalTracks; i++) {

    const track = window.releaseState.tracks[i];

    // =========================================================
    // MASTER AUDIO → AUDIORY R2
    // =========================================================

    if (track.audioFile) {

        updateProgress(
            20 +
            Math.floor(
                (completedSteps /
                (totalUploadSteps || 1)) * 60
            ),
            `Uploading Track ${i + 1} of ${totalTracks}: "${track.metadata?.title || 'Master Audio'}"...`
        );

        const trackRes =
            await uploadFileToR2(
                track.audioFile,
                'audio'
            );

        const trackUrl =
            typeof trackRes === 'string'
                ? trackRes
                : (
                    trackRes?.url ||
                    trackRes?.location ||
                    ''
                );

        if (!trackUrl) {
            throw new Error(
                `Track ${i + 1} R2 upload returned no URL.`
            );
        }

        window.releaseState.tracks[i].audioUrl =
            trackUrl;
    }

    // =========================================================
    // INSTRUMENTAL → AUDIORY R2
    // =========================================================

    if (track.instrumentalFile) {

        updateProgress(
            50,
            `Uploading Track ${i + 1} Instrumental...`
        );

        const instrumentalRes =
            await uploadFileToR2(
                track.instrumentalFile,
                'instrumental'
            );

        const instrumentalUrl =
            typeof instrumentalRes === 'string'
                ? instrumentalRes
                : (
                    instrumentalRes?.url ||
                    instrumentalRes?.location ||
                    instrumentalRes?.path ||
                    ''
                );

        if (!instrumentalUrl) {
            throw new Error(
                `Track ${i + 1} instrumental upload returned no URL.`
            );
        }

        window.releaseState.tracks[i].instrumentalUrl =
            instrumentalUrl;
    }

    completedSteps++;
}

        updateProgress(80, 'Formatting release metadata & participant roles...');

        const labelNameInput = typeof window.releaseState.label === 'object' 
            ? (window.releaseState.label.name || window.releaseState.label.label) 
            : window.releaseState.label;

        const labelString = (labelNameInput && labelNameInput.trim()) ? labelNameInput.trim() : 'Independent';
        const ALLOWED_ROLES = ['primary', 'featuring', 'remixer'];

        const mappedParticipants = (window.releaseState.artists || [])
            .map(artist => {
                let rawRoles = Array.isArray(artist.role) ? artist.role : [artist.role || 'primary'];
                const cleanedRoles = rawRoles.map(r => {
                    const norm = String(r).toLowerCase().trim();
                    if (norm.includes('feat')) return 'featuring';
                    if (norm.includes('remix')) return 'remixer';
                    if (ALLOWED_ROLES.includes(norm)) return norm;
                    return 'primary';
                });

                const artistName = typeof artist === 'string' ? artist : (artist.name || artist.artist_name || '');
                return {
                    name: artistName.trim(),
                    role: Array.from(new Set(cleanedRoles)),
                    spotify_id: artist.spotify_id || '',
                    apple_id: artist.apple_id || ''
                };
            })
            .filter(p => p.name !== '');

        if (mappedParticipants.length === 0) throw new Error('Please specify at least one Primary Artist name.');

        const editingId = window.releaseState.editingId;
        const isEditing = Boolean(editingId);

        const currentYear = new Date().getFullYear().toString();
        const labelObject =
            window.releaseState.label && typeof window.releaseState.label === 'object'
                ? window.releaseState.label
                : {};

        const rawCLine = labelObject.cLine || window.releaseState.cLine || '';
        const rawPLine = labelObject.pLine || window.releaseState.pLine || '';

        const cYearMatch = rawCLine.match(/\b(19|20)\d{2}\b/);
        const pYearMatch = rawPLine.match(/\b(19|20)\d{2}\b/);

        const extractedCYear = cYearMatch ? cYearMatch[0] : (window.releaseState.label?.cYear || currentYear);
        const extractedPYear = pYearMatch ? pYearMatch[0] : (window.releaseState.label?.pYear || currentYear);

        const primaryGenreId = !isNaN(Number(primaryGenre)) && primaryGenre !== '' ? Number(primaryGenre) : null;
        const secondaryGenreId = !isNaN(Number(secondaryGenre)) && secondaryGenre !== '' ? Number(secondaryGenre) : null;

        // Standardized Payload with all fallback keys
        const payload = {
            title: window.releaseState.metadata?.title || '',
            type: window.releaseState.metadata?.type || 'Single',
            language: window.releaseState.metadata?.language || 'en',

            // Canonical Genre Keys (Strings & Numeric IDs)
            primaryGenre: primaryGenre,
            primary_genre: primaryGenre,
            primary_genre_id: primaryGenreId,
            genre: primaryGenre,

            secondaryGenre: secondaryGenre || null,
            secondary_genre: secondaryGenre || null,
            secondary_genre_id: secondaryGenreId,
            subgenre: secondaryGenre || null,

            label: labelString,
            cLine: rawCLine,
            c_line: rawCLine,
            cYear: extractedCYear,
            c_year: extractedCYear,
            pLine: rawPLine,
            p_line: rawPLine,
            pYear: extractedPYear,
            p_year: extractedPYear,
            
            participants: mappedParticipants,
            artists: mappedParticipants,
            
            releaseDate: window.releaseState.dates?.releaseDate || null,
            release_date: window.releaseState.dates?.releaseDate || null,

            releaseTime: window.releaseState.dates?.releaseTime || null,
            timeZone: window.releaseState.dates?.timezone || 'Africa/Nairobi',

            originalReleaseDate:
                window.releaseState.dates?.originalReleaseDate || null,

            applePreorder:
                Boolean(window.releaseState.applePreorder?.enabled),

            applePreorderDate:
                window.releaseState.applePreorder?.enabled
                    ? (window.releaseState.applePreorder?.date || null)
                    : null,

            licenseType:

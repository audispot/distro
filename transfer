// Global Controller Initialization
window.initTransferCatalog = function() {
  window.setTransferMode = function(mode) {
    ['manual', 'csv', 'ddex'].forEach(m => {
      document.getElementById(`view_${m}`).classList.toggle('hidden', m !== mode);
      const tab = document.getElementById(`tab_${m}`);
      if (m === mode) {
        tab.className = "p-4 rounded-xl border border-brand-accent bg-brand-dark/80 text-left transition flex items-start gap-3";
      } else {
        tab.className = "p-4 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 text-left transition flex items-start gap-3";
      }
    });
  };
};

// UI Toast helper (Replaces alerts)
function showTransferAlert(message, type = 'success') {
  const alertBox = document.getElementById('transferAlert');
  if (!alertBox) return;

  alertBox.className = type === 'success' 
    ? 'p-4 rounded-xl text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-between'
    : 'p-4 rounded-xl text-xs font-semibold bg-red-500/10 text-red-400 border border-red-500/20 flex items-center justify-between';
  
  alertBox.innerHTML = `<span>${message}</span><button onclick="this.parentElement.classList.add('hidden')" class="text-white hover:opacity-75 text-sm ml-4">✕</button>`;
  alertBox.classList.remove('hidden');
}

// 1. Manual Form Handler
window.submitManualTransfer = async function(e) {
  e.preventDefault();
  const form = e.target;
  const submitBtn = document.getElementById('btn_submit_transfer');
  
  submitBtn.disabled = true;
  submitBtn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Validating Metadata...`;

  try {
    const formData = new FormData(form);
    
    formData.append('previous_dsp_urls', JSON.stringify({
      spotify: formData.get('dsp_spotify') || '',
      apple: formData.get('dsp_apple') || ''
    }));

    const response = await fetch('/api/catalog/transfer', {
      method: 'POST',
      body: formData
    });

    const result = await response.json();

    if (response.ok && result.success) {
      showTransferAlert('Catalog release transfer submitted successfully! Status is now PENDING VERIFICATION.', 'success');
      form.reset();
    } else {
      showTransferAlert(result.error || 'Failed to submit transfer.', 'error');
    }
  } catch (err) {
    showTransferAlert('Network error occurred during submission.', 'error');
  } finally {
    submitBtn.disabled = false;
    submitBtn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up mr-2"></i> Submit Release Transfer`;
  }
};

// 2. CSV File Selector & Processing Handler (No Popups)
window.handleCsvSelected = function(e) {
  const file = e.target.files[0];
  if (file) {
    document.getElementById('csv_file_label').textContent = `Selected File: ${file.name}`;
  }
};

window.submitCsvTransfer = async function() {
  const fileInput = document.getElementById('csv_file_input');
  if (!fileInput.files.length) {
    showTransferAlert('Please select a valid CSV file before submitting.', 'error');
    return;
  }

  const btn = document.getElementById('btn_submit_csv');
  btn.disabled = true;
  btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Parsing CSV...`;

  const reader = new FileReader();
  reader.onload = async function(e) {
    try {
      const text = e.target.result;
      const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
      const headers = lines[0].split(',').map(h => h.trim().toLowerCase());
      
      const rows = lines.slice(1).map(line => {
        const values = line.split(',');
        let rowData = {};
        headers.forEach((h, i) => { rowData[h] = values[i] ? values[i].trim() : ''; });
        return rowData;
      });

      const response = await fetch('/api/catalog/transfer/csv', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rows })
      });

      const result = await response.json();
      if (response.ok && result.success) {
        showTransferAlert(`Successfully imported ${result.count} releases from CSV!`, 'success');
        fileInput.value = '';
        document.getElementById('csv_file_label').textContent = 'Click to upload metadata CSV or drag & drop';
      } else {
        showTransferAlert(result.error || 'Failed to parse CSV.', 'error');
      }
    } catch (err) {
      showTransferAlert('Error reading CSV file content.', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = `Process CSV Import`;
    }
  };
  reader.readAsText(fileInput.files[0]);
};

// 3. DDEX File Selector & Ingestion Handler (No Popups)
window.handleDdexSelected = function(e) {
  const file = e.target.files[0];
  if (file) {
    document.getElementById('ddex_file_label').textContent = `Selected XML: ${file.name}`;
  }
};

window.submitDdexTransfer = async function() {
  const fileInput = document.getElementById('ddex_file_input');
  if (!fileInput.files.length) {
    showTransferAlert('Please select a DDEX XML file before submitting.', 'error');
    return;
  }

  const btn = document.getElementById('btn_submit_ddex');
  btn.disabled = true;
  btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Ingesting DDEX XML...`;

  try {
    const xmlContent = await fileInput.files[0].text();
    const response = await fetch('/api/catalog/transfer/ddex', {
      method: 'POST',
      headers: { 'Content-Type': 'application/xml' },
      body: xmlContent
    });

    const result = await response.json();
    if (response.ok && result.success) {
      showTransferAlert(`DDEX Ingestion successful for "${result.parsed.title}" (UPC: ${result.parsed.upc})!`, 'success');
      fileInput.value = '';
      document.getElementById('ddex_file_label').textContent = 'Click to upload DDEX .xml file';
    } else {
      showTransferAlert(result.error || 'Failed to process DDEX file.', 'error');
    }
  } catch (err) {
    showTransferAlert('Error transmitting DDEX payload.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = `Parse DDEX XML`;
  }
};

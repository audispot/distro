(function() {
    /* ==========================================================================
       GENRE MAP DATA & TRANSFER CATALOG STATE
       ========================================================================== */
    window.TRANSFER_GENRE_MAP = {
        "Afrobeats": ["Afropop", "Amapiano", "Afro-Fusion", "Afro House", "Highlife", "Alte"],
        "Hip Hop": ["Trap", "Boom Bap", "Drill", "Conscious Hip Hop", "Melodic Rap", "Lofi Hip Hop"],
        "Pop": ["Dance Pop", "Electropop", "Indie Pop", "Synthpop", "Teen Pop"],
        "R&B": ["Contemporary R&B", "Neo-Soul", "Alternative R&B", "Slow Jams"],
        "Reggae / Dancehall": ["Dancehall", "Roots Reggae", "Dub", "Reggaeton"],
        "Electronic / Dance": ["House", "Techno", "Deep House", "EDM", "Ambiance", "Trance"],
        "Rock": ["Alternative Rock", "Indie Rock", "Hard Rock", "Pop Punk"]
    };

    window.transferState = window.transferState || {
        previousDistributor: 'DistroKid',
        title: '',
        type: 'Single',
        language: 'English',
        primaryGenre: '',
        secondaryGenre: '',
        artists: [{ name: '', role: 'Primary' }],
        label: '',
        cLine: '',
        pLine: '',
        releaseDate: '',
        timezone: 'Africa/Nairobi',
        upc: '',
        artwork: { file: null, url: '', inspected: null },
        tracks: [
            {
                title: '',
                version: '',
                discNumber: 1,
                isrc: '',
                explicit: false,
                audioFile: null,
                previewUrl: '',
                tiktokStartTime: '00:30',
                lyrics: ''
            }
        ],
        dspSpotify: '',
        dspApple: '',
        confirmedRights: false
    };

    /* ==========================================================================
       RENDER TRANSFER CATALOG VIEW
       ========================================================================== */
    window.renderTransferCatalogView = function() {
        return `
            <div class="max-w-5xl mx-auto space-y-6">
                <div class="border-b border-white/10 pb-4">
                    <h1 class="text-2xl font-bold text-white">Catalog Transfer</h1>
                    <p class="text-xs text-gray-400 mt-1">Import existing releases from other distributors while preserving ISRC/UPC streams and playlist metadata.</p>
                </div>

                <div id="view_manual" class="bg-brand-dark/40 border border-white/10 rounded-2xl p-6 space-y-6">
                    <!-- 1. DISTRIBUTOR SELECTION -->
                    <div>
                        <h3 class="text-sm font-bold text-white border-b border-white/10 pb-3 mb-4">1. Select Previous Distributor</h3>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
                            ${['DistroKid', 'TuneCore', 'CD Baby', 'UnitedMasters', 'Amuse', 'Other'].map(distro => `
                                <label class="flex flex-col items-center justify-center p-3 rounded-xl border border-white/10 bg-white/5 cursor-pointer hover:border-amber-400/50 transition group">
                                    <input type="radio" name="previous_distributor" value="${distro}" 
                                           onchange="window.transferState.previousDistributor = this.value" 
                                           class="hidden peer" ${distro === window.transferState.previousDistributor ? 'checked' : ''}>
                                    <span class="text-xs font-bold text-gray-300 peer-checked:text-amber-400 transition">${distro}</span>
                                    <div class="w-2 h-2 rounded-full bg-amber-400 opacity-0 peer-checked:opacity-100 mt-1"></div>
                                </label>
                            `).join('')}
                        </div>
                    </div>

                    <form onsubmit="handleTransferSubmission(event)" class="space-y-6">
                        <!-- 2. RELEASE & OWNERSHIP METADATA -->
                        <div class="space-y-4">
                            <h3 class="text-sm font-bold text-white border-b border-white/10 pb-3">2. Release Metadata</h3>
                            
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">Release Title *</label>
                                    <input type="text" required value="${window.transferState.title}" 
                                           oninput="window.transferState.title = this.value; window.syncFirstTrackTitle();" 
                                           placeholder="e.g. Midnight Memories" 
                                           class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">Release Type *</label>
                                    <select onchange="window.transferState.type = this.value; window.adjustTransferTracksForType();" 
                                            class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                        <option value="Single" ${window.transferState.type === 'Single' ? 'selected' : ''}>Single</option>
                                        <option value="EP" ${window.transferState.type === 'EP' ? 'selected' : ''}>EP</option>
                                        <option value="Album" ${window.transferState.type === 'Album' ? 'selected' : ''}>Album</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">Primary Language *</label>
                                    <select onchange="window.transferState.language = this.value" 
                                            class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                        <option value="English" ${window.transferState.language === 'English' ? 'selected' : ''}>English</option>
                                        <option value="Swahili" ${window.transferState.language === 'Swahili' ? 'selected' : ''}>Swahili</option>
                                        <option value="French" ${window.transferState.language === 'French' ? 'selected' : ''}>French</option>
                                        <option value="Spanish" ${window.transferState.language === 'Spanish' ? 'selected' : ''}>Spanish</option>
                                        <option value="Portuguese" ${window.transferState.language === 'Portuguese' ? 'selected' : ''}>Portuguese</option>
                                        <option value="Instrumental" ${window.transferState.language === 'Instrumental' ? 'selected' : ''}>Instrumental (No Lyrics)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Genre & Dynamic Subgenre Selection -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">Primary Genre *</label>
                                    <select onchange="handleTransferGenreChange(this.value)" required 
                                            class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                        <option value="">Select Primary Genre</option>
                                        ${Object.keys(TRANSFER_GENRE_MAP).map(g => `<option value="${g}" ${window.transferState.primaryGenre === g ? 'selected' : ''}>${g}</option>`).join('')}
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">Subgenre / Secondary Genre</label>
                                    <select id="transferSubgenreSelect" onchange="window.transferState.secondaryGenre = this.value" 
                                            class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none" 
                                            ${!window.transferState.primaryGenre ? 'disabled' : ''}>
                                        <option value="">${window.transferState.primaryGenre ? 'Select Subgenre' : '-- Select Primary Genre First --'}</option>
                                        ${window.transferState.primaryGenre && TRANSFER_GENRE_MAP[window.transferState.primaryGenre] 
                                            ? TRANSFER_GENRE_MAP[window.transferState.primaryGenre].map(sub => `<option value="${sub}" ${window.transferState.secondaryGenre === sub ? 'selected' : ''}>${sub}</option>`).join('')
                                            : ''}
                                    </select>
                                </div>
                            </div>

                            <!-- Dynamic Artists List -->
                            <div class="space-y-2">
                                <div class="flex items-center justify-between">
                                    <label class="block text-xs font-medium text-gray-400">Primary & Associated Artists *</label>
                                    <button type="button" onclick="addTransferArtist()" class="text-xs text-amber-400 hover:underline">+ Add Artist / Remixer</button>
                                </div>
                                <div id="transfer_artists_container" class="space-y-3">
                                    ${window.renderTransferArtistInputs()}
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">Original Release Date *</label>
                                    <input type="date" required value="${window.transferState.releaseDate}" 
                                           onchange="window.transferState.releaseDate = this.value" 
                                           class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">Release Timezone *</label>
                                    <select onchange="window.transferState.timezone = this.value" 
                                            class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                        <option value="Africa/Nairobi" ${window.transferState.timezone === 'Africa/Nairobi' ? 'selected' : ''}>Africa/Nairobi (EAT)</option>
                                        <option value="UTC" ${window.transferState.timezone === 'UTC' ? 'selected' : ''}>UTC</option>
                                        <option value="America/New_York" ${window.transferState.timezone === 'America/New_York' ? 'selected' : ''}>America/New York (EST)</option>
                                        <option value="Europe/London" ${window.transferState.timezone === 'Europe/London' ? 'selected' : ''}>Europe/London (GMT)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">Release UPC Code *</label>
                                    <input type="text" required value="${window.transferState.upc}" 
                                           oninput="window.transferState.upc = this.value" 
                                           placeholder="12 or 13-digit UPC" 
                                           class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">Record Label *</label>
                                    <input type="text" required value="${window.transferState.label}" 
                                           oninput="window.transferState.label = this.value" 
                                           placeholder="e.g. Audiory Records" 
                                           class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">(C) Line Copyright *</label>
                                    <input type="text" required value="${window.transferState.cLine}" 
                                           oninput="window.transferState.cLine = this.value" 
                                           placeholder="© 2026 Record Label" 
                                           class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-400 mb-1">(P) Line Phonogram *</label>
                                    <input type="text" required value="${window.transferState.pLine}" 
                                           oninput="window.transferState.pLine = this.value" 
                                           placeholder="℗ 2026 Record Label" 
                                           class="w-full bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                                </div>
                            </div>
                        </div>

                        <!-- 3. COVER ARTWORK WITH INSPECTOR & PREVIEW -->
                        <div class="space-y-4 pt-2">
                            <h3 class="text-sm font-bold text-white border-b border-white/10 pb-3">3. Artwork File</h3>
                            <div>
                                <label class="block text-xs font-medium text-gray-400 mb-1">Cover Artwork (3000x3000px JPG/PNG) *</label>
                                <input type="file" accept="image/png, image/jpeg" onchange="handleTransferArtworkSelection(event)" 
                                       class="w-full text-xs text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-amber-400 file:text-black hover:file:bg-amber-300">
                            </div>
                            <div id="transferArtworkPreviewContainer" class="${window.transferState.artwork.url ? '' : 'hidden'} p-4 rounded-xl bg-black/30 border border-white/10 flex flex-col sm:flex-row gap-4 items-center">
                                <img id="transferArtworkPreviewImg" src="${window.transferState.artwork.url || ''}" class="w-36 h-36 rounded-xl object-cover border border-white/10 shadow-lg">
                                <div id="transferArtworkSpecsBox" class="text-xs space-y-1.5 text-gray-300 font-mono">
                                    ${window.transferState.artwork.inspected ? `
                                        <p>File Name: ${window.transferState.artwork.inspected.filename}</p>
                                        <p>Dimensions: ${window.transferState.artwork.inspected.width}x${window.transferState.artwork.inspected.height} px</p>
                                        <p>Format: ${window.transferState.artwork.inspected.mime}</p>
                                        <p class="${window.transferState.artwork.inspected.valid ? 'text-emerald-400' : 'text-red-400'} font-bold">
                                            ${window.transferState.artwork.inspected.valid ? '✓ Artwork Meets Requirements' : '✗ Invalid Dimensions (Min 3000x3000px required)'}
                                        </p>
                                    ` : ''}
                                </div>
                            </div>
                        </div>

                        <!-- 4. TRACKS MANAGEMENT (Dynamic for Single, EP, Album) -->
                        <div class="space-y-4 pt-2">
                            <div class="flex items-center justify-between border-b border-white/10 pb-3">
                                <h3 class="text-sm font-bold text-white">4. Track Data & Audio Masters (${window.transferState.tracks.length})</h3>
                                <div id="transfer_add_track_btn_wrapper">
                                    ${(window.transferState.type === 'EP' || window.transferState.type === 'Album') ? `
                                        <button type="button" onclick="addTrackToTransfer()" class="px-3 py-1.5 rounded-lg bg-amber-400 text-black font-bold text-xs hover:bg-amber-300 transition">
                                            <i class="fa-solid fa-plus mr-1"></i> Add Another Track
                                        </button>
                                    ` : ''}
                                </div>
                            </div>

                            <div id="transfer_tracks_list_container" class="space-y-6">
                                ${window.renderTransferTracksList()}
                            </div>
                        </div>

                        <!-- 5. DSP STORE URLS -->
                        <div class="space-y-4 pt-2">
                            <h3 class="text-sm font-bold text-white border-b border-white/10 pb-3">5. Store URLs (Preserves Stream Count & Playlists)</h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <input type="url" value="${window.transferState.dspSpotify}" 
                                       oninput="window.transferState.dspSpotify = this.value" 
                                       placeholder="Spotify Track / Album Link" 
                                       class="bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white outline-none focus:border-amber-400">
                                <input type="url" value="${window.transferState.dspApple}" 
                                       oninput="window.transferState.dspApple = this.value" 
                                       placeholder="Apple Music Track / Album Link" 
                                       class="bg-black/40 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white outline-none focus:border-amber-400">
                            </div>
                        </div>

                        <!-- 6. RIGHTS CONFIRMATION -->
                        <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 space-y-2">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" required ${window.transferState.confirmedRights ? 'checked' : ''} 
                                       onchange="window.transferState.confirmedRights = this.checked" 
                                       class="rounded accent-amber-400">
                                <span class="text-xs text-gray-200 font-medium">I confirm I own 100% of the masters and rights to transfer this release to Audiory.</span>
                            </label>
                        </div>

                        <button type="submit" id="btn_submit_transfer" class="w-full py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs uppercase tracking-wider transition">
                            <i class="fa-solid fa-cloud-arrow-up mr-2"></i> Submit Release Transfer
                        </button>
                    </form>
                </div>
            </div>
        `;
    };

    // Alias required by dashboard window.switchView
    window.renderTransferView = window.renderTransferCatalogView;

    /* ==========================================================================
       DYNAMIC ARTIST HANDLERS
       ========================================================================== */
    window.renderTransferArtistInputs = function() {
        return window.transferState.artists.map((artist, idx) => `
            <div class="p-3 bg-black/40 rounded-xl border border-white/10 flex flex-col sm:flex-row gap-3 items-center">
                <div class="flex-1 w-full">
                    <input type="text" placeholder="Artist Name *" value="${artist.name || ''}" 
                           oninput="window.transferState.artists[${idx}].name = this.value" 
                           class="w-full bg-black/60 border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:border-amber-400 outline-none" required>
                </div>
                <div class="w-full sm:w-40">
                    <select onchange="window.transferState.artists[${idx}].role = this.value" 
                            class="w-full bg-black/60 border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:border-amber-400 outline-none">
                        <option value="Primary" ${artist.role === 'Primary' ? 'selected' : ''}>Primary Artist</option>
                        <option value="Featuring" ${artist.role === 'Featuring' ? 'selected' : ''}>Featured Artist</option>
                        <option value="Remixer" ${artist.role === 'Remixer' ? 'selected' : ''}>Remixer</option>
                    </select>
                </div>
                ${window.transferState.artists.length > 1 ? `
                    <button type="button" onclick="removeTransferArtist(${idx})" class="text-red-400 text-xs px-2 hover:text-red-300">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                ` : ''}
            </div>
        `).join('');
    };

    window.addTransferArtist = function() {
        window.transferState.artists.push({ name: '', role: 'Primary' });
        const container = document.getElementById('transfer_artists_container');
        if (container) container.innerHTML = window.renderTransferArtistInputs();
    };

    window.removeTransferArtist = function(idx) {
        window.transferState.artists.splice(idx, 1);
        const container = document.getElementById('transfer_artists_container');
        if (container) container.innerHTML = window.renderTransferArtistInputs();
    };

    /* ==========================================================================
       GENRE & TRACK LIST ADJUSTMENTS
       ========================================================================== */
    window.handleTransferGenreChange = function(genre) {
        window.transferState.primaryGenre = genre;
        window.transferState.secondaryGenre = '';
        
        const subSelect = document.getElementById('transferSubgenreSelect');
        if (!subSelect) return;

        if (genre && window.TRANSFER_GENRE_MAP[genre]) {
            subSelect.disabled = false;
            subSelect.innerHTML = `<option value="">Select Subgenre</option>` + 
                window.TRANSFER_GENRE_MAP[genre].map(sub => `<option value="${sub}">${sub}</option>`).join('');
        } else {
            subSelect.disabled = true;
            subSelect.innerHTML = `<option value="">-- Select Primary Genre First --</option>`;
        }
    };

    window.syncFirstTrackTitle = function() {
        if (window.transferState.type === 'Single' && window.transferState.tracks[0]) {
            window.transferState.tracks[0].title = window.transferState.title;
            const firstInput = document.getElementById('track_title_input_0');
            if (firstInput) firstInput.value = window.transferState.title;
        }
    };

    window.adjustTransferTracksForType = function() {
        const type = window.transferState.type;

        // Toggle "Add Another Track" button depending on EP / Album / Single selection
        const btnWrapper = document.getElementById('transfer_add_track_btn_wrapper');
        if (btnWrapper) {
            btnWrapper.innerHTML = (type === 'EP' || type === 'Album') ? `
                <button type="button" onclick="addTrackToTransfer()" class="px-3 py-1.5 rounded-lg bg-amber-400 text-black font-bold text-xs hover:bg-amber-300 transition">
                    <i class="fa-solid fa-plus mr-1"></i> Add Another Track
                </button>
            ` : '';
        }

        if (type === 'Single') {
            window.transferState.tracks = [window.transferState.tracks[0] || {
                title: window.transferState.title || '',
                version: '',
                discNumber: 1,
                isrc: '',
                explicit: false,
                audioFile: null,
                previewUrl: '',
                tiktokStartTime: '00:30',
                lyrics: ''
            }];
        }
        
        const container = document.getElementById('transfer_tracks_list_container');
        if (container) container.innerHTML = window.renderTransferTracksList();
    };

    /* ==========================================================================
       DYNAMIC TRACKS RENDERER WITH AUDIO PREVIEW
       ========================================================================== */
    window.renderTransferTracksList = function() {
        return window.transferState.tracks.map((track, idx) => `
            <div class="p-5 rounded-2xl bg-black/40 border border-white/10 space-y-4">
                <div class="flex items-center justify-between border-b border-white/10 pb-3">
                    <span class="text-xs font-bold text-amber-400 uppercase tracking-wider">Track ${idx + 1} of ${window.transferState.tracks.length}</span>
                    ${window.transferState.tracks.length > 1 ? `
                        <button type="button" onclick="removeTrackFromTransfer(${idx})" class="text-xs text-red-400 hover:text-red-300">
                            <i class="fa-solid fa-trash mr-1"></i> Remove Track
                        </button>
                    ` : ''}
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-medium text-gray-400 mb-1">Track Title *</label>
                        <input type="text" id="track_title_input_${idx}" required value="${track.title || ''}" 
                               oninput="window.transferState.tracks[${idx}].title = this.value" 
                               placeholder="Track Title" class="w-full bg-black/60 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Version / Subtitle</label>
                        <input type="text" value="${track.version || ''}" 
                               oninput="window.transferState.tracks[${idx}].version = this.value" 
                               placeholder="e.g. Extended Mix" class="w-full bg-black/60 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Disc Number</label>
                        <input type="number" min="1" value="${track.discNumber || 1}" 
                               onchange="window.transferState.tracks[${idx}].discNumber = parseInt(this.value)" 
                               class="w-full bg-black/60 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Track ISRC Code *</label>
                        <input type="text" required value="${track.isrc || ''}" 
                               oninput="window.transferState.tracks[${idx}].isrc = this.value" 
                               placeholder="e.g. US-S1Z-24-00001" class="w-full bg-black/60 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Explicit Status *</label>
                        <select onchange="window.transferState.tracks[${idx}].explicit = (this.value === 'true')" 
                                class="w-full bg-black/60 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                            <option value="false" ${!track.explicit ? 'selected' : ''}>Clean / Non-Explicit</option>
                            <option value="true" ${track.explicit ? 'selected' : ''}>Explicit</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">TikTok Start (MM:SS)</label>
                        <input type="text" value="${track.tiktokStartTime || '00:30'}" 
                               oninput="window.transferState.tracks[${idx}].tiktokStartTime = this.value" 
                               placeholder="00:30" class="w-full bg-black/60 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none">
                    </div>
                </div>

                <!-- Audio File Upload & Live Preview Player -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Audio Master File (WAV/FLAC) *</label>
                        <input type="file" accept="audio/wav,audio/flac" required 
                               onchange="handleTransferAudioPreview(${idx}, this)" 
                               class="w-full text-xs text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-amber-400 file:text-black hover:file:bg-amber-300">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-400 mb-1">Audio Live Waveform / Player Preview</label>
                        <div id="transfer_audio_preview_container_${idx}" class="flex items-center h-10 px-3 rounded-xl bg-black/60 border border-white/10">
                            ${track.previewUrl ? `
                                <audio controls class="w-full h-8">
                                    <source src="${track.previewUrl}">
                                    Your browser does not support audio playback.
                                </audio>
                            ` : '<span class="text-xs text-gray-500">No audio uploaded yet</span>'}
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-gray-400 mb-1">Plain Text Lyrics (Optional)</label>
                    <textarea oninput="window.transferState.tracks[${idx}].lyrics = this.value" 
                              rows="2" class="w-full bg-black/60 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs text-white focus:border-amber-400 outline-none" 
                              placeholder="Paste lyrics here...">${track.lyrics || ''}</textarea>
                </div>
            </div>
        `).join('');
    };

    window.addTrackToTransfer = function() {
        window.transferState.tracks.push({
            title: '',
            version: '',
            discNumber: 1,
            isrc: '',
            explicit: false,
            audioFile: null,
            previewUrl: '',
            tiktokStartTime: '00:30',
            lyrics: ''
        });
        const container = document.getElementById('transfer_tracks_list_container');
        if (container) container.innerHTML = window.renderTransferTracksList();
    };

    window.removeTrackFromTransfer = function(idx) {
        if (window.transferState.tracks.length <= 1) return;
        window.transferState.tracks.splice(idx, 1);
        const container = document.getElementById('transfer_tracks_list_container');
        if (container) container.innerHTML = window.renderTransferTracksList();
    };

    /* ==========================================================================
       FILE INSPECTION & PREVIEWS
       ========================================================================== */
    window.handleTransferArtworkSelection = async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        window.transferState.artwork.file = file;
        const previewContainer = document.getElementById('transferArtworkPreviewContainer');
        const previewImg = document.getElementById('transferArtworkPreviewImg');
        const specsBox = document.getElementById('transferArtworkSpecsBox');

        const previewUrl = URL.createObjectURL(file);
        window.transferState.artwork.url = previewUrl;
        if (previewImg) previewImg.src = previewUrl;

        const inspected = await inspectTransferImageFile(file);
        window.transferState.artwork.inspected = inspected;

        if (specsBox) {
            specsBox.innerHTML = `
                <p>File Name: ${inspected.filename}</p>
                <p>Dimensions: ${inspected.width}x${inspected.height} px</p>
                <p>Format: ${inspected.mime}</p>
                <p class="${inspected.valid ? 'text-emerald-400' : 'text-red-400'} font-bold">
                    ${inspected.valid ? '✓ Artwork Meets Requirements' : '✗ Invalid Dimensions (Min 3000x3000px required)'}
                </p>
            `;
        }
        if (previewContainer) previewContainer.classList.remove('hidden');
    };

    async function inspectTransferImageFile(file) {
        return new Promise((resolve) => {
            const reader = new FileReader();
            reader.onloadend = (e) => {
                const arr = (new Uint8Array(e.target.result)).subarray(0, 4);
                let header = "";
                for (let i = 0; i < arr.length; i++) header += arr[i].toString(16);
                
                let mime = "unknown";
                if (header.startsWith("89504e47")) mime = "image/png";
                else if (header.startsWith("ffd8ff")) mime = "image/jpeg";

                const img = new Image();
                img.src = URL.createObjectURL(file);
                img.onload = () => {
                    resolve({
                        filename: file.name,
                        mime: mime,
                        width: img.width,
                        height: img.height,
                        fileSize: `${(file.size / (1024 * 1024)).toFixed(2)} MB`,
                        valid: (mime !== "unknown" && img.width >= 3000 && img.height >= 3000)
                    });
                };
            };
            reader.readAsArrayBuffer(file.slice(0, 4));
        });
    }

    window.handleTransferAudioPreview = function(trackIndex, inputElement) {
        const file = inputElement.files[0];
        if (!file) return;

        window.transferState.tracks[trackIndex].audioFile = file;
        const previewUrl = URL.createObjectURL(file);
        window.transferState.tracks[trackIndex].previewUrl = previewUrl;

        const container = document.getElementById(`transfer_audio_preview_container_${trackIndex}`);
        if (container) {
            container.innerHTML = `
                <audio controls class="w-full h-8">
                    <source src="${previewUrl}" type="${file.type}">
                    Your browser does not support audio playback.
                </audio>
            `;
        }
    };

    /* ==========================================================================
       SUBMISSION HANDLER
       ========================================================================== */
    window.handleTransferSubmission = async function(e) {
        if (e) e.preventDefault();

        if (!window.transferState.confirmedRights) {
            return window.showToast ? window.showToast('Please confirm rights ownership before submitting.') : alert('Please confirm rights ownership before submitting.');
        }

        if (!window.transferState.artwork.file) {
            return window.showToast ? window.showToast('Please select a valid artwork file.') : alert('Please select a valid artwork file.');
        }

        const btn = document.getElementById('btn_submit_transfer');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin mr-2"></i> Uploading & Transferring Release...`;
        }

        try {
            // Upload Artwork File
            let coverUrl = '';
            if (typeof uploadFileToR2 === 'function') {
                const artRes = await uploadFileToR2(window.transferState.artwork.file, 'artwork');
                coverUrl = typeof artRes === 'string' ? artRes : (artRes?.url || '');
            }

            // Upload Audio File(s)
            for (let i = 0; i < window.transferState.tracks.length; i++) {
                const t = window.transferState.tracks[i];
                if (t.audioFile && typeof uploadFileToR2 === 'function') {
                    const trackRes = await uploadFileToR2(t.audioFile, 'audio');
                    window.transferState.tracks[i].audioUrl = typeof trackRes === 'string' ? trackRes : (trackRes?.url || '');
                }
            }

            // Build Transfer Payload
            const payload = {
                isTransfer: true,
                previousDistributor: window.transferState.previousDistributor,
                title: window.transferState.title,
                type: window.transferState.type,
                language: window.transferState.language,
                genre: window.transferState.primaryGenre,
                subgenre: window.transferState.secondaryGenre,
                artists: window.transferState.artists,
                releaseDate: window.transferState.releaseDate,
                timezone: window.transferState.timezone,
                upc: window.transferState.upc,
                label: window.transferState.label,
                cLine: window.transferState.cLine,
                pLine: window.transferState.pLine,
                coverUrl: coverUrl,
                tracks: window.transferState.tracks.map(t => ({
                    title: t.title,
                    version: t.version,
                    discNumber: t.discNumber,
                    isrc: t.isrc,
                    explicit: t.explicit,
                    audioUrl: t.audioUrl || '',
                    tiktokStartTime: t.tiktokStartTime,
                    lyrics: t.lyrics
                })),
                dspUrls: {
                    spotify: window.transferState.dspSpotify,
                    apple: window.transferState.dspApple
                },
                submittedBy: window.currentUser ? window.currentUser.uid : 'anonymous',
                createdAt: new Date().toISOString()
            };

            const token = window.currentUser?.getIdToken ? await window.currentUser.getIdToken() : '';
            const endpoint = `${WORKER_BASE_URL}/api/releases`;

            const res = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify(payload)
            });

            if (!res.ok) throw new Error('Failed to submit transfer release to API');

            if (window.showToast) window.showToast('Transfer request submitted successfully!');
            if (typeof window.switchView === 'function') window.switchView('catalog');

        } catch (err) {
            console.error('Transfer submission error:', err);
            if (window.showToast) window.showToast(`Transfer failed: ${err.message}`);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up mr-2"></i> Submit Release Transfer`;
            }
        }
    };
})();

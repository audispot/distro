/**
 * AUDIORY MUSIC API
 * Authentication Engine
 *
 * Phase 2
 *
 * Bindings:
 *
 * DB             -> D1 audiory-production
 * AUDIO_BUCKET   -> R2 audiory-tracks
 *
 * Secrets:
 *
 * USER_JWT_SECRET
 * DEVELOPER_JWT_SECRET
 */

const API_VERSION = "v1";

const encoder = new TextEncoder();
const decoder = new TextDecoder();

const USER_TOKEN_TTL = 60 * 60 * 24 * 7; // 7 days
const DEVELOPER_TOKEN_TTL = 60 * 60; // 1 hour

const PASSWORD_ITERATIONS = 100000;


/* ============================================================
   GENERAL HELPERS
============================================================ */

function createRequestId() {
  return `req_${crypto.randomUUID()}`;
}

function createId(prefix) {
  return `${prefix}_${crypto.randomUUID().replaceAll("-", "")}`;
}

function nowISO() {
  return new Date().toISOString();
}

function json(data, status = 200, headers = {}) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json; charset=utf-8",
      "Cache-Control": "no-store",
      ...headers,
    },
  });
}

function success(data, requestId, meta = {}) {
  return json({
    data,
    meta,
    request_id: requestId,
  });
}

function fail(
  code,
  message,
  status,
  requestId,
  details = undefined
) {
  return json(
    {
      error: {
        code,
        message,
        ...(details !== undefined ? { details } : {}),
      },
      request_id: requestId,
    },
    status
  );
}

function corsHeaders(origin) {
  return {
    "Access-Control-Allow-Origin": origin || "*",
    "Access-Control-Allow-Methods":
      "GET, POST, PUT, PATCH, DELETE, OPTIONS",
    "Access-Control-Allow-Headers":
      "Authorization, Content-Type, X-Request-ID",
    "Access-Control-Max-Age": "86400",
  };
}

async function readJSON(request) {
  const contentType = request.headers.get("Content-Type") || "";

  if (!contentType.toLowerCase().includes("application/json")) {
    throw new Error("INVALID_CONTENT_TYPE");
  }

  return await request.json();
}

function normalizeEmail(email) {
  return String(email || "").trim().toLowerCase();
}

function normalizeUsername(username) {
  return String(username || "")
    .trim()
    .toLowerCase();
}

function validEmail(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

function validUsername(username) {
  return /^[a-z0-9_]{3,30}$/.test(username);
}

function validPassword(password) {
  return (
    typeof password === "string" &&
    password.length >= 10 &&
    password.length <= 128
  );
}


/* ============================================================
   BASE64URL
============================================================ */

function base64urlEncode(bytes) {
  let binary = "";

  for (const byte of bytes) {
    binary += String.fromCharCode(byte);
  }

  return btoa(binary)
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/g, "");
}

function base64urlDecode(value) {
  const normalized = value
    .replace(/-/g, "+")
    .replace(/_/g, "/");

  const padding =
    normalized.length % 4 === 0
      ? ""
      : "=".repeat(4 - (normalized.length % 4));

  const binary = atob(normalized + padding);

  const bytes = new Uint8Array(binary.length);

  for (let i = 0; i < binary.length; i++) {
    bytes[i] = binary.charCodeAt(i);
  }

  return bytes;
}

function encodeString(value) {
  return base64urlEncode(
    encoder.encode(value)
  );
}

function decodeString(value) {
  return decoder.decode(
    base64urlDecode(value)
  );
}


/* ============================================================
   RANDOM VALUES
============================================================ */

function randomBytes(length = 32) {
  const bytes = new Uint8Array(length);

  crypto.getRandomValues(bytes);

  return bytes;
}

function randomBase64url(length = 32) {
  return base64urlEncode(
    randomBytes(length)
  );
}


/* ============================================================
   HASHING
============================================================ */

async function sha256(value) {
  const data =
    typeof value === "string"
      ? encoder.encode(value)
      : value;

  const digest =
    await crypto.subtle.digest(
      "SHA-256",
      data
    );

  return base64urlEncode(
    new Uint8Array(digest)
  );
}


/* ============================================================
   PBKDF2
============================================================ */

async function derivePasswordHash(
  password,
  saltBytes,
  iterations = PASSWORD_ITERATIONS
) {
  const baseKey =
    await crypto.subtle.importKey(
      "raw",
      encoder.encode(password),
      "PBKDF2",
      false,
      ["deriveBits"]
    );

  const bits =
    await crypto.subtle.deriveBits(
      {
        name: "PBKDF2",
        salt: saltBytes,
        iterations,
        hash: "SHA-256",
      },
      baseKey,
      256
    );

  return base64urlEncode(
    new Uint8Array(bits)
  );
}

async function hashPassword(password) {
  const salt = randomBytes(16);

  const derived =
    await derivePasswordHash(
      password,
      salt
    );

  return `pbkdf2_sha256$${PASSWORD_ITERATIONS}$${base64urlEncode(
    salt
  )}$${derived}`;
}

async function verifyPassword(
  password,
  storedHash
) {
  const parts = storedHash.split("$");

  if (
    parts.length !== 4 ||
    parts[0] !== "pbkdf2_sha256"
  ) {
    return false;
  }

  const iterations = Number(parts[1]);

  if (!Number.isInteger(iterations)) {
    return false;
  }

  const salt =
    base64urlDecode(parts[2]);

  const expected = parts[3];

  const actual =
    await derivePasswordHash(
      password,
      salt,
      iterations
    );

  return constantTimeEqual(
    actual,
    expected
  );
}


/* ============================================================
   CONSTANT-TIME STRING COMPARISON
============================================================ */

function constantTimeEqual(a, b) {
  if (
    typeof a !== "string" ||
    typeof b !== "string"
  ) {
    return false;
  }

  const aBytes = encoder.encode(a);
  const bBytes = encoder.encode(b);

  if (aBytes.length !== bBytes.length) {
    return false;
  }

  let result = 0;

  for (let i = 0; i < aBytes.length; i++) {
    result |= aBytes[i] ^ bBytes[i];
  }

  return result === 0;
}


/* ============================================================
   JWT
============================================================ */

async function importHmacKey(secret) {
  if (!secret) {
    throw new Error(
      "JWT secret is not configured"
    );
  }

  return await crypto.subtle.importKey(
    "raw",
    encoder.encode(secret),
    {
      name: "HMAC",
      hash: "SHA-256",
    },
    false,
    ["sign", "verify"]
  );
}

async function signJWT(
  payload,
  secret
) {
  const header = {
    alg: "HS256",
    typ: "JWT",
  };

  const encodedHeader =
    encodeString(
      JSON.stringify(header)
    );

  const encodedPayload =
    encodeString(
      JSON.stringify(payload)
    );

  const signingInput =
    `${encodedHeader}.${encodedPayload}`;

  const key =
    await importHmacKey(secret);

  const signature =
    await crypto.subtle.sign(
      "HMAC",
      key,
      encoder.encode(signingInput)
    );

  return `${signingInput}.${base64urlEncode(
    new Uint8Array(signature)
  )}`;
}

async function verifyJWT(
  token,
  secret
) {
  const parts = token.split(".");

  if (parts.length !== 3) {
    return null;
  }

  const [
    encodedHeader,
    encodedPayload,
    encodedSignature,
  ] = parts;

  let header;
  let payload;

  try {
    header = JSON.parse(
      decodeString(encodedHeader)
    );

    payload = JSON.parse(
      decodeString(encodedPayload)
    );
  } catch {
    return null;
  }

  if (
    header.alg !== "HS256" ||
    header.typ !== "JWT"
  ) {
    return null;
  }

  const key =
    await importHmacKey(secret);

  const valid =
    await crypto.subtle.verify(
      "HMAC",
      key,
      base64urlDecode(
        encodedSignature
      ),
      encoder.encode(
        `${encodedHeader}.${encodedPayload}`
      )
    );

  if (!valid) {
    return null;
  }

  const currentTime =
    Math.floor(Date.now() / 1000);

  if (
    typeof payload.exp !== "number" ||
    payload.exp <= currentTime
  ) {
    return null;
  }

  return payload;
}


/* ============================================================
   JWT CREATION
============================================================ */

async function createAccessToken({
  subject,
  type,
  secret,
  ttl,
  scopes = [],
}) {
  const issuedAt =
    Math.floor(Date.now() / 1000);

  const expiresAt =
    issuedAt + ttl;

  const jti =
    crypto.randomUUID();

  const token =
    await signJWT(
      {
        iss: "audiory-api",
        sub: subject,
        typ: type,
        iat: issuedAt,
        exp: expiresAt,
        jti,
        ...(scopes.length
          ? { scope: scopes.join(" ") }
          : {}),
      },
      secret
    );

  return {
    token,
    jti,
    issuedAt,
    expiresAt,
  };
}


/* ============================================================
   AUTHORIZATION HEADER
============================================================ */

function getBearerToken(request) {
  const header =
    request.headers.get(
      "Authorization"
    );

  if (!header) {
    return null;
  }

  const match =
    header.match(
      /^Bearer\s+(.+)$/i
    );

  return match ? match[1] : null;
}


/* ============================================================
   USER AUTHENTICATION
============================================================ */

async function authenticateUser(
  request,
  env
) {
  const token =
    getBearerToken(request);

  if (!token) {
    return null;
  }

  const payload =
    await verifyJWT(
      token,
      env.USER_JWT_SECRET
    );

  if (!payload) {
    return null;
  }

  if (payload.typ !== "user") {
    return null;
  }

  const tokenHash =
    await sha256(token);

  const session =
    await env.DB
      .prepare(`
        SELECT
          id,
          user_id,
          expires_at,
          revoked_at
        FROM user_sessions
        WHERE token_hash = ?
        LIMIT 1
      `)
      .bind(tokenHash)
      .first();

  if (!session) {
    return null;
  }

  if (session.revoked_at) {
    return null;
  }

  if (
    new Date(session.expires_at)
      .getTime() <= Date.now()
  ) {
    return null;
  }

  const user =
    await env.DB
      .prepare(`
        SELECT
          id,
          email,
          username,
          display_name,
          avatar_asset_id,
          bio,
          role,
          status,
          email_verified_at,
          created_at
        FROM users
        WHERE id = ?
        LIMIT 1
      `)
      .bind(session.user_id)
      .first();

  if (!user) {
    return null;
  }

  if (user.status !== "active") {
    return null;
  }

  return {
    user,
    session,
    token,
    payload,
  };
}


/* ============================================================
   DEVELOPER AUTHENTICATION
============================================================ */

async function authenticateDeveloper(
  request,
  env
) {
  const token =
    getBearerToken(request);

  if (!token) {
    return null;
  }

  const payload =
    await verifyJWT(
      token,
      env.DEVELOPER_JWT_SECRET
    );

  if (!payload) {
    return null;
  }

  if (payload.typ !== "developer") {
    return null;
  }

  const tokenHash =
    await sha256(token);

  const tokenRecord =
    await env.DB
      .prepare(`
        SELECT
          id,
          app_id,
          scopes,
          expires_at,
          revoked_at
        FROM developer_tokens
        WHERE token_hash = ?
        LIMIT 1
      `)
      .bind(tokenHash)
      .first();

  if (!tokenRecord) {
    return null;
  }

  if (tokenRecord.revoked_at) {
    return null;
  }

  if (
    new Date(tokenRecord.expires_at)
      .getTime() <= Date.now()
  ) {
    return null;
  }

  const app =
    await env.DB
      .prepare(`
        SELECT
          id,
          owner_user_id,
          distributor_id,
          name,
          client_id,
          status
        FROM developer_apps
        WHERE id = ?
        LIMIT 1
      `)
      .bind(tokenRecord.app_id)
      .first();

  if (!app || app.status !== "active") {
    return null;
  }

  let scopes = [];

  try {
    scopes =
      JSON.parse(
        tokenRecord.scopes
      );
  } catch {
    scopes = [];
  }

  return {
    app,
    tokenRecord,
    token,
    payload,
    scopes,
  };
}


/* ============================================================
   SCOPE CHECK
============================================================ */

function hasScope(auth, requiredScope) {
  if (!auth) {
    return false;
  }

  if (
    auth.scopes.includes("*") ||
    auth.scopes.includes(requiredScope)
  ) {
    return true;
  }

  return false;
}


/* ============================================================
   AUDIT LOG
============================================================ */

async function audit(
  env,
  {
    actorUserId = null,
    developerAppId = null,
    action,
    resourceType = null,
    resourceId = null,
    request,
    metadata = null,
  }
) {
  try {
    await env.DB
      .prepare(`
        INSERT INTO audit_logs (
          id,
          actor_user_id,
          developer_app_id,
          action,
          resource_type,
          resource_id,
          ip_address,
          user_agent,
          metadata_json,
          created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `)
      .bind(
        createId("aud"),
        actorUserId,
        developerAppId,
        action,
        resourceType,
        resourceId,
        request.headers.get(
          "CF-Connecting-IP"
        ),
        request.headers.get(
          "User-Agent"
        ),
        metadata
          ? JSON.stringify(metadata)
          : null,
        nowISO()
      )
      .run();
  } catch (error) {
    console.error(
      "Audit logging failed:",
      error
    );
  }
}


/* ============================================================
   USER REGISTER
============================================================ */

async function registerUser(
  request,
  env,
  requestId
) {
  let body;

  try {
    body = await readJSON(request);
  } catch {
    return fail(
      "INVALID_JSON",
      "Request body must be valid JSON.",
      400,
      requestId
    );
  }

  const email =
    normalizeEmail(body.email);

  const username =
    normalizeUsername(body.username);

  const password =
    body.password;

  const displayName =
    body.display_name
      ? String(body.display_name).trim()
      : null;

  if (!validEmail(email)) {
    return fail(
      "INVALID_EMAIL",
      "A valid email address is required.",
      422,
      requestId
    );
  }

  if (!validUsername(username)) {
    return fail(
      "INVALID_USERNAME",
      "Username must contain 3-30 lowercase letters, numbers, or underscores.",
      422,
      requestId
    );
  }

  if (!validPassword(password)) {
    return fail(
      "INVALID_PASSWORD",
      "Password must be between 10 and 128 characters.",
      422,
      requestId
    );
  }

  const existing =
    await env.DB
      .prepare(`
        SELECT id
        FROM users
        WHERE email = ?
           OR username = ?
        LIMIT 1
      `)
      .bind(email, username)
      .first();

  if (existing) {
    return fail(
      "ACCOUNT_EXISTS",
      "An account with that email or username already exists.",
      409,
      requestId
    );
  }

  const passwordHash =
    await hashPassword(password);

  const userId =
    createId("usr");

  const createdAt =
    nowISO();

  await env.DB
    .prepare(`
      INSERT INTO users (
        id,
        email,
        username,
        password_hash,
        display_name,
        role,
        status,
        created_at,
        updated_at
      )
      VALUES (?, ?, ?, ?, ?, 'listener', 'active', ?, ?)
    `)
    .bind(
      userId,
      email,
      username,
      passwordHash,
      displayName,
      createdAt,
      createdAt
    )
    .run();

  await audit(env, {
    actorUserId: userId,
    action: "user.created",
    resourceType: "user",
    resourceId: userId,
    request,
  });

  return success(
    {
      id: userId,
      email,
      username,
      display_name: displayName,
      role: "listener",
      status: "active",
      created_at: createdAt,
    },
    requestId
  );
}


/* ============================================================
   USER LOGIN
============================================================ */

async function loginUser(
  request,
  env,
  requestId
) {
  let body;

  try {
    body = await readJSON(request);
  } catch {
    return fail(
      "INVALID_JSON",
      "Request body must be valid JSON.",
      400,
      requestId
    );
  }

  const identifier =
    String(
      body.email ||
      body.username ||
      ""
    )
      .trim()
      .toLowerCase();

  const password =
    body.password;

  if (!identifier || !password) {
    return fail(
      "MISSING_CREDENTIALS",
      "Email or username and password are required.",
      422,
      requestId
    );
  }

  const user =
    await env.DB
      .prepare(`
        SELECT
          id,
          email,
          username,
          password_hash,
          display_name,
          avatar_asset_id,
          bio,
          role,
          status,
          email_verified_at,
          created_at
        FROM users
        WHERE email = ?
           OR username = ?
        LIMIT 1
      `)
      .bind(identifier, identifier)
      .first();

  if (!user) {
    return fail(
      "INVALID_CREDENTIALS",
      "Invalid email/username or password.",
      401,
      requestId
    );
  }

  if (user.status !== "active") {
    return fail(
      "ACCOUNT_UNAVAILABLE",
      "This account is not available.",
      403,
      requestId
    );
  }

  const passwordValid =
    await verifyPassword(
      password,
      user.password_hash
    );

  if (!passwordValid) {
    return fail(
      "INVALID_CREDENTIALS",
      "Invalid email/username or password.",
      401,
      requestId
    );
  }

  const {
    token,
    jti,
    expiresAt,
  } =
    await createAccessToken({
      subject: user.id,
      type: "user",
      secret: env.USER_JWT_SECRET,
      ttl: USER_TOKEN_TTL,
    });

  const tokenHash =
    await sha256(token);

  const expiresISO =
    new Date(
      expiresAt * 1000
    ).toISOString();

  await env.DB
    .prepare(`
      INSERT INTO user_sessions (
        id,
        user_id,
        token_hash,
        expires_at,
        ip_address,
        user_agent,
        created_at,
        last_used_at
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `)
    .bind(
      createId("ses"),
      user.id,
      tokenHash,
      expiresISO,
      request.headers.get(
        "CF-Connecting-IP"
      ),
      request.headers.get(
        "User-Agent"
      ),
      nowISO(),
      nowISO()
    )
    .run();

  await audit(env, {
    actorUserId: user.id,
    action: "user.login",
    resourceType: "user",
    resourceId: user.id,
    request,
  });

  return success(
    {
      access_token: token,
      token_type: "Bearer",
      expires_in: USER_TOKEN_TTL,
      expires_at: expiresISO,
      user: {
        id: user.id,
        email: user.email,
        username: user.username,
        display_name: user.display_name,
        avatar_asset_id:
          user.avatar_asset_id,
        bio: user.bio,
        role: user.role,
        status: user.status,
        email_verified_at:
          user.email_verified_at,
        created_at: user.created_at,
      },
    },
    requestId
  );
}


/* ============================================================
   USER LOGOUT
============================================================ */

async function logoutUser(
  request,
  env,
  requestId
) {
  const auth =
    await authenticateUser(
      request,
      env
    );

  if (!auth) {
    return fail(
      "UNAUTHORIZED",
      "A valid user access token is required.",
      401,
      requestId
    );
  }

  await env.DB
    .prepare(`
      UPDATE user_sessions
      SET revoked_at = ?
      WHERE id = ?
    `)
    .bind(
      nowISO(),
      auth.session.id
    )
    .run();

  await audit(env, {
    actorUserId: auth.user.id,
    action: "user.logout",
    resourceType: "user",
    resourceId: auth.user.id,
    request,
  });

  return success(
    {
      logged_out: true,
    },
    requestId
  );
}


/* ============================================================
   CURRENT USER
============================================================ */

async function currentUser(
  request,
  env,
  requestId
) {
  const auth =
    await authenticateUser(
      request,
      env
    );

  if (!auth) {
    return fail(
      "UNAUTHORIZED",
      "A valid user access token is required.",
      401,
      requestId
    );
  }

  return success(
    {
      user: auth.user,
    },
    requestId
  );
}


/* ============================================================
   CREATE DEVELOPER APPLICATION
============================================================ */

async function createDeveloperApp(
  request,
  env,
  requestId
) {
  const auth =
    await authenticateUser(
      request,
      env
    );

  if (!auth) {
    return fail(
      "UNAUTHORIZED",
      "A valid user access token is required.",
      401,
      requestId
    );
  }

  /*
   * Developer applications are currently restricted
   * to distributor and admin accounts.
   */
  if (
    auth.user.role !== "distributor" &&
    auth.user.role !== "admin"
  ) {
    return fail(
      "FORBIDDEN",
      "Only distributor or admin accounts can create developer applications.",
      403,
      requestId
    );
  }

  let body;

  try {
    body = await readJSON(request);
  } catch {
    return fail(
      "INVALID_JSON",
      "Request body must be valid JSON.",
      400,
      requestId
    );
  }

  const name =
    String(body.name || "").trim();

  const description =
    body.description
      ? String(body.description).trim()
      : null;

  if (
    name.length < 2 ||
    name.length > 100
  ) {
    return fail(
      "INVALID_APP_NAME",
      "Application name must be between 2 and 100 characters.",
      422,
      requestId
    );
  }

  const appId =
    createId("app");

  const clientId =
    `aud_live_${randomBase64url(24)}`;

  /*
   * The secret is returned ONCE.
   * Only its PBKDF2 hash is stored in D1.
   */
  const clientSecret =
    `aud_secret_${randomBase64url(32)}`;

  const secretHash =
    await hashPassword(
      clientSecret
    );

  const createdAt =
    nowISO();

  await env.DB
    .prepare(`
      INSERT INTO developer_apps (
        id,
        owner_user_id,
        name,
        description,
        client_id,
        client_secret_hash,
        status,
        created_at,
        updated_at
      )
      VALUES (?, ?, ?, ?, ?, ?, 'active', ?, ?)
    `)
    .bind(
      appId,
      auth.user.id,
      name,
      description,
      clientId,
      secretHash,
      createdAt,
      createdAt
    )
    .run();

  /*
   * Default read scopes.
   *
   * We deliberately do NOT grant write/admin access
   * automatically.
   */
  const defaultScopes = [
    "catalog:read",
    "artists:read",
    "releases:read",
    "tracks:read",
    "playlists:read",
    "search:read",
    "discovery:read",
  ];

  for (const scope of defaultScopes) {
    await env.DB
      .prepare(`
        INSERT INTO developer_app_scopes (
          app_id,
          scope
        )
        VALUES (?, ?)
      `)
      .bind(
        appId,
        scope
      )
      .run();
  }

  await audit(env, {
    actorUserId: auth.user.id,
    action: "developer.app.created",
    resourceType: "developer_app",
    resourceId: appId,
    request,
  });

  return success(
    {
      application: {
        id: appId,
        name,
        description,
        client_id: clientId,
        status: "active",
        scopes: defaultScopes,
        created_at: createdAt,
      },

      /*
       * SECURITY:
       * This value is returned only during creation.
       */
      client_secret: clientSecret,

      warning:
        "Store the client_secret securely. It cannot be retrieved again after this response.",
    },
    requestId
  );
}


/* ============================================================
   DEVELOPER TOKEN
============================================================ */

async function developerToken(
  request,
  env,
  requestId
) {
  let body;

  try {
    body = await readJSON(request);
  } catch {
    return fail(
      "INVALID_JSON",
      "Request body must be valid JSON.",
      400,
      requestId
    );
  }

  if (
    body.grant_type !==
    "client_credentials"
  ) {
    return fail(
      "UNSUPPORTED_GRANT_TYPE",
      "Only client_credentials is currently supported.",
      400,
      requestId
    );
  }

  const clientId =
    String(
      body.client_id || ""
    ).trim();

  const clientSecret =
    String(
      body.client_secret || ""
    );

  if (
    !clientId ||
    !clientSecret
  ) {
    return fail(
      "MISSING_CLIENT_CREDENTIALS",
      "client_id and client_secret are required.",
      422,
      requestId
    );
  }

  const app =
    await env.DB
      .prepare(`
        SELECT
          id,
          owner_user_id,
          distributor_id,
          name,
          client_id,
          client_secret_hash,
          status
        FROM developer_apps
        WHERE client_id = ?
        LIMIT 1
      `)
      .bind(clientId)
      .first();

  if (!app) {
    return fail(
      "INVALID_CLIENT_CREDENTIALS",
      "Invalid client credentials.",
      401,
      requestId
    );
  }

  if (app.status !== "active") {
    return fail(
      "APPLICATION_UNAVAILABLE",
      "This developer application is not active.",
      403,
      requestId
    );
  }

  const secretValid =
    await verifyPassword(
      clientSecret,
      app.client_secret_hash
    );

  if (!secretValid) {
    return fail(
      "INVALID_CLIENT_CREDENTIALS",
      "Invalid client credentials.",
      401,
      requestId
    );
  }

  const scopeRows =
    await env.DB
      .prepare(`
        SELECT scope
        FROM developer_app_scopes
        WHERE app_id = ?
        ORDER BY scope
      `)
      .bind(app.id)
      .all();

  const scopes =
    scopeRows.results.map(
      row => row.scope
    );

  const {
    token,
    expiresAt,
  } =
    await createAccessToken({
      subject: app.id,
      type: "developer",
      secret:
        env.DEVELOPER_JWT_SECRET,
      ttl: DEVELOPER_TOKEN_TTL,
      scopes,
    });

  const tokenHash =
    await sha256(token);

  const expiresISO =
    new Date(
      expiresAt * 1000
    ).toISOString();

  await env.DB
    .prepare(`
      INSERT INTO developer_tokens (
        id,
        app_id,
        token_hash,
        scopes,
        expires_at,
        created_at
      )
      VALUES (?, ?, ?, ?, ?, ?)
    `)
    .bind(
      createId("dvt"),
      app.id,
      tokenHash,
      JSON.stringify(scopes),
      expiresISO,
      nowISO()
    )
    .run();

  await env.DB
    .prepare(`
      UPDATE developer_apps
      SET last_used_at = ?,
          updated_at = ?
      WHERE id = ?
    `)
    .bind(
      nowISO(),
      nowISO(),
      app.id
    )
    .run();

  await audit(env, {
    developerAppId: app.id,
    action: "developer.token.created",
    resourceType: "developer_app",
    resourceId: app.id,
    request,
  });

  return success(
    {
      access_token: token,
      token_type: "Bearer",
      expires_in:
        DEVELOPER_TOKEN_TTL,
      expires_at: expiresISO,
      scope: scopes.join(" "),
    },
    requestId
  );
}


/* ============================================================
   DEVELOPER SECRET ROTATION
============================================================ */

async function rotateDeveloperSecret(
  request,
  env,
  requestId
) {
  const auth =
    await authenticateDeveloper(
      request,
      env
    );

  if (!auth) {
    return fail(
      "UNAUTHORIZED",
      "A valid developer access token is required.",
      401,
      requestId
    );
  }

  if (
    !hasScope(
      auth,
      "developer:write"
    )
  ) {
    return fail(
      "INSUFFICIENT_SCOPE",
      "The developer token does not have developer:write scope.",
      403,
      requestId
    );
  }

  const newSecret =
    `aud_secret_${randomBase64url(32)}`;

  const newHash =
    await hashPassword(
      newSecret
    );

  await env.DB
    .prepare(`
      UPDATE developer_apps
      SET client_secret_hash = ?,
          updated_at = ?
      WHERE id = ?
    `)
    .bind(
      newHash,
      nowISO(),
      auth.app.id
    )
    .run();

  /*
   * Revoke all existing developer tokens
   * after secret rotation.
   */
  await env.DB
    .prepare(`
      UPDATE developer_tokens
      SET revoked_at = ?
      WHERE app_id = ?
        AND revoked_at IS NULL
    `)
    .bind(
      nowISO(),
      auth.app.id
    )
    .run();

  await audit(env, {
    developerAppId: auth.app.id,
    action: "developer.secret.rotated",
    resourceType: "developer_app",
    resourceId: auth.app.id,
    request,
  });

  return success(
    {
      client_id:
        auth.app.client_id,

      client_secret:
        newSecret,

      warning:
        "Store the new client_secret securely. The previous secret is permanently invalidated.",
    },
    requestId
  );
}


/* ============================================================
   DEVELOPER REVOKE
============================================================ */

async function revokeDeveloperApp(
  request,
  env,
  requestId
) {
  const auth =
    await authenticateDeveloper(
      request,
      env
    );

  if (!auth) {
    return fail(
      "UNAUTHORIZED",
      "A valid developer access token is required.",
      401,
      requestId
    );
  }

  if (
    !hasScope(
      auth,
      "developer:write"
    )
  ) {
    return fail(
      "INSUFFICIENT_SCOPE",
      "The developer token does not have developer:write scope.",
      403,
      requestId
    );
  }

  await env.DB
    .prepare(`
      UPDATE developer_apps
      SET status = 'revoked',
          updated_at = ?
      WHERE id = ?
    `)
    .bind(
      nowISO(),
      auth.app.id
    )
    .run();

  await env.DB
    .prepare(`
      UPDATE developer_tokens
      SET revoked_at = ?
      WHERE app_id = ?
        AND revoked_at IS NULL
    `)
    .bind(
      nowISO(),
      auth.app.id
    )
    .run();

  await audit(env, {
    developerAppId: auth.app.id,
    action: "developer.app.revoked",
    resourceType: "developer_app",
    resourceId: auth.app.id,
    request,
  });

  return success(
    {
      revoked: true,
      application_id:
        auth.app.id,
    },
    requestId
  );
}


/* ============================================================
   ROUTER
============================================================ */

export default {
  async fetch(request, env) {
    const requestId =
      createRequestId();

    const url =
      new URL(request.url);

    const pathname =
      url.pathname;

    const method =
      request.method.toUpperCase();

    const cors =
      corsHeaders(
        request.headers.get("Origin")
      );

    if (method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: cors,
      });
    }

    try {
      /*
       * Health
       */
      if (
        pathname === "/v1/health" &&
        method === "GET"
      ) {
        return success(
          {
            service: "audiory-api",
            status: "operational",
            version: API_VERSION,
            timestamp: nowISO(),
          },
          requestId
        );
      }


      /*
       * API information
       */
      if (
        pathname === "/v1" &&
        method === "GET"
      ) {
        return success(
          {
            name: "Audiory Music API",
            version: API_VERSION,
            status: "operational",
          },
          requestId
        );
      }


      /*
       * USER REGISTER
       */
      if (
        pathname ===
          "/v1/auth/user/register" &&
        method === "POST"
      ) {
        return registerUser(
          request,
          env,
          requestId
        );
      }


      /*
       * USER LOGIN
       */
      if (
        pathname ===
          "/v1/auth/user/login" &&
        method === "POST"
      ) {
        return loginUser(
          request,
          env,
          requestId
        );
      }


      /*
       * USER LOGOUT
       */
      if (
        pathname ===
          "/v1/auth/user/logout" &&
        method === "POST"
      ) {
        return logoutUser(
          request,
          env,
          requestId
        );
      }


      /*
       * CURRENT USER
       */
      if (
        pathname ===
          "/v1/auth/me" &&
        method === "GET"
      ) {
        return currentUser(
          request,
          env,
          requestId
        );
      }


      /*
       * CREATE DEVELOPER APP
       */
      if (
        pathname ===
          "/v1/auth/developer/keys" &&
        method === "POST"
      ) {
        return createDeveloperApp(
          request,
          env,
          requestId
        );
      }


      /*
       * DEVELOPER TOKEN
       */
      if (
        pathname ===
          "/v1/auth/token" &&
        method === "POST"
      ) {
        return developerToken(
          request,
          env,
          requestId
        );
      }


      /*
       * ROTATE DEVELOPER SECRET
       */
      if (
        pathname ===
          "/v1/auth/developer/rotate-secret" &&
        method === "POST"
      ) {
        return rotateDeveloperSecret(
          request,
          env,
          requestId
        );
      }


      /*
       * REVOKE DEVELOPER APP
       */
      if (
        pathname ===
          "/v1/auth/developer/revoke" &&
        method === "POST"
      ) {
        return revokeDeveloperApp(
          request,
          env,
          requestId
        );
      }


      /*
       * 404 Not found
       */
      return fail(
        "NOT_FOUND",
        "The requested Audiory API endpoint does not exist.",
        404,
        requestId
      );

    } catch (error) {
      console.error(
        "Audiory API error:",
        error
      );

      return fail(
        "INTERNAL_SERVER_ERROR",
        "An unexpected server error occurred.",
        500,
        requestId
      );
    }
  },
};

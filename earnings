function getWorkerBaseUrl() {
    return (window.WORKER_BASE_URL || 'https://audiorydistribution.dandredurkofficial.workers.dev').replace(/\/$/, "");
}

// 1. Submit Withdrawal Request
async function submitWithdrawal(e) {
    e.preventDefault();

    const token = await getAuthToken();
    if (!token) {
        if (typeof showToast === 'function') showToast("Authentication token missing.", true);
        return;
    }

    const amount = parseFloat(document.getElementById('withdrawAmount').value);
    const userBal = window.currentBalance || 0;

    if (amount > userBal) {
        if (typeof showToast === 'function') showToast("Requested amount exceeds current available balance.", true);
        return;
    }

    const method = document.getElementById('payoutMethod').value;
    let detailString = '';
    if (method === 'mpesa') {
        detailString = `Phone: ${document.getElementById('field_mpesa_phone').value} (${document.getElementById('field_mpesa_name').value})`;
    } else if (method === 'bank') {
        detailString = `${document.getElementById('field_bank_name').value} - ${document.getElementById('field_bank_acc').value}`;
    } else if (method === 'payoneer') {
        detailString = `Email: ${document.getElementById('field_payoneer_email').value}`;
    } else if (method === 'tipalti') {
        detailString = `ID: ${document.getElementById('field_tipalti_id').value}`;
    }

    try {
        const response = await fetch(`${getWorkerBaseUrl()}/api/withdrawals`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                amount: amount,
                method: method,
                details: detailString
            })
        });

        const resData = await response.json();

        if (!response.ok) {
            throw new Error(resData.error || 'Failed to process request.');
        }

        closeWithdrawModal();
        await initEarningsDashboard();
        if (typeof showToast === 'function') showToast("Withdrawal request submitted successfully!", false);

    } catch (err) {
        if (typeof showToast === 'function') showToast(err.message, true);
    }
}

// 2. Fetch User Withdrawals
async function fetchUserWithdrawals() {
    try {
        const token = await getAuthToken();
        if (!token) return [];

        const response = await fetch(`${getWorkerBaseUrl()}/api/withdrawals`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!response.ok) return [];
        return await response.json();
    } catch {
        return [];
    }
}

// 3. Fetch Live Too Lost Sales Data Endpoint
async function fetchTooLostSalesData() {
    try {
        const token = await getAuthToken();
        if (!token) return { overview: null, platformBreakdown: [] };

        const [overviewRes, channelsRes] = await Promise.all([
            fetch(`${getWorkerBaseUrl()}/api/toolost/sales/overview`, {
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
            }),
            fetch(`${getWorkerBaseUrl()}/api/toolost/sales/channels`, {
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
            })
        ]);

        const overview = overviewRes.ok ? await overviewRes.json() : null;
        const rawChannels = channelsRes.ok ? await channelsRes.json() : [];

        // Normalize array structure
        const platformBreakdown = Array.isArray(rawChannels) 
            ? rawChannels 
            : (rawChannels.data || rawChannels.channels || []);

        return { overview, platformBreakdown };
    } catch (err) {
        console.error("Error fetching Too Lost sales data:", err);
        return { overview: null, platformBreakdown: [] };
    }
}

// Main Dashboard Initializer
async function initEarningsDashboard() {
    // -------------------------------------------------------------
    // 1. Fetch User Withdrawal History & Calculate Totals
    // -------------------------------------------------------------
    const requests = await fetchUserWithdrawals();
    const tbody = document.getElementById('earnings-withdrawals-tbody');
    
    let pendingSum = 0;
    let paidSum = 0;

    if (Array.isArray(requests) && requests.length > 0) {
        requests.forEach(r => {
            const amt = Number(r.amount) || 0;
            const status = (r.status || '').toLowerCase();
            if (status === 'paid') {
                paidSum += amt;
            } else if (status === 'pending') {
                pendingSum += amt;
            }
        });

        if (tbody) {
            tbody.innerHTML = requests.map(r => {
                const isPaid = (r.status || '').toLowerCase() === 'paid';
                const statusBadge = isPaid
                    ? `<span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Paid</span>`
                    : `<span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/20">Pending</span>`;

                return `
                    <tr class="border-b border-brand-border/50 hover:bg-white/5 transition-colors">
                        <td class="py-3 px-2 font-mono">${new Date(r.date).toLocaleDateString()}</td>
                        <td class="py-3 px-2 font-semibold text-white">${r.method}</td>
                        <td class="py-3 px-2 text-gray-400 truncate max-w-xs">${r.details}</td>
                        <td class="py-3 px-2 text-right font-mono font-bold text-white">$${Number(r.amount).toFixed(2)}</td>
                        <td class="py-3 px-2 text-right">${statusBadge}</td>
                    </tr>
                `;
            }).join('');
        }
    } else if (tbody) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-gray-500">No withdrawal records found.</td></tr>`;
    }

    // Update Pending Payouts & Lifetime Paid KPI elements directly
    const pendingEl = document.getElementById('earnings-pending-amount');
    const paidEl = document.getElementById('earnings-lifetime-paid');
    if (pendingEl) pendingEl.innerText = `$${pendingSum.toFixed(2)}`;
    if (paidEl) paidEl.innerText = `$${paidSum.toFixed(2)}`;

    // -------------------------------------------------------------
    // 2. Fetch Live Too Lost Sales Data
    // -------------------------------------------------------------
    const { overview, platformBreakdown } = await fetchTooLostSalesData();

    // -------------------------------------------------------------
    // 3. Render DSP Breakdown Table
    // -------------------------------------------------------------
    const dspTbody = document.getElementById('earnings-dsp-tbody');
    if (dspTbody) {
        if (!platformBreakdown || platformBreakdown.length === 0) {
            dspTbody.innerHTML = `<tr><td colspan="3" class="py-6 text-center text-gray-500">No store revenue data available.</td></tr>`;
        } else {
            dspTbody.innerHTML = platformBreakdown.map(p => {
                const name = p.name || p.dsp || p.channel || 'Store';
                const streams = Number(p.streams || p.quantity || p.count || 0);
                const revenue = Number(p.total || p.revenue || p.amount || 0);

                return `
                    <tr class="border-b border-brand-border/50 hover:bg-white/5">
                        <td class="py-3 px-2 font-semibold text-white">${name}</td>
                        <td class="py-3 px-2 text-right font-mono text-gray-300">${streams.toLocaleString()}</td>
                        <td class="py-3 px-2 text-right font-mono font-bold text-emerald-400">$${revenue.toFixed(2)}</td>
                    </tr>
                `;
            }).join('');
        }
    }

    // -------------------------------------------------------------
    // 4. Compute Available Total Balance
    // -------------------------------------------------------------
    const grossRevenue = overview?.totalBalance ?? overview?.total_earnings ?? overview?.total ?? 
        platformBreakdown.reduce((acc, curr) => acc + Number(curr.total || curr.revenue || curr.amount || 0), 0);

    // Available Balance = Gross Revenue minus Pending & Paid withdrawals
    const availableBalance = Math.max(0, Number(grossRevenue) - (pendingSum + paidSum));
    window.currentBalance = availableBalance;

    const totalBalEl = document.getElementById('earnings-total-balance');
    if (totalBalEl) totalBalEl.innerText = `$${window.currentBalance.toFixed(2)}`;

    // -------------------------------------------------------------
    // 5. Render Platform Revenue Chart
    // -------------------------------------------------------------
    const canvas = document.getElementById('platformEarningsPieChart');
    const chartContainer = canvas ? canvas.parentElement : null;

    if (canvas) {
        const hasData = platformBreakdown.length > 0 && platformBreakdown.some(p => Number(p.total || p.revenue || p.amount || 0) > 0);

        if (hasData) {
            const existingMsg = chartContainer?.querySelector('.empty-chart-msg');
            if (existingMsg) existingMsg.remove();

            canvas.style.display = 'block';
            if (pieChartInstance) pieChartInstance.destroy();

            const ctx = canvas.getContext('2d');
            pieChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: platformBreakdown.map(p => p.name || p.dsp || p.channel),
                    datasets: [{
                        data: platformBreakdown.map(p => Number(p.total || p.revenue || p.amount || 0)),
                        backgroundColor: ['#1db954', '#fc3c44', '#ff0000', '#00a8e1', '#a238ff', '#6b7280', '#e1306c', '#0084ff'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: '#9ca3af', font: { size: 10 } } }
                    }
                }
            });
        } else {
            canvas.style.display = 'none';
            if (chartContainer && !chartContainer.querySelector('.empty-chart-msg')) {
                const emptyMsg = document.createElement('div');
                emptyMsg.className = 'empty-chart-msg h-full w-full flex items-center justify-center text-gray-500 text-xs font-medium py-12';
                emptyMsg.innerText = 'No store revenue data available.';
                chartContainer.appendChild(emptyMsg);
            }
        }
    }
}


let pieChartInstance = null;

// Helper: Safely retrieve active Firebase Token or stored token
async function getAuthToken() {
    const activeUser = window.currentUser || (window.auth && window.auth.currentUser);
    if (activeUser && typeof activeUser.getIdToken === 'function') {
        try {
            return await activeUser.getIdToken();
        } catch (err) {
            console.warn("Failed to get fresh Firebase token:", err);
        }
    }
    return localStorage.getItem('auth_token') || '';
}

// Modal Handlers
function handleWithdrawClick() {
    const modal = document.getElementById('withdrawModal');
    const balInput = document.getElementById('modal-available-balance');
    const userBal = window.currentBalance || 0;

    if (balInput) balInput.value = `$${userBal.toFixed(2)}`;
    renderPayoutFields();
    if (modal) modal.classList.remove('hidden');
}

function closeWithdrawModal() {
    const modal = document.getElementById('withdrawModal');
    if (modal) modal.classList.add('hidden');
}


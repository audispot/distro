// Catalog Actions - Edit Release
window.editReleaseCatalog = function(index) {
    const item = window.releasesCatalog[index];
    if (!item) return;

    // 1. Extract Artists/Participants reliably
    let extractedArtists = [];
    if (Array.isArray(item.participants) && item.participants.length > 0) {
        extractedArtists = item.participants.map(p => ({
            name: typeof p === 'string' ? p : (p.name || ''),
            role: Array.isArray(p.role) ? (p.role[0] || 'primary') : (p.role || 'primary')
        }));
    } else if (Array.isArray(item.artists) && item.artists.length > 0) {
        extractedArtists = item.artists.map(a => ({
            name: typeof a === 'string' ? a : (a.name || ''),
            role: Array.isArray(a.role) ? (a.role[0] || 'primary') : (a.role || 'primary')
        }));
    } else if (item.artist) {
        extractedArtists = [{
            name: typeof item.artist === 'string' ? item.artist : (item.artist.name || ''),
            role: 'primary'
        }];
    }

    if (extractedArtists.length === 0) {
        extractedArtists = [{ name: '', role: 'primary' }];
    }

    // 2. Extract Label cleanly
    const labelName = typeof item.label === 'object' 
        ? (item.label.name || item.label.label || '') 
        : (item.label || '');

    // 3. Set standard releaseState with editing tracking
    window.releaseState = {
        editingId: item.id || null, // Track ID to prevent creating duplicates
        metadata: {
            title: item.title || item.metadata?.title || '',
            type: item.type || item.metadata?.type || 'Single',
            language: item.language || item.metadata?.language || 'English',
            explicit: item.explicit || item.metadata?.explicit || false,
            primaryGenre: item.genre || item.primary_genre || item.metadata?.primaryGenre || item.genre_id || '',
            secondaryGenre: item.subgenre || item.secondary_genre || item.metadata?.secondaryGenre || ''
        },
        artists: extractedArtists,
        label: {
            name: labelName,
            cLine: item.cLine || item.c_line || item.label?.cLine || '',
            pLine: item.pLine || item.p_line || item.label?.pLine || ''
        },
        dates: {
            releaseDate: item.releaseDate || item.release_date || '',
            timezone: item.timezone || 'Africa/Nairobi'
        },
        dsps: item.dsps || (typeof MASTER_DSP_LIST !== 'undefined' ? MASTER_DSP_LIST.map(d => d.id) : []),
        artwork: {
            file: null,
            url: item.coverUrl || item.cover_url || item.compressedArtwork || item.cover_art || '',
            inspected: null
        },
        tracks: Array.isArray(item.tracks) && item.tracks.length > 0 
            ? item.tracks.map(t => ({
                metadata: {
                    title: t.title || t.metadata?.title || '',
                    version: t.version || t.metadata?.version || '',
                    genre: t.genre || t.metadata?.genre || '',
                    subgenre: t.subgenre || t.metadata?.subgenre || '',
                    explicit: t.explicit || t.metadata?.explicit || false
                },
                discNumber: t.discNumber || t.disc_number || 1,
                isrc: t.isrc || '',
                audioUrl: t.audio_url || t.audioUrl || '',
                tiktokStartTime: t.tiktok_start_time || t.tiktokStartTime || '00:30',
                lyrics: { plain: t.lyrics?.plain || t.lyrics || '' }
            }))
            : [{
                metadata: { title: item.title || '', explicit: false },
                discNumber: 1,
                isrc: '',
                audioUrl: '',
                tiktokStartTime: '00:30',
                lyrics: { plain: '' }
            }],
        agreements: { termsAccepted: true, rightsConfirmed: true }
    };

    // 4. Switch View & Render Step
    switchView('create');

    if (typeof window.renderStepContent === 'function') {
        window.renderStepContent(1);
    }

    // 5. Explicitly populate form fields from releaseState
    setTimeout(() => {
        populateFormFromState();
    }, 50);

    window.showToast('Release loaded for editing', false);
};

// Helper function to force form inputs to sync with window.releaseState
function populateFormFromState() {
    const state = window.releaseState;
    if (!state) return;

    // Title
    const titleInput = document.querySelector('input[name="title"]') || document.getElementById('release-title');
    if (titleInput) titleInput.value = state.metadata.title;

    // Type
    const typeSelect = document.querySelector('select[name="type"]') || document.getElementById('release-type');
    if (typeSelect) typeSelect.value = state.metadata.type;

    // Primary Genre
    const genreSelect = document.querySelector('select[name="primaryGenre"]') || document.getElementById('primary-genre');
    if (genreSelect && state.metadata.primaryGenre) genreSelect.value = state.metadata.primaryGenre;

    // Label
    const labelInput = document.querySelector('input[name="label"]') || document.getElementById('record-label');
    if (labelInput) labelInput.value = state.label.name;

    // Render / Sync Artist Inputs
    if (typeof window.renderArtistInputs === 'function') {
        window.renderArtistInputs();
    } else {
        const artistContainer = document.getElementById('artists-container') || document.querySelector('.artists-wrapper');
        if (artistContainer && state.artists.length > 0) {
            const firstArtistInput = artistContainer.querySelector('input');
            if (firstArtistInput) firstArtistInput.value = state.artists[0].name;
        }
    }
}

window.deleteReleaseCatalog = async function(releaseId) {
    try {
        const token = window.currentUser?.getIdToken ? await window.currentUser.getIdToken() : '';
        
        const res = await fetch(`${WORKER_BASE_URL}/api/releases/${releaseId}`, { 
            method: 'DELETE',
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });

        if (!res.ok) throw new Error('Failed to delete release on gateway');

        // Remove from memory
        window.releasesCatalog = (window.releasesCatalog || []).filter(r => String(r.id) !== String(releaseId));

        // Remove from Local Storage
        let localSavedReleases = JSON.parse(localStorage.getItem('audiory_local_releases') || '[]');
        localSavedReleases = localSavedReleases.filter(r => String(r.id) !== String(releaseId));
        localStorage.setItem('audiory_local_releases', JSON.stringify(localSavedReleases));

        window.showToast('Release deleted successfully', false);

        if (typeof window.loadLiveCatalog === 'function') {
            await window.loadLiveCatalog();
        } else {
            const container = document.getElementById('mainViewport');
            if (container && typeof renderCatalogView === 'function') {
                container.innerHTML = renderCatalogView();
            }
        }
    } catch (err) {
        console.error('Delete error:', err);

        // Fallback: Remove locally from storage and state if API route fails
        window.releasesCatalog = (window.releasesCatalog || []).filter(r => String(r.id) !== String(releaseId));
        let localSavedReleases = JSON.parse(localStorage.getItem('audiory_local_releases') || '[]');
        localSavedReleases = localSavedReleases.filter(r => String(r.id) !== String(releaseId));
        localStorage.setItem('audiory_local_releases', JSON.stringify(localSavedReleases));

        const container = document.getElementById('mainViewport');
        if (container && typeof renderCatalogView === 'function') {
            container.innerHTML = renderCatalogView();
        }
        window.showToast('Release removed from catalog', false);
    }
};


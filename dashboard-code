        async function loadLiveCatalog() {
    try {
        // Retrieve logged-in user ID strictly
        const currentUid = window.currentUser ? (window.currentUser.uid || window.currentUser.id) : null;
        
        if (!currentUid) {
            window.releasesCatalog = [];
            renderCatalogContainer();
            return;
        }

        let serverReleases = [];

        // 1. Fetch live releases from Worker API
        try {
            const token = await window.currentUser.getIdToken();
            const workerUrl = window.WORKER_BASE_URL || WORKER_BASE_URL;
            const res = await fetch(`${workerUrl}/api/releases`, {
                method: 'GET',
                headers: { 
                    'Accept': 'application/json',
                    'Authorization': `Bearer ${token}`
                }
            });

            if (res.ok) {
                const data = await res.json();
                const rawList = Array.isArray(data) ? data : (data.data || data.releases || []);
                
                // STRICT FILTER: Require item user ID to explicitly match currentUid
                serverReleases = rawList.filter(item => {
                    const itemUserId = item.submittedBy || item.userId || item.user_id || item.uid;
                    return String(itemUserId) === String(currentUid);
                });
            }
        } catch (fetchErr) {
            console.error("API Gateway fetch error:", fetchErr);
        }

        // 2. Fetch User-Scoped LocalStorage items (Isolated per UID)
        const userLocalStorageKey = `audiory_releases_${currentUid}`;
        const allLocalReleases = JSON.parse(localStorage.getItem(userLocalStorageKey) || localStorage.getItem('audiory_local_releases') || '[]');
        
        // STRICT FILTER: Match explicit user ID only
        const localReleases = allLocalReleases.filter(item => {
            const itemUserId = item.submittedBy || item.userId || item.user_id;
            return String(itemUserId) === String(currentUid);
        });

        // Helper to cleanly map cover artwork from Too Lost or custom schemas
        const resolveCoverUrl = (item) => {
            if (!item) return '';
            if (typeof item.artwork === 'string') return item.artwork;
            if (item.artwork && typeof item.artwork === 'object') {
                return item.artwork.url || item.artwork.cover_art || item.artwork.path || '';
            }
            return item.coverUrl 
                || item.compressedArtwork 
                || item.artworkUrl 
                || item.cover_url 
                || item.cover_art 
                || item.image 
                || '';
        };

        // 3. Merge Local + Server
        const releaseMap = new Map();

        // Process Server Releases First
        serverReleases.forEach(item => {
            const key = String(item.id || item.title);
            const serverCover = resolveCoverUrl(item);

            let cleanStatus = item.status || 'Submitted';
            if (cleanStatus.toLowerCase() === 'draft' || cleanStatus.toLowerCase().includes('gateway')) {
                cleanStatus = 'Submitted';
            }

            releaseMap.set(key, {
                ...item,
                submittedBy: currentUid,
                coverUrl: serverCover,
                status: cleanStatus
            });
        });

        // Overlay Local Storage Updates
        localReleases.forEach(item => {
            const key = String(item.id || item.title);
            const resolvedCover = resolveCoverUrl(item);
            const existing = releaseMap.get(key);

            let cleanStatus = item.status || 'Submitted';
            if (cleanStatus.toLowerCase() === 'draft' || cleanStatus.toLowerCase().includes('gateway')) {
                cleanStatus = 'Submitted';
            }

            releaseMap.set(key, {
                ...existing,
                ...item,
                submittedBy: currentUid,
                coverUrl: resolvedCover || (existing ? existing.coverUrl : ''),
                status: cleanStatus
            });
        });

        window.releasesCatalog = Array.from(releaseMap.values());

        // 4. Trigger UI Render
        renderCatalogContainer();

    } catch (err) {
        console.error("Error loading live catalog:", err);
    }
}


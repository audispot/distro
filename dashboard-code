                                        <label class="too-lost-form-label">Disc Number</label>
                                        <input type="number" min="1" value="${track.discNumber || 1}" 
                                               onchange="window.releaseState.tracks[${idx}].discNumber = parseInt(this.value)" 
                                               class="too-lost-input">
                                    </div>
                                </div>

                                <!-- Explicit Status, Genres -->
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                    <div>
                                        <label class="too-lost-form-label">Explicit Status *</label>
                                        <select onchange="window.releaseState.tracks[${idx}].metadata.explicit = (this.value === 'true')" class="too-lost-input">
                                            <option value="false" ${!track.metadata?.explicit ? 'selected' : ''}>Clean / Non-Explicit</option>
                                            <option value="true" ${track.metadata?.explicit ? 'selected' : ''}>Explicit</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="too-lost-form-label">Track Genre *</label>
                                        <select onchange="handleTrackGenreChange(${idx}, this.value)" class="too-lost-input">
                                            <option value="">Select Genre</option>
                                            ${Object.keys(GENRE_MAP).map(g => `
                                                <option value="${g}" ${track.metadata?.genre === g ? 'selected' : ''}>${g}</option>
                                            `).join('')}
                                        </select>
                                    </div>
                                    <div>
                                        <label class="too-lost-form-label">Track Subgenre *</label>
                                        <select id="track_subgenre_${idx}" onchange="window.releaseState.tracks[${idx}].metadata.subgenre = this.value" 
                                                class="too-lost-input" ${!track.metadata?.genre ? 'disabled' : ''}>
                                            <option value="">${track.metadata?.genre ? 'Select Subgenre' : '-- Select Genre First --'}</option>
                                            ${track.metadata?.genre && GENRE_MAP[track.metadata.genre] 
                                                ? GENRE_MAP[track.metadata.genre].map(sub => `
                                                    <option value="${sub}" ${track.metadata?.subgenre === sub ? 'selected' : ''}>${sub}</option>
                                                  `).join('') 
                                                : ''}
                                        </select>
                                    </div>
                                </div>

                                <!-- Audio Upload & Audio Preview -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <label class="too-lost-form-label">Audio File (WAV/FLAC) *</label>
                                        <input type="file" accept="audio/wav,audio/flac" 
                                               onchange="handleAudioPreview(${idx}, this)" 
                                               class="too-lost-input text-xs">
                                    </div>
                                    <div>
                                        <label class="too-lost-form-label">Audio Preview</label>
                                        <div id="audio_preview_container_${idx}" class="flex items-center h-10 px-3 rounded-xl bg-brand-dark border border-brand-border">
                                            ${track.previewUrl || track.audioUrl ? `
                                                <audio controls class="w-full h-8">
                                                    <source src="${track.previewUrl || track.audioUrl}" type="audio/mpeg">
                                                    Your browser does not support audio playback.
                                                </audio>
                                            ` : '<span class="text-xs text-gray-500">No audio uploaded yet</span>'}
                                        </div>
                                    </div>
                                </div>

                                <!-- ISRC & TikTok Start Time -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <label class="too-lost-form-label">ISRC (Optional - Leave blank to auto-generate)</label>
                                        <input type="text" value="${track.isrc || ''}" 
                                               oninput="window.releaseState.tracks[${idx}].isrc = this.value" 
                                               class="too-lost-input" placeholder="e.g. USABC1234567">
                                    </div>
                                    <div>
                                        <label class="too-lost-form-label">TikTok Clip Start Time (MM:SS)</label>
                                        <input type="text" value="${track.tiktokStartTime || '00:30'}" 
                                               oninput="window.releaseState.tracks[${idx}].tiktokStartTime = this.value" 
                                               class="too-lost-input" placeholder="00:30">
                                    </div>
                                </div>

                                <!-- Lyrics -->
                                <div>
                                    <label class="too-lost-form-label">Plain Lyrics</label>
                                    <textarea oninput="window.releaseState.tracks[${idx}].lyrics = { plain: this.value }" 
                                              class="too-lost-input h-20" placeholder="Type plain text lyrics here...">${track.lyrics?.plain || ''}</textarea>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        window.handleTrackGenreChange = function(idx, genre) {
            window.releaseState.tracks[idx].metadata.genre = genre;
            window.releaseState.tracks[idx].metadata.subgenre = '';
            
            const subSelect = document.getElementById(`track_subgenre_${idx}`);
            if (!subSelect) return;

            if (genre && GENRE_MAP[genre]) {
                subSelect.disabled = false;
                subSelect.innerHTML = `<option value="">Select Subgenre</option>` + 
                    GENRE_MAP[genre].map(sub => `<option value="${sub}">${sub}</option>`).join('');
            } else {
                subSelect.disabled = true;
                subSelect.innerHTML = `<option value="">-- Select Genre First --</option>`;
            }
        };

        // Audio Preview Handler
        window.handleAudioPreview = function(trackIndex, inputElement) {
            const file = inputElement.files[0];
            if (!file) return;

            window.releaseState.tracks[trackIndex].audioFile = file;
            const previewUrl = URL.createObjectURL(file);
            window.releaseState.tracks[trackIndex].previewUrl = previewUrl;

            const container = document.getElementById(`audio_preview_container_${trackIndex}`);
            if (container) {
                container.innerHTML = `
                    <audio controls class="w-full h-8">
                        <source src="${previewUrl}" type="${file.type}">
                        Your browser does not support audio playback.
                    </audio>
                `;
            }
        };

        // Add Track for EP/Album
        window.addTrackToRelease = function() {
            window.releaseState.tracks.push({
                metadata: { title: '', version: '', genre: window.releaseState.metadata.primaryGenre || '', subgenre: window.releaseState.metadata.secondaryGenre || '', explicit: false },
                discNumber: 1,
                isrc: '',
                audioFile: null,
                previewUrl: '',
                tiktokStartTime: '00:30',
                lyrics: { plain: '' }
            });
            const container = document.getElementById('wizardStepContainer');
            if (container && window.currentStep === 4) container.innerHTML = renderStep4Content();
        };

        // Remove Track
        window.removeTrackFromRelease = function(index) {
            if (window.releaseState.tracks.length <= 1) return;
            window.releaseState.tracks.splice(index, 1);
            const container = document.getElementById('wizardStepContainer');
            if (container && window.currentStep === 4) container.innerHTML = renderStep4Content();
        };

        // Automatic track count adjustments when Release Type changes in Step 1
        window.adjustTracksForReleaseType = function() {
            const type = window.releaseState.metadata.type;
            if (type === 'Single') {
                window.releaseState.tracks = [window.releaseState.tracks[0] || {
                    metadata: { title: window.releaseState.metadata.title || '', explicit: false },
                    discNumber: 1
                }];
            }
        };

        // STEP 5 CONTENT
        function renderStep5Content() {
            return `
                <div class="space-y-4">
                    <div class="p-5 rounded-2xl bg-brand-dark border border-brand-border space-y-4 text-xs text-gray-300">
                        <h3 class="font-bold text-white text-sm">Legal & Copyright Affirmation</h3>
                        <label class="flex items-start gap-3 cursor-pointer">
                            <input type="checkbox" ${window.releaseState.agreements.termsAccepted ? 'checked' : ''} onchange="window.releaseState.agreements.termsAccepted = this.checked" class="mt-0.5 rounded border-brand-border">
                            <span>I certify that I am authorized to grant distribution rights for all masters, lyrics, and metadata supplied in this submission package.</span>
                        </label>
                        <label class="flex items-start gap-3 cursor-pointer">
                            <input type="checkbox" ${window.releaseState.agreements.rightsConfirmed ? 'checked' : ''} onchange="window.releaseState.agreements.rightsConfirmed = this.checked" class="mt-0.5 rounded border-brand-border">
                            <span>I confirm all underlying samples, interpolations, and performances are fully cleared for commercial distribution worldwide.</span>
                        </label>
                    </div>
                </div>
            `;
        }

        // STEP 6 CONTENT
function renderStep6Content() {
    const s = window.releaseState;
    return `
        <div class="space-y-4">
            <!-- Summary Card -->
            <div class="p-6 rounded-2xl bg-brand-dark border border-brand-border space-y-4 text-xs font-mono text-gray-300">
                <h3 class="text-sm font-bold text-white">Release Submission Summary</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-b border-brand-border pb-4">
                    <div>
                        <p><strong class="text-gray-400">Title:</strong> ${s.metadata.title || 'Untitled'}</p>
                        <p><strong class="text-gray-400">Type:</strong> ${s.metadata.type}</p>
                        <p><strong class="text-gray-400">Primary Genre:</strong> ${s.metadata.primaryGenre || 'N/A'}</p>
                        <p><strong class="text-gray-400">Subgenre:</strong> ${s.metadata.secondaryGenre || 'N/A'}</p>
                    </div>
                    <div>
                        <p><strong class="text-gray-400">Artists:</strong> ${s.artists.map(a => a.name).filter(Boolean).join(', ') || 'None'}</p>
                        <p><strong class="text-gray-400">Release Date:</strong> ${s.dates.releaseDate || 'Immediate'}</p>
                        <p><strong class="text-gray-400">Selected Stores:</strong> ${s.dsps.length} Platforms</p>
                        <p><strong class="text-gray-400">Total Tracks:</strong> ${s.tracks.length}</p>
                    </div>
                </div>
                <div class="text-[11px] text-cyan-400">
                    ✓ All required fields compiled.
                </div>
            </div>

            <!-- Submission Progress Card (Hidden until submit is clicked) -->
            <div id="submission-progress-card" class="hidden p-5 rounded-2xl bg-brand-dark border border-brand-border space-y-3">
                <div class="flex items-center justify-between text-xs font-semibold">
                    <span id="progress-status-text" class="text-cyan-400 flex items-center gap-2">
                        <i class="fa-solid fa-spinner animate-spin"></i> Preparing upload...
                    </span>
                    <span id="progress-percentage" class="text-gray-400 font-mono">0%</span>
                </div>
                
                <!-- Progress Bar Track -->
                <div class="w-full h-2.5 bg-brand-card rounded-full overflow-hidden border border-brand-border/40">
                    <!-- Progress Bar Fill -->
                    <div id="progress-bar-fill" class="h-full bg-gradient-to-r from-cyan-500 to-blue-500 transition-all duration-300 rounded-full" style="width: 0%;"></div>
                </div>
            </div>
        </div>
    `;
}

window.handleFormSubmission = async function(event) {
    if (event) event.preventDefault();

    if (!window.releaseState.agreements?.termsAccepted) {
        return window.showToast('Please confirm rights affirmation in Step 5 before submitting.');
    }

    const hasArtworkFile = Boolean(window.releaseState.artwork?.file);
    const existingArtworkUrl = window.releaseState.artwork?.url || '';
    
    if (!hasArtworkFile && !existingArtworkUrl) {
        return window.showToast('Please upload cover artwork before submitting.');
    }

    const submitBtn = document.getElementById('submit-release-btn') || document.querySelector('button[type="submit"]');
    const progressCard = document.getElementById('submission-progress-card');
    const statusText = document.getElementById('progress-status-text');
    const percentageText = document.getElementById('progress-percentage');
    const progressFill = document.getElementById('progress-bar-fill');

    const updateProgress = (percent, message) => {
        if (progressFill) progressFill.style.width = `${percent}%`;
        if (percentageText) percentageText.innerText = `${Math.round(percent)}%`;
        if (statusText) statusText.innerText = message;
    };

    let originalBtnHTML = '';
    if (submitBtn) {
        originalBtnHTML = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.style.cursor = 'not-allowed';
        submitBtn.style.opacity = '0.7';
        submitBtn.innerHTML = `
            <span style="display: inline-flex; align-items: center; gap: 8px;">
                <svg style="animation: spin 1s linear infinite; width: 16px; height: 16px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
                </svg>
                Submitting...
            </span>
        `;
    }

    if (progressCard) progressCard.style.display = 'block';
    updateProgress(5, 'Initializing submission pipeline...');

    try {
        const totalTracks = window.releaseState.tracks?.length || 0;
        const totalUploadSteps = (hasArtworkFile ? 1 : 0) + totalTracks;
        let completedSteps = 0;

        // 1. Upload Cover Artwork
        let finalCoverUrl = existingArtworkUrl;
        if (hasArtworkFile) {
            updateProgress(10, 'Uploading Cover Artwork...');
            const uploadRes = await uploadFileToR2(window.releaseState.artwork.file, 'artwork');
            finalCoverUrl = typeof uploadRes === 'string' 
                ? uploadRes 
                : (uploadRes?.url || uploadRes?.location || uploadRes?.path || '');

            if (!finalCoverUrl) throw new Error('Artwork upload succeeded but returned an invalid URL.');

            window.releaseState.artwork.url = finalCoverUrl;
            completedSteps++;
            const stepPercent = 10 + Math.floor((completedSteps / (totalUploadSteps || 1)) * 60);
            updateProgress(stepPercent, 'Cover Artwork uploaded successfully!');
        } else {
            updateProgress(20, 'Using existing artwork...');
        }

        // 2. Upload Audio Master Tracks
        for (let i = 0; i < totalTracks; i++) {
            const track = window.releaseState.tracks[i];
            if (track.audioFile) {
                updateProgress(
                    20 + Math.floor((completedSteps / (totalUploadSteps || 1)) * 60), 
                    `Uploading Track ${i + 1} of ${totalTracks}: "${track.metadata?.title || 'Master Audio'}"...`
                );
                const trackRes = await uploadFileToR2(track.audioFile, 'audio');
                const trackUrl = typeof trackRes === 'string' ? trackRes : (trackRes?.url || trackRes?.location || '');
                window.releaseState.tracks[i].audioUrl = trackUrl;
            }
            completedSteps++;
        }

        updateProgress(80, 'Formatting release metadata & participant roles...');

        const labelNameInput = typeof window.releaseState.label === 'object' 
            ? (window.releaseState.label.name || window.releaseState.label.label) 
            : window.releaseState.label;

        const labelString = (labelNameInput && labelNameInput.trim()) ? labelNameInput.trim() : 'Independent';

        const ALLOWED_ROLES = ['primary', 'featuring', 'remixer'];
        const mappedParticipants = (window.releaseState.artists || [])
            .map(artist => {
                let rawRoles = Array.isArray(artist.role) ? artist.role : [artist.role || 'primary'];
                const cleanedRoles = rawRoles.map(r => {
                    const norm = String(r).toLowerCase().trim();
                    if (norm.includes('feat')) return 'featuring';
                    if (norm.includes('remix')) return 'remixer';
                    if (ALLOWED_ROLES.includes(norm)) return norm;
                    return 'primary';
                });

                const artistName = typeof artist === 'string' ? artist : (artist.name || artist.artist_name || '');
                return {
                    name: artistName.trim(),
                    role: Array.from(new Set(cleanedRoles)),
                    spotify_id: artist.spotify_id || '',
                    apple_id: artist.apple_id || ''
                };
            })
            .filter(p => p.name !== '');

        if (mappedParticipants.length === 0) {
            throw new Error('Please specify at least one Primary Artist name.');
        }

        const editingId = window.releaseState.editingId;
        const isEditing = Boolean(editingId);

        const payload = {
            title: window.releaseState.metadata.title,
            type: window.releaseState.metadata.type,
            language: window.releaseState.metadata.language,
            genre: window.releaseState.metadata.primaryGenre,
            subgenre: window.releaseState.metadata.secondaryGenre,
            label: labelString,
            participants: mappedParticipants,
            artists: mappedParticipants,
            releaseDate: window.releaseState.dates.releaseDate,
            timezone: window.releaseState.dates.timezone,
            dsps: window.releaseState.dsps,
            coverUrl: finalCoverUrl,
            cover_url: finalCoverUrl,
            cover_art: finalCoverUrl,
            artwork: finalCoverUrl,
            tracks: window.releaseState.tracks.map(t => ({
                title: t.metadata.title,
                version: t.metadata.version,
                explicit: t.metadata.explicit,
                isrc: t.isrc,
                audio_url: t.audioUrl,
                tiktok_start_time: t.tiktokStartTime,
                lyrics: t.lyrics?.plain
            })),
            submittedBy: window.currentUser ? window.currentUser.uid : 'anonymous',
            createdAt: new Date().toISOString()
        };

        if (isEditing) {
            payload.id = editingId;
            payload.releaseId = editingId;
            payload.isUpdate = true;
        }

        updateProgress(90, 'Dispatching metadata to Gateway...');

        const token = window.currentUser?.getIdToken ? await window.currentUser.getIdToken() : '';
        const endpoint = `${WORKER_BASE_URL}/api/releases`;

        const res = await fetch(endpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(payload)
        });

        const serverResponse = await res.json().catch(() => null);

        if (!res.ok) {
            const errorMsg = serverResponse?.message || serverResponse?.error || `Failed to ${isEditing ? 'update' : 'create'} release on server API`;
            throw new Error(errorMsg);
        }

        updateProgress(100, `Release successfully ${isEditing ? 'updated' : 'submitted'}! Redirecting...`);

        const currentUid = window.currentUser ? window.currentUser.uid : 'anonymous';
        let validStatus = 'Submitted';
        if (serverResponse?.status && !serverResponse.status.includes('Gateway') && !serverResponse.status.includes('Online')) {
            validStatus = serverResponse.status;
        }

        // PRESERVE EXISTING ID ON EDITING
        const finalId = isEditing ? editingId : (serverResponse?.id || serverResponse?.data?.id || Date.now());

        const newReleaseItem = {
            id: finalId,
            title: payload.title,
            type: payload.type,
            status: validStatus,
            coverUrl: finalCoverUrl,
            compressedArtwork: finalCoverUrl,
            participants: mappedParticipants,
            upc: serverResponse?.upc || serverResponse?.data?.upc || 'Pending',
            submittedBy: currentUid
        };

        // Scope storage key dynamically to current user ID
        const userLocalStorageKey = `audiory_releases_${currentUid}`;

        // Retrieve user-scoped local releases
        let localSavedReleases = JSON.parse(
            localStorage.getItem(userLocalStorageKey) || 
            localStorage.getItem('audiory_local_releases') || 
            '[]'
        );

        if (isEditing) {
            const index = localSavedReleases.findIndex(item => String(item.id) === String(editingId));
            if (index !== -1) {
                localSavedReleases[index] = { ...localSavedReleases[index], ...newReleaseItem };
            } else {
                localSavedReleases.unshift(newReleaseItem);
            }
        } else {
            localSavedReleases.unshift(newReleaseItem);
        }

        // Save back to the user-scoped localStorage key
        localStorage.setItem(userLocalStorageKey, JSON.stringify(localSavedReleases));
        
        // Update global window state in place
        if (!Array.isArray(window.releasesCatalog)) window.releasesCatalog = [];
        if (isEditing) {
            const catIndex = window.releasesCatalog.findIndex(item => String(item.id) === String(editingId));
            if (catIndex !== -1) {
                window.releasesCatalog[catIndex] = { ...window.releasesCatalog[catIndex], ...newReleaseItem };
            } else {
                window.releasesCatalog.unshift(newReleaseItem);
            }
        } else {
            window.releasesCatalog.unshift(newReleaseItem);
        }

        window.releaseState.editingId = null;

        setTimeout(() => {
            if (typeof window.loadLiveCatalog === 'function') window.loadLiveCatalog();
            if (typeof window.renderDashboardHome === 'function') window.renderDashboardHome();
            if (typeof window.switchView === 'function') window.switchView('catalog');
            
            if (progressCard) progressCard.style.display = 'none';
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.style.cursor = 'pointer';
                submitBtn.style.opacity = '1';
                submitBtn.innerHTML = originalBtnHTML;
            }
        }, 1200);

    } catch (err) {
        console.error('Submission Error:', err);
        if (typeof window.showToast === 'function') {
            window.showToast(`Submission failed: ${err.message}`);
        } else {
            alert(`Submission failed: ${err.message}`);
        }
        
        if (progressCard) progressCard.style.display = 'none';
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.style.cursor = 'pointer';
            submitBtn.style.opacity = '1';
            submitBtn.innerHTML = originalBtnHTML;
        }
    }
};
        
    </script>

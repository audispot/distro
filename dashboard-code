// Update preview URL slug based on chosen release
window.updateSmartLinkPreviewSlug = function() {
    const releaseId = document.getElementById('sl_release_id')?.value;
    const previewEl = document.getElementById('sl_url_preview');
    if (!releaseId || !previewEl || !window._availableReleases) return;

    const selected = window._availableReleases.find((r, idx) => String(r.id || idx) === String(releaseId));
    if (selected) {
        const artistName = window.resolveArtistName(selected);
        const title = selected.title || selected.metadata?.title || 'release';
        const artistSlug = window.slugify(artistName);
        const releaseSlug = window.slugify(title);
        previewEl.innerText = `${artistSlug}/${releaseSlug}`;
    }
};

// Execute Backend Scan & Render Review Step (Step 2)
window.executeScanReleaseLinks = async function(e) {
    e.preventDefault();
    const releaseId = document.getElementById('sl_release_id').value;
    const scanBtn = document.getElementById('sl_scan_btn');
    const selectedRelease = window._availableReleases?.find((r, idx) => String(r.id || idx) === String(releaseId));

    if (scanBtn) {
        scanBtn.disabled = true;
        scanBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-xs"></i> <span>Scanning DSPs...</span>`;
    }

    let scannedPlatforms = { spotify: '', apple: '', deezer: '', youtube: '', tidal: '', amazon: '' };

    try {
        const token = await getAuthToken();
        const res = await fetch(`${getWorkerBaseUrl()}/api/smart-links/scan`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ releaseId })
        });

        if (res.ok) {
            const data = await res.json();
            if (data.platforms) {
                scannedPlatforms = { ...scannedPlatforms, ...data.platforms };
            }
        }
    } catch (err) {
        console.warn("Auto-scan failed, opening manual entry fallback:", err);
    }

    renderSmartLinkReviewStep(selectedRelease, scannedPlatforms);
};


        if (typeof window.initAnalyticsDashboard === 'function') {
            window.initAnalyticsDashboard();
        } else {
            console.error("window.initAnalyticsDashboard is not loaded yet.");
        }
    }

    if (viewName === 'earnings') {
        viewport.innerHTML = renderEarningsView();
        if (typeof window.initEarningsDashboard === 'function') {
            window.initEarningsDashboard();
        }
    }

    if (viewName === 'settings') {
        viewport.innerHTML = renderSettingsView();
        if (typeof window.initSettingsPage === 'function') {
            window.initSettingsPage();
        } else {
            console.error("window.initSettingsPage is not defined.");
        }
    }

    // NEW: Render Smart Links View
    if (viewName === 'smartlinks') {
        viewport.innerHTML = renderSmartLinksView();
        if (typeof window.initSmartLinksPage === 'function') {
            window.initSmartLinksPage();
        } else {
            console.error("window.initSmartLinksPage is not defined.");
        }
    }

    if (viewName === 'transfer') {
        viewport.innerHTML = renderTransferView();
        if (typeof window.initTransferCatalog === 'function') {
            window.initTransferCatalog();
        }
    }

    const sidebar = document.getElementById('sidebarNav');
    if (sidebar && !sidebar.classList.contains('-translate-x-full')) {
        sidebar.classList.add('-translate-x-full');
    }
};

window.toggleMobileSidebar = () => document.getElementById('sidebarNav').classList.toggle('-translate-x-full');

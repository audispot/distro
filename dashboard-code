// Updated Dashboard Initialization Function
async function initHomeDashboard() {
    const catalogTbody = document.getElementById('home-recent-catalog-tbody');
    if (catalogTbody) {
        const catalog = window.releasesCatalog || [];
        if (catalog.length === 0) {
            catalogTbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-gray-500">No releases found. Click "New Release" to start.</td></tr>`;
        } else {
            catalogTbody.innerHTML = catalog.slice(0, 5).map(rel => {
                const title = rel.title || rel.metadata?.title || 'Untitled Release';
                const artistName = resolveArtistName(rel);

                // Exact cover resolver from renderCatalogView
                let rawCover = rel.coverUrl || rel.compressedArtwork || rel.artworkUrl || rel.cover_url;
                if (!rawCover && rel.artwork) {
                    rawCover = typeof rel.artwork === 'string' ? rel.artwork : (rel.artwork.url || rel.artwork.cover_art);
                }
                const coverArt = (typeof rawCover === 'string' && rawCover.trim() !== '') ? rawCover : '';

                // Normalize status
                let status = rel.status || 'Submitted';
                if (status.toLowerCase() === 'draft' || status.toLowerCase().includes('gateway')) {
                    status = 'Submitted';
                }

                return `
                    <tr class="border-b border-brand-border/50 hover:bg-white/5 transition-colors">
                        <td class="py-3 px-2">
                            <div class="flex items-center gap-3">
                                ${coverArt 
                                    ? `<img src="${coverArt}" class="w-10 h-10 rounded-lg object-cover border border-brand-border/60 shrink-0" alt="Cover" />`
                                    : `<div class="w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center shrink-0"><i class="fa-solid fa-music text-gray-400"></i></div>`
                                }
                                <span class="font-semibold text-white">${title}</span>
                            </div>
                        </td>
                        <td class="py-3 px-2 text-gray-300">${artistName}</td>
                        <td class="py-3 px-2 text-gray-400 font-mono">${rel.upc || 'Pending'}</td>
                        <td class="py-3 px-2 text-right">
                            <span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 capitalize">${status}</span>
                        </td>
                    </tr>
                `;
            }).join('');
        }
    }

    // Fetch Overview Analytics
    try {
        if (!window.currentUser) return;
        const token = typeof window.currentUser.getIdToken === 'function' 
            ? await window.currentUser.getIdToken() 
            : window.currentUser.accessToken;

        if (!token) return;

        const workerUrl = window.WORKER_BASE_URL || 'https://audiorydistribution.dandredurkofficial.workers.dev';
        const res = await fetch(`${workerUrl}/api/analytics/overview?period=lastThirtyDays`, {
            headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/json' }
        });

        if (res.ok) {
            const json = await res.json();
            const data = json.data || json;

            const streamsEl = document.getElementById('home-stat-streams');
            const savesEl = document.getElementById('home-stat-saves');
            const engEl = document.getElementById('home-stat-engagement');

            if (streamsEl) streamsEl.innerText = Number(data.totalStreams || 0).toLocaleString();
            if (savesEl) savesEl.innerText = Number(data.totalSaves || 0).toLocaleString();
            if (engEl) engEl.innerText = data.engagement ? Number(data.engagement).toFixed(2) + '%' : 'N/A';

            renderHomeChart(data.chart || []);
        }
    } catch (err) {
        console.error("Home Dashboard API error:", err);
    }
}
        
function renderHomeChart(chartData) {
    const canvas = document.getElementById('homeOverviewChart');
    if (!canvas) return;

    if (homeChartInstance) {
        homeChartInstance.destroy();
    }

    const labels = chartData.map(p => p.date);
    const streams = chartData.map(p => p.totalStreams);

    const ctx = canvas.getContext('2d');
    homeChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Streams',
                data: streams,
                borderColor: '#06b6d4',
                backgroundColor: 'rgba(6, 182, 212, 0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.35,
                pointRadius: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#9ca3af', font: { size: 10 } } },
                y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#9ca3af', font: { size: 10 } } }
            }
        }
    });
}


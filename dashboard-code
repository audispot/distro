async function savePayoutMethod(e) {
    if(e) e.preventDefault();
    const selectedType = document.querySelector('input[name="payoutMethod"]:checked')?.value || 'bank';
    
    let details = {};
    if (selectedType === 'bank') {
        details = {
            holder: document.getElementById('bank-holder')?.value || '',
            bankName: document.getElementById('bank-name')?.value || '',
            accountNumber: document.getElementById('bank-acc')?.value || '',
            swiftCode: document.getElementById('bank-swift')?.value || ''
        };
    } else if (selectedType === 'paypal') {
        details = {
            paypalEmail: document.getElementById('paypal-email')?.value || ''
        };
    } else if (selectedType === 'mobile_money') {
        details = {
            provider: document.getElementById('mobile-provider')?.value || 'mpesa',
            phoneNumber: document.getElementById('mobile-number')?.value || ''
        };
    }

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/payout-preferences`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ payoutType: selectedType, details })
        });

        if (!response.ok) throw new Error("Failed to save payout preferences.");
        showToast("Payout preferences saved successfully!");
    } catch (err) {
        showToast(err.message, true);
    }
}

async function loadPayoutPreferences() {
    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/payout-preferences`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!response.ok) return;

        const data = await response.json();
        if (data && data.payoutType) {
            const radio = document.querySelector(`input[name="payoutMethod"][value="${data.payoutType}"]`);
            if (radio) {
                radio.checked = true;
                togglePayoutFields(data.payoutType);
            }
            if (data.details) {
                if (document.getElementById('bank-holder')) document.getElementById('bank-holder').value = data.details.holder || '';
                if (document.getElementById('bank-name')) document.getElementById('bank-name').value = data.details.bankName || '';
                if (document.getElementById('bank-acc')) document.getElementById('bank-acc').value = data.details.accountNumber || '';
                if (document.getElementById('bank-swift')) document.getElementById('bank-swift').value = data.details.swiftCode || '';
                if (document.getElementById('paypal-email')) document.getElementById('paypal-email').value = data.details.paypalEmail || '';
                if (document.getElementById('mobile-provider')) document.getElementById('mobile-provider').value = data.details.provider || 'mpesa';
                if (document.getElementById('mobile-number')) document.getElementById('mobile-number').value = data.details.phoneNumber || '';
            }
        }
    } catch {
        // Fallback default UI state
    }
}

function formatDateTime(value) {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return escapeHtml(value);
  return date.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
}

// Billing History Controller
async function loadBillingHistory() {
    const tbody = document.getElementById('settings-billing-tbody');
    const badge = document.getElementById('subscriptionPlanBadge');
    const details = document.getElementById('subscriptionDetails');
    if (!tbody) return;

    try {
        const token = await getAuthToken();
        const response = await fetch(`${getWorkerBaseUrl()}/api/billing-history`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        const data = response.ok ? await response.json() : {};
        const subscription = data.subscription || null;
        const history = Array.isArray(data.history) ? data.history : (Array.isArray(data) ? data : []);

        if (badge) {
          if (subscription) {
            const name = subscription.planName || subscription.name || subscription.planId || 'No active plan';
            const status = subscription.status || 'Pending';
            badge.textContent = `${name} ${status}`;
            badge.className = `px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase ${String(status).toLowerCase() === 'active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20'}`;
          } else {
            badge.textContent = 'No active subscription';
          }
        }
        if (details) {
          details.innerHTML = subscription ? `

// Safely declare escapeHtml
if (typeof window.escapeHtml !== 'function') {
    window.escapeHtml = function(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    };
}

// Helper to format text into URL-safe slugs
if (typeof window.slugify !== 'function') {
    window.slugify = function(text) {
        if (!text) return '';
        return text.toString().toLowerCase().trim()
            .replace(/\s+/g, '-')
            .replace(/[^\w\-]+/g, '')
            .replace(/\-\-+/g, '-');
    };
}

// Exact artist resolver matching catalog logic
if (typeof window.resolveArtistName !== 'function') {
    window.resolveArtistName = function(rel) {
        if (!rel) return 'Unknown Artist';

        // 1. Check participants array
        if (Array.isArray(rel.participants) && rel.participants.length > 0) {
            const names = rel.participants
                .map(p => typeof p === 'string' ? p : (p.name || ''))
                .filter(Boolean);
            if (names.length > 0) return names.join(', ');
        } 
        
        // 2. Check artists array
        if (Array.isArray(rel.artists) && rel.artists.length > 0) {
            const names = rel.artists
                .map(a => typeof a === 'string' ? a : (a.name || ''))
                .filter(Boolean);
            if (names.length > 0) return names.join(', ');
        } 
        
        // 3. Check single artist field (string or object)
        if (rel.artist) {
            if (typeof rel.artist === 'string' && rel.artist.trim()) return rel.artist;
            if (typeof rel.artist === 'object' && rel.artist.name) return rel.artist.name;
        }

        // 4. Check fallback string properties
        if (typeof rel.artistName === 'string' && rel.artistName.trim()) return rel.artistName;
        if (typeof rel.primaryArtist === 'string' && rel.primaryArtist.trim()) return rel.primaryArtist;
        if (typeof rel.artist_name === 'string' && rel.artist_name.trim()) return rel.artist_name;

        return 'Unknown Artist';
    };
}


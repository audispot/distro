// Modal Confirm System
let confirmResolve = null;
function showCustomConfirm(title, message) {
    return new Promise((resolve) => {
        confirmResolve = resolve;
        const modal = document.getElementById('customConfirmModal');
        const titleEl = document.getElementById('confirmModalTitle');
        const msgEl = document.getElementById('confirmModalMessage');
        const actionBtn = document.getElementById('confirmModalActionBtn');

        if (titleEl) titleEl.textContent = title;
        if (msgEl) msgEl.textContent = message;

        if (actionBtn) {
            actionBtn.onclick = () => closeConfirmModal(true);
        }

        if (modal) modal.classList.remove('hidden');
    });
}

function closeConfirmModal(result) {
    const modal = document.getElementById('customConfirmModal');
    if (modal) modal.classList.add('hidden');
    if (confirmResolve) {
        confirmResolve(result);
        confirmResolve = null;
    }
}

// Page Initialization Controller
async function initSettingsView() {
    const user = window.currentUser || (window.firebase && firebase.auth().currentUser) || {};
    const nameInput = document.getElementById('settings-user-name');
    const emailInput = document.getElementById('settings-user-email');

    if (emailInput) emailInput.value = user.email || '';

    // 1. First load from KV (The Source of Truth)
    let kvLoaded = false;
    try {
      const token = await getAuthToken();
      const response = await fetch(`${getWorkerBaseUrl()}/api/profile`, { 
        headers: { 'Authorization': `Bearer ${token}` } 
      });
      
      if (response.ok) {
        const profile = await response.json();
        window.audioryProfile = profile || {};
        
        if (profile.displayName) {
          if (nameInput) nameInput.value = profile.displayName;
          updateDashboardProfileName(profile.displayName);
          
          // Also sync locally to window.currentUser if present
          if (window.currentUser) window.currentUser.displayName = profile.displayName;
          
          kvLoaded = true; // Mark as loaded, do not exit early
        }
      }
    } catch (err) {
      console.warn("Could not load profile from Worker KV:", err);
    }

    // 2. Fallback to Firebase user data if KV is empty
    if (!kvLoaded) {
      if (nameInput) {
        nameInput.value = user.displayName || user.email?.split('@')[0] || '';
      }
      updateDashboardProfileName(user.displayName || user.email?.split('@')[0]);
    }

    // 3. Always run secondary data queries regardless of KV profile status
    await Promise.all([
        loadAccountMembers(),
        loadPayoutPreferences(),
        loadBillingHistory(),
        loadTaxDetails(),
        loadLoginHistory()
    ]);
}
        
// Centralized DOM updater for profile display names
function updateDashboardProfileName(name) {
    if (!name) return;
    
    // Update global state
    window.audioryProfile = window.audioryProfile || {};
    window.audioryProfile.displayName = name;
    if (window.currentUser) window.currentUser.displayName = name;

    const selectors = [
      '[data-user-display-name]', '#userDisplayName', '#dashboardUserName',
      '#profileDisplayName', '.dashboard-user-name'
    ];
    
    selectors.forEach(selector => {
      document.querySelectorAll(selector).forEach(el => { el.textContent = name; });
    });
}

// Profile Save Handler
async function handleSaveProfile(e) {
    e.preventDefault();
    const nameInput = document.getElementById('settings-user-name');
    if (!nameInput) return;
    
    const newName = nameInput.value.trim();
    if (!newName) {
      showToast('Display name is required.', true);
      return;
    }

    try {
        const user = window.currentUser || (window.firebase && firebase.auth().currentUser);
        const token = await getAuthToken();

        // 1. Save to Worker KV
        const response = await fetch(`${getWorkerBaseUrl()}/api/profile`, {
            method: 'POST',
            headers: { 
              'Authorization': `Bearer ${token}`, 
              'Content-Type': 'application/json' 
            },
            body: JSON.stringify({ displayName: newName })
        });
        
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Failed to update profile name.');

        // 2. Sync with client Firebase SDK and force refresh user instance
        if (user && typeof user.updateProfile === 'function') {
            try { 
              await user.updateProfile({ displayName: newName });
              if (typeof user.reload === 'function') {
                await user.reload(); // Ensures SDK cache is refreshed
              }
            } catch (fbErr) {
              console.warn("Firebase SDK update profile warning:", fbErr);
            }
        }

        // 3. Update local state & DOM immediately
        window.audioryProfile = data.profile || { displayName: newName };
        updateDashboardProfileName(newName);
        nameInput.value = newName;
        
        showToast('Profile name updated successfully!');
    } catch (err) {
        showToast(err.message || 'Failed to update profile name.', true);
    }
}
        

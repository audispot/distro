}

// Exact artist resolver matching renderCatalogView logic
function resolveArtistName(rel) {
    if (!rel) return 'Unknown Artist';

    if (Array.isArray(rel.participants) && rel.participants.length > 0) {
        return rel.participants
            .map(p => typeof p === 'string' ? p : p.name)
            .filter(Boolean)
            .join(', ');
    } 
    
    if (Array.isArray(rel.artists) && rel.artists.length > 0) {
        return rel.artists
            .map(a => typeof a === 'string' ? a : (a.name || ''))
            .filter(Boolean)
            .join(', ');
    } 
    
    if (rel.artist) {
        return typeof rel.artist === 'string' ? rel.artist : (rel.artist.name || 'Unknown Artist');
    }

    return 'Unknown Artist';
}

// Universal Helper: Matches resolveCoverUrl logic inside loadLiveCatalog
function resolveCoverUrl(item) {
    if (!item) return '';
    if (typeof item.artwork === 'string') return item.artwork;
    if (item.artwork && typeof item.artwork === 'object') {
        return item.artwork.url || item.artwork.cover_art || item.artwork.path || '';
    }
    return item.coverUrl 
        || item.compressedArtwork 
        || item.artworkUrl 
        || item.cover_url 
        || item.cover_art 
        || item.image 
        || '';
}
        
        // Direct Multipart Upload to Cloudflare Worker R2 Bucket
        async function uploadFileToR2(file, folder = 'audio') {
            const token = await window.currentUser.getIdToken();
            const formData = new FormData();
            formData.append('file', file);
            formData.append('folder', folder);

            const res = await fetch(`${WORKER_BASE_URL}/api/upload`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` },
                body: formData
            });

            if (!res.ok) {
                const errText = await res.text();
                throw new Error(`Worker upload failed with status ${res.status}: ${errText}`);
            }

            const data = await res.json();
            if (!data.success || !data.url) {
                throw new Error(`Upload failed: ${data.error || 'No public URL returned from Worker'}`);
            }

            return data.url;
        }


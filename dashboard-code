async function initAnalyticsDashboard(period = 'lastThirtyDays') {
    const kpiContainer = document.getElementById('analytics-kpi-container');
    const tbody = document.getElementById('analytics-tracks-tbody');

    try {
        currentAnalyticsPeriod = period;

        // Sync dropdown value & listener
        const periodSelect = document.getElementById('analytics-period-select');
        if (periodSelect) {
            periodSelect.value = period;
            if (!periodSelect.dataset.listenerAttached) {
                periodSelect.dataset.listenerAttached = "true";
                periodSelect.addEventListener('change', (e) => initAnalyticsDashboard(e.target.value));
            }
        }

        // Verify user authentication
        if (!window.currentUser) {
            console.warn("Analytics: window.currentUser is missing.");
            if (tbody) tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-rose-400">Authentication required. Please sign in again.</td></tr>`;
            renderKPIs({ totalStreams: 0, totalSaves: 0, totalSkips: 0, engagement: 0 });
            return;
        }

        // Retrieve Authorization Token
        let token = "";
        if (typeof window.currentUser.getIdToken === 'function') {
            token = await window.currentUser.getIdToken(true); // Force refresh
        } else if (window.currentUser.accessToken) {
            token = window.currentUser.accessToken;
        }

        if (!token) {
            throw new Error("Missing authentication token");
        }

        const workerUrl = window.WORKER_BASE_URL || 'https://audiorydistribution.dandredurkofficial.workers.dev';

        // Fetch Analytics Data
        const [overviewRes, tracksRes] = await Promise.all([
            fetch(`${workerUrl}/api/analytics/overview?period=${period}`, {
                method: 'GET',
                headers: { 
                    'Authorization': `Bearer ${token}`, 
                    'Content-Type': 'application/json' 
                }
            }),
            fetch(`${workerUrl}/api/analytics/tracks?period=${period}&page=1&perPage=10`, {
                method: 'GET',
                headers: { 
                    'Authorization': `Bearer ${token}`, 
                    'Content-Type': 'application/json' 
                }
            })
        ]);

        // Process Overview Data
        if (overviewRes.ok) {
            const overviewJson = await overviewRes.json();
            renderKPIs(overviewJson.data || overviewJson);
            renderChart((overviewJson.data || overviewJson).chart || []);
        } else {
            console.error(`Overview API failed: ${overviewRes.status}`);
            renderKPIs({ totalStreams: 0, totalSaves: 0, totalSkips: 0, engagement: 0 });
        }

        // Process Track Data
        if (tracksRes.ok) {
            const tracksJson = await tracksRes.json();
            renderTracksTable(tracksJson.data || []);
        } else {
            console.error(`Tracks API failed: ${tracksRes.status}`);
            if (tbody) tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-rose-400">Unauthorized (401): Check Worker auth middleware.</td></tr>`;
        }

    } catch (err) {
        console.error("Analytics Dashboard error:", err);
        if (tbody) tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-rose-400">Failed to authenticate API request.</td></tr>`;
        renderKPIs({ totalStreams: 0, totalSaves: 0, totalSkips: 0, engagement: 0 });
    }
}

window.initAnalyticsDashboard = initAnalyticsDashboard;
        

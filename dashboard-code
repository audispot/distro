// Handle Final Creation & Saving
window.handleSaveSmartLink = async function(e) {
    e.preventDefault();
    const saveBtn = document.getElementById('sl_save_btn');
    if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-xs"></i> <span>Saving...</span>`;
    }

    const releaseId = document.getElementById('sl_final_release_id').value;
    const slug = document.getElementById('sl_final_slug').value;
    const title = document.getElementById('sl_final_title').value;
    const coverUrl = document.getElementById('sl_final_cover').value;

    const payload = {
        releaseId,
        title,
        slug,
        coverUrl,
        shortUrl: `https://distro.audiory.site/s/${slug}`,
        platforms: {
            spotify: document.getElementById('sl_spotify')?.value || '',
            apple: document.getElementById('sl_apple')?.value || '',
            deezer: document.getElementById('sl_deezer')?.value || '',
            youtube: document.getElementById('sl_youtube')?.value || '',
            tidal: document.getElementById('sl_tidal')?.value || '',
            amazon: document.getElementById('sl_amazon')?.value || ''
        }
    };

    try {
        const token = await getAuthToken();
        const res = await fetch(`${getWorkerBaseUrl()}/api/smart-links`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        if (!res.ok) throw new Error("Failed to save smart link");

        document.getElementById('smartlink-modal')?.remove();
        window.showToast("Smart Link created successfully!");
        window.initSmartLinksPage();
    } catch (err) {
        window.showToast(err.message || "Failed to save smart link", true);
        if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = `<i class="fa-solid fa-check text-xs"></i> <span>Save & Publish</span>`;
        }
    }
};

// Custom Delete Modal
window.confirmDeleteSmartLink = function(id) {
    const existing = document.getElementById('delete-modal');
    if (existing) existing.remove();

    const deleteModalHtml = `
        <div id="delete-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fadeIn">
            <div class="bg-[#121824] border border-brand-border/80 rounded-2xl max-w-sm w-full p-5 space-y-4 text-white shadow-2xl">
                <div class="space-y-1">
                    <h3 class="text-sm font-bold text-white">Delete Smart Link?</h3>
                    <p class="text-xs text-gray-400">This action cannot be undone and will break existing links.</p>
                </div>
                <div class="flex items-center justify-end gap-2 pt-2">
                    <button onclick="document.getElementById('delete-modal').remove()" class="px-3.5 py-1.5 rounded-xl text-xs font-semibold text-gray-400 hover:text-white">Cancel</button>
                    <button onclick="executeDeleteSmartLink('${id}')" class="px-3.5 py-1.5 bg-red-500/80 hover:bg-red-500 text-white font-semibold rounded-xl text-xs transition">Delete</button>
                </div>
            </div>
        </div>
    `;

    document.body.insertAdjacentHTML('beforeend', deleteModalHtml);
};

// Execute Delete Request
window.executeDeleteSmartLink = async function(id) {
    document.getElementById('delete-modal')?.remove();
    try {
        const token = await getAuthToken();
        const res = await fetch(`${getWorkerBaseUrl()}/api/smart-links/${id}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
        });

        if (!res.ok) throw new Error("Failed to delete link");

        window.showToast("Smart Link deleted successfully.");
        window.initSmartLinksPage();
    } catch (err) {
        window.showToast(err.message || "Could not delete Smart Link", true);
    }
};

// Custom Copy Action
window.copySmartLink = function(url) {
    if (!url) return;
    navigator.clipboard.writeText(url).then(() => {
        window.showToast("Link copied to clipboard!");
    }).catch(() => {
        window.showToast("Failed to copy link.", true);
    });
};


            // Update Controls
            const prevBtn = document.getElementById('prevStepBtn');
            const nextBtn = document.getElementById('nextStepBtn');
            const submitBtn = document.getElementById('submitReleaseBtn');

            if (prevBtn) prevBtn.disabled = (step === 1);
            if (nextBtn) nextBtn.classList.toggle('hidden', step === 6);
            if (submitBtn) submitBtn.classList.toggle('hidden', step !== 6);

            if (!container) return;

            if (step === 1) container.innerHTML = renderStep1Content();
            if (step === 2) container.innerHTML = renderStep2Content();
            if (step === 3) container.innerHTML = renderStep3Content();
            if (step === 4) container.innerHTML = renderStep4Content();

                if (tab) {
                    if (i === step) {
                        tab.className = "p-2 rounded-lg bg-brand-accent text-brand-dark font-bold cursor-pointer";
                    } else {
                        tab.className = "p-2 rounded-lg bg-brand-card text-gray-400 border border-brand-border cursor-pointer";

// Track Credits row builder helpers
function parseCreditsToRows(creditsStr) {
    if (!creditsStr || typeof creditsStr !== 'string') {
        return [{ name: '', role: 'Producer' }];
    }
    const parts = creditsStr.split(';').map(p => p.trim()).filter(Boolean);
    if (parts.length === 0) return [{ name: '', role: 'Producer' }];

    return parts.map(part => {
        const sub = part.split(':').map(s => s.trim());
        if (sub.length >= 2) {
            return { name: sub[0], role: sub[1] };
        }
        return { name: part, role: 'Producer' };
    });
}

window.updateTrackCreditData = function(trackIndex) {
    const container = document.getElementById(`track_credits_rows_${trackIndex}`);
    if (!container) return;

    const rows = container.querySelectorAll('.grid');
    const creditEntries = [];

    rows.forEach(row => {
        const nameInput = row.querySelector('.credit-name-input');
        const roleSelect = row.querySelector('.credit-role-select');
        if (nameInput && nameInput.value.trim()) {
            creditEntries.push(`${nameInput.value.trim()}: ${roleSelect ? roleSelect.value : 'Producer'}`);
        }
    });

    window.releaseState.tracks[trackIndex].credits = creditEntries.join('; ');
};

window.addTrackCreditRow = function(trackIndex) {
    window.updateTrackCreditData(trackIndex);
    if (!Array.isArray(window.releaseState.tracks[trackIndex].creditRows)) {
        window.releaseState.tracks[trackIndex].creditRows = parseCreditsToRows(window.releaseState.tracks[trackIndex].credits);
    }
    window.releaseState.tracks[trackIndex].creditRows.push({ name: '', role: 'Producer' });
    
    // Re-render step 4 container
    const container = document.getElementById('wizardStepContainer');
    if (container && window.currentStep === 4) container.innerHTML = renderStep4Content();
};

window.removeTrackCreditRow = function(trackIndex, creditIndex) {
    window.updateTrackCreditData(trackIndex);
    let rows = parseCreditsToRows(window.releaseState.tracks[trackIndex].credits);
    rows.splice(creditIndex, 1);
    if (rows.length === 0) rows = [{ name: '', role: 'Producer' }];
    
    const creditEntries = rows.map(r => `${r.name}: ${r.role}`);
    window.releaseState.tracks[trackIndex].credits = creditEntries.join('; ');

    const container = document.getElementById('wizardStepContainer');
    if (container && window.currentStep === 4) container.innerHTML = renderStep4Content();
};

function formatAudioTime(seconds) {
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
}

window.addTrackArtist = function(trackIndex) {
    if (!Array.isArray(window.releaseState.tracks[trackIndex].artists)) {
        window.releaseState.tracks[trackIndex].artists = [];
    }
    window.releaseState.tracks[trackIndex].artists.push({ name: '', role: 'primary' });
    document.getElementById('wizardStepContainer').innerHTML = renderStep4Content();
};

window.removeTrackArtist = function(trackIndex, artistIndex) {
    window.releaseState.tracks[trackIndex].artists.splice(artistIndex, 1);
    document.getElementById('wizardStepContainer').innerHTML = renderStep4Content();
};

window.addTrackWriter = function(trackIndex) {
    if (!Array.isArray(window.releaseState.tracks[trackIndex].writers)) {
        window.releaseState.tracks[trackIndex].writers = [];
    }
    window.releaseState.tracks[trackIndex].writers.push({ name: '', role: 'instrumentalist' });
    document.getElementById('wizardStepContainer').innerHTML = renderStep4Content();
};

window.removeTrackWriter = function(trackIndex, writerIndex) {
    const writers = window.releaseState.tracks[trackIndex].writers;
    if (writers.length <= 1) {
        window.showToast('Each track must have at least one Instrumentalist / Composer writer.');
        return;
    }
    writers.splice(writerIndex, 1);
    document.getElementById('wizardStepContainer').innerHTML = renderStep4Content();
};

window.handleInstrumentalSelection = function(trackIndex, input) {
    const file = input.files?.[0];
    if (!file) return;

    const validTypes = ['audio/wav', 'audio/x-wav', 'audio/flac', 'audio/x-flac'];
    const validExtension = /\.(wav|flac)$/i.test(file.name);

    if (!validTypes.includes(file.type) && !validExtension) {
        input.value = '';

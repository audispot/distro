// Render functions for wizard steps
window.renderStepContent = function(step) {
    window.currentStep = step;
    const container = document.getElementById('wizardStepContainer');
    const counter = document.getElementById('stepCounter');
    if (counter) counter.innerText = step;

    // Update Tab Highlights
    for (let i = 1; i <= 6; i++) {
        const tab = document.getElementById(`step_tab_${i}`);
        if (tab) {
            if (i === step) {
                tab.className = "p-2 rounded-lg bg-brand-accent text-brand-dark font-bold cursor-pointer";
            } else {
                tab.className = "p-2 rounded-lg bg-brand-card text-gray-400 border border-brand-border cursor-pointer";
            }
        }
    }

    // Update Controls
    const prevBtn = document.getElementById('prevStepBtn');
    const nextBtn = document.getElementById('nextStepBtn');
    const submitBtn = document.getElementById('submitReleaseBtn');

    if (prevBtn) prevBtn.disabled = (step === 1);
    if (nextBtn) nextBtn.classList.toggle('hidden', step === 6);
    if (submitBtn) submitBtn.classList.toggle('hidden', step !== 6);

    if (!container) return;

    if (step === 1) container.innerHTML = renderStep1Content();
    if (step === 2) container.innerHTML = renderStep2Content();
    if (step === 3) container.innerHTML = renderStep3Content();
    if (step === 4) container.innerHTML = renderStep4Content();
    if (step === 5) container.innerHTML = renderStep5Content();
    if (step === 6) container.innerHTML = renderStep6Content();

    if (step === 1) window.renderArtistInputs();
};

window.navigateStep = function(direction) {
    const newStep = window.currentStep + direction;
    if (newStep >= 1 && newStep <= 6) {
        window.renderStepContent(newStep);
    }
};

// Step validation helper function
window.validateReleaseStep = function(step) {
    const s = window.releaseState;
    if (step === 1) {
        if (!s.metadata?.title?.trim() || !s.metadata?.primaryGenre || !s.label?.name?.trim()) {
            if (typeof window.showToast === 'function') window.showToast('Please complete required fields in Step 1 (Title, Genre, Label).');
            return false;
        }
    } else if (step === 2) {
        if (!s.dates?.releaseDate) {
            if (typeof window.showToast === 'function') window.showToast('Please select a digital release date.');
            return false;
        }
    } else if (step === 3) {
        if (!s.artwork?.file && !s.artwork?.url) {
            if (typeof window.showToast === 'function') window.showToast('Please upload cover artwork.');
            return false;
        }
    } else if (step === 4) {
        if (!s.tracks || s.tracks.length === 0 || !s.tracks[0].metadata?.title?.trim()) {
            if (typeof window.showToast === 'function') window.showToast('Please complete track details.');
            return false;
        }
    } else if (step === 5) {
        if (!s.agreements?.termsAccepted || !s.agreements?.rightsConfirmed) {
            if (typeof window.showToast === 'function') window.showToast('Please accept terms and rights confirmations.');
            return false;
        }
    }
    return true;
};

window.navigateDirectStep = function(step) {
    if (step > window.currentStep) {
        for (let i = window.currentStep; i < step; i++) {
            if (!validateReleaseStep(i)) return;
        }
    }
    window.renderStepContent(step);
};


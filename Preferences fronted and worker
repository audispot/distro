// UI Toast Notification Helper
window.showPrefToast = function(message, type = 'success') {
    const toast = document.getElementById('pref-toast');
    if (!toast) return;

    if (type === 'success') {
        toast.className = "fixed top-5 right-5 z-50 px-4 py-3 rounded-xl text-xs font-semibold shadow-lg bg-emerald-500/20 border border-emerald-500/50 text-emerald-300 flex items-center gap-2";
        toast.innerHTML = `<i class="fa-solid fa-circle-check"></i> ${message}`;
    } else {
        toast.className = "fixed top-5 right-5 z-50 px-4 py-3 rounded-xl text-xs font-semibold shadow-lg bg-rose-500/20 border border-rose-500/50 text-rose-300 flex items-center gap-2";
        toast.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> ${message}`;
    }

    toast.classList.remove('hidden');
    setTimeout(() => {
        toast.classList.add('hidden');
    }, 4000);
};

// Toggle UI Modes between Form and Submitted View
window.updateUIMode = function() {
    const submittedView = document.getElementById('pref-submitted-view');
    const formView = document.getElementById('pref-section-artist');
    const headerActions = document.getElementById('pref-header-actions');

    if (window.prefState.mode === 'view' && window.prefState.artistData && window.prefState.artistData.artistName) {
        submittedView.classList.remove('hidden');
        formView.classList.add('hidden');
        headerActions.classList.add('hidden');
        window.populateSummary(window.prefState.artistData);
    } else {
        submittedView.classList.add('hidden');
        formView.classList.remove('hidden');
        headerActions.classList.remove('hidden');
    }
};

window.populateSummary = function(data) {
    document.getElementById('summary-artistName').innerText = data.artistName || 'Not specified';
    const primary = data.primaryGenre || '';
    const secondary = data.secondaryGenre ? ` / ${data.secondaryGenre}` : '';
    document.getElementById('summary-genres').innerText = (primary + secondary) || 'Not specified';
    document.getElementById('summary-language').innerText = data.language || 'Not specified';
    document.getElementById('summary-about').innerText = data.about || 'No bio submitted.';
    
    document.getElementById('summary-label').innerText = data.label || 'None';
    document.getElementById('summary-cLine').innerText = data.cLine || data.c_line || 'None';
    document.getElementById('summary-pLine').innerText = data.pLine || data.p_line || 'None';

    const p = data.platforms || {};
    document.getElementById('summary-spotify').innerText = p.spotify || 'Not linked';
    document.getElementById('summary-appleMusic').innerText = p.appleMusic || 'Not linked';
    document.getElementById('summary-vevo').innerText = p.vevo || 'Not linked';
    document.getElementById('summary-website').innerText = p.website || 'Not linked';
};

window.openEditMode = function() {
    window.prefState.mode = 'edit';
    window.updateUIMode();
};


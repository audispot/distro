window.confirmDeletePreferences = async function() {
    window.closeDeleteModal();
    const token = window.currentUser?.getIdToken ? await window.currentUser.getIdToken() : '';
    const baseUrl = window.WORKER_BASE_URL || '';

    try {
        const emptyPayload = {
            artistName: "",
            primaryGenre: "",
            secondaryGenre: "",
            language: "",
            about: "",
            label: "",
            cLine: "",
            pLine: "",
            platforms: { spotify: "", appleMusic: "", vevo: "", website: "" }
        };

        const res = await fetch(`${baseUrl}/api/preferences/artist/submit`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(emptyPayload)
        });

        if (res.ok) {
            window.prefState.artistData = null;
            window.prefState.mode = 'edit';
            
            document.getElementById('pref-artistName').value = '';
            document.getElementById('pref-primaryGenre').value = '';
            document.getElementById('pref-secondaryGenre').value = '';
            document.getElementById('pref-language').value = '';
            document.getElementById('pref-about').value = '';
            document.getElementById('pref-label').value = '';
            document.getElementById('pref-cLine').value = '';
            document.getElementById('pref-pLine').value = '';
            document.getElementById('pref-platform-spotify').value = '';
            document.getElementById('pref-platform-appleMusic').value = '';
            document.getElementById('pref-platform-vevo').value = '';
            document.getElementById('pref-platform-website').value = '';

            window.updateUIMode();
            window.showPrefToast('Artist preferences deleted successfully.', 'success');
        } else {
            window.showPrefToast('Failed to clear preferences.', 'error');
        }
    } catch (err) {
        console.error('Delete error:', err);
        window.showPrefToast('Server connection error.', 'error');
    }
};

window.switchPrefTab = function(tab) {
    const artistTab = document.getElementById('tab-btn-artist');
    const labelTab = document.getElementById('tab-btn-label');
    const artistSec = document.getElementById('pref-section-artist');
    const labelSec = document.getElementById('pref-section-label');
    const submittedView = document.getElementById('pref-submitted-view');

    if (tab === 'artist') {
        artistTab.className = "px-3 sm:px-4 py-1.5 text-xs font-bold rounded-lg bg-brand-dark text-brand-accent border border-brand-border/80";
        labelTab.className = "px-3 sm:px-4 py-1.5 text-xs font-bold rounded-lg text-gray-400 hover:text-white transition-all";
        labelSec.classList.add('hidden');
        window.updateUIMode();
    } else {
        labelTab.className = "px-3 sm:px-4 py-1.5 text-xs font-bold rounded-lg bg-brand-dark text-brand-accent border border-brand-border/80";
        artistTab.className = "px-3 sm:px-4 py-1.5 text-xs font-bold rounded-lg text-gray-400 hover:text-white transition-all";
        labelSec.classList.remove('hidden');
        artistSec.classList.add('hidden');
        submittedView.classList.add('hidden');
    }
};

window.initPreferencesPage = async function() {
    const token = window.currentUser?.getIdToken ? await window.currentUser.getIdToken() : '';
    const baseUrl = window.WORKER_BASE_URL || '';

    try {
        const res = await fetch(`${baseUrl}/api/preferences/artist`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.ok) {
            const body = await res.json();
            const artist = body.data?.artist || {};
            
            window.prefState.artistData = artist;

            document.getElementById('pref-artistName').value = artist.artistName || '';
            document.getElementById('pref-primaryGenre').value = artist.primaryGenre || '';
            document.getElementById('pref-secondaryGenre').value = artist.secondaryGenre || '';
            document.getElementById('pref-language').value = artist.language || '';
            document.getElementById('pref-about').value = artist.about || '';
            document.getElementById('pref-label').value = artist.label || '';
            document.getElementById('pref-cLine').value = artist.cLine || artist.c_line || '';
            document.getElementById('pref-pLine').value = artist.pLine || artist.p_line || '';

            if (artist.platforms) {
                document.getElementById('pref-platform-spotify').value = artist.platforms.spotify || '';
                document.getElementById('pref-platform-appleMusic').value = artist.platforms.appleMusic || '';
                document.getElementById('pref-platform-vevo').value = artist.platforms.vevo || '';
                document.getElementById('pref-platform-website').value = artist.platforms.website || '';
            }

            if (artist.artistName) {
                window.prefState.mode = 'view';
            } else {
                window.prefState.mode = 'edit';
            }
            window.updateUIMode();
        }
    } catch (err) {
        console.error('Failed to load preferences:', err);
        window.showPrefToast('Failed to load preferences from server.', 'error');
    }
};

window.savePreferences = async function() {
    const btn = document.getElementById('btn-save-preferences');
    btn.disabled = true;
    btn.innerText = 'Saving...';

    const token = window.currentUser?.getIdToken ? await window.currentUser.getIdToken() : '';
    const baseUrl = window.WORKER_BASE_URL || '';

    const payload = {
        artistName: document.getElementById('pref-artistName').value,
        primaryGenre: document.getElementById('pref-primaryGenre').value,
        secondaryGenre: document.getElementById('pref-secondaryGenre').value,
        language: document.getElementById('pref-language').value,
        about: document.getElementById('pref-about').value,
        label: document.getElementById('pref-label').value,
        cLine: document.getElementById('pref-cLine').value,
        pLine: document.getElementById('pref-pLine').value,
        platforms: {
            spotify: document.getElementById('pref-platform-spotify').value,
            appleMusic: document.getElementById('pref-platform-appleMusic').value,
            vevo: document.getElementById('pref-platform-vevo').value,
            website: document.getElementById('pref-platform-website').value
        }
    };

    try {
        const res = await fetch(`${baseUrl}/api/preferences/artist/submit`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });
        
        if (res.ok) {
            window.prefState.artistData = payload;
            window.prefState.mode = 'view';
            window.updateUIMode();
            window.showPrefToast('Preferences saved successfully!', 'success');
        } else {
            window.showPrefToast('Failed to save preferences.', 'error');
        }
    } catch (err) {
        console.error('Error saving preferences:', err);
        window.showPrefToast('Error connecting to the server.', 'error');
    } finally { // <-- Fixed typo here
        btn.disabled = false;
        btn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> Save Preferences`;
    }
};




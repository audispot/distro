const TOO_LOST_BASE_URL = "https://api-sandbox.toolost.com/v1";

      // Helper for Too Lost API Requests
      async function fetchTooLostAPI(endpoint, method = "GET", body = null, apiKey) {
        const options = {
          method,
          headers: {
            "Authorization": `Bearer ${apiKey}`,
            "Content-Type": "application/json"
          }
        };
        if (body) {
          options.body = JSON.stringify(body);
        }
        return await fetch(`${TOO_LOST_BASE_URL}${endpoint}`, options);
      }

// 1. GET Artist Preferences (/api/preferences/artist)
      if (url.pathname === "/api/preferences/artist" && request.method === "GET") {
        if (!userId) {
          return new Response(JSON.stringify({ error: "Unauthorized" }), {
            status: 401,
            headers: { ...corsHeaders, "Content-Type": "application/json" }
          });
        }

        const prefKey = `PREFERENCES_ARTIST_${userId}`;
        let artistData = null;

        // Try fetching directly from Too Lost API upstream first
        try {
          const upstreamRes = await fetchTooLostAPI("/preferences/artist", "GET", null, env.TOO_LOST_API_KEY);
          if (upstreamRes.ok) {
            const upstreamJson = await upstreamRes.json();
            artistData = upstreamJson.data?.artist || upstreamJson.data || null;
      
            // Update KV cache with fresh upstream data
            if (artistData) {
              await env.AUDIORY_KV.put(prefKey, JSON.stringify(artistData));
            }
          }
        } catch (err) {
          console.error("Too Lost API upstream fetch failed, reading from KV cache:", err);
        }

        // Fallback to KV storage if upstream is unreachable or empty
        if (!artistData) {
          const rawData = await env.AUDIORY_KV.get(prefKey);
          artistData = rawData ? JSON.parse(rawData) : null;
        }

        // Dynamic empty schema if no data has been saved yet
        if (!artistData) {
          artistData = {
            artistName: "",
            primaryGenre: "",
            secondaryGenre: "",
            language: "",
            about: "",
            profileImg: null,
            social: { facebook: "", instagram: "", twitter: "", youtube: "" },
            platforms: { spotify: "", soundcloud: "", appleMusic: "", vevo: "", website: "" },
            deliveries: { delivery_youtube: false, delivery_soundexchange: false, delivery_facebook: false },
            releaseTime: "",
            timeZone: "",
            label: "",
            cLine: "",
            pLine: ""
          };
        }

        return new Response(
          JSON.stringify({
            data: { artist: artistData },
            message: "Artist preferences retrieved successfully"
          }),
          { status: 200, headers: { ...corsHeaders, "Content-Type": "application/json" } }
        );
      }

      // 2. POST Submit Artist Preferences (/api/preferences/artist/submit)
      if (url.pathname === "/api/preferences/artist/submit" && request.method === "POST") {
        if (!userId) {
          return new Response(JSON.stringify({ error: "Unauthorized" }), {
            status: 401,
            headers: { ...corsHeaders, "Content-Type": "application/json" }
          });
        }

        const body = await request.json();
        const prefKey = `PREFERENCES_ARTIST_${userId}`;

        // Fetch existing values to maintain structure during partial updates
        const existingRaw = await env.AUDIORY_KV.get(prefKey);
        const existingData = existingRaw ? JSON.parse(existingRaw) : {};

        const updatedData = {
          ...existingData,
          ...body,
          updatedAt: new Date().toISOString()
        };

        // 1. Forward to Too Lost API Upstream
        let upstreamSuccess = false;
        try {
          const upstreamRes = await fetchTooLostAPI("/preferences/artist", "POST", updatedData, env.TOO_LOST_API_KEY);
          if (upstreamRes.ok) {
            upstreamSuccess = true;
          } else {
            console.warn("Too Lost API sync responded with error code:", upstreamRes.status);
          }
        } catch (err) {
          console.error("Failed to forward preferences to Too Lost API:", err);
        }

        // 2. Save state locally in KV storage
        await env.AUDIORY_KV.put(prefKey, JSON.stringify(updatedData));

        return new Response(
          JSON.stringify({ 
            message: "Preferences updated successfully", 
            data: updatedData,
            syncedWithTooLost: upstreamSuccess
          }),
          { status: 200, headers: { ...corsHeaders, "Content-Type": "application/json" } }
        );
      }

      // 3. GET Label Preferences (/api/preferences/label)
      if (url.pathname === "/api/preferences/label" && request.method === "GET") {
        if (!userId) {
          return new Response(JSON.stringify({ error: "Unauthorized" }), {
            status: 401,
            headers: { ...corsHeaders, "Content-Type": "application/json" }
          });
        }

        const labelKey = `PREFERENCES_LABEL_${userId}`;
        let labelData = null;

        // Attempt live upstream call to Too Lost API
        try {
          const upstreamRes = await fetchTooLostAPI("/preferences/label", "GET", null, env.TOO_LOST_API_KEY);
          if (upstreamRes.ok) {
            const upstreamJson = await upstreamRes.json();
            labelData = upstreamJson.data || null;

            if (labelData) {
              await env.AUDIORY_KV.put(labelKey, JSON.stringify(labelData));
            }
          }
        } catch (err) {
          console.error("Too Lost API label preferences fetch failed, using KV:", err);
        }

        // Fallback to KV storage
        if (!labelData) {
          const rawData = await env.AUDIORY_KV.get(labelKey);
          labelData = rawData ? JSON.parse(rawData) : null;
        }

        // Dynamic empty schema if no data has been saved yet
        if (!labelData) {
          labelData = {
            label: {
              name: "",
              about: "",
              profileImg: null,
              social: { facebook: "", instagram: "", twitter: "", youtube: "" },
              platforms: { website: "" }
            },
            artists: []
          };
        }

        return new Response(
          JSON.stringify({ data: labelData, message: "Label preferences retrieved successfully" }),
          { status: 200, headers: { ...corsHeaders, "Content-Type": "application/json" } }
        );
      }

     

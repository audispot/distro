window.fetchSubscriptionAndHistory = async function() {
    const btnCheck = document.getElementById('btn-check-payment-status');
    const iconCheck = document.getElementById('check-status-icon');
    const textCheck = document.getElementById('check-status-text');

    // Set Loading State for "Check Payment Status"
    if (btnCheck) btnCheck.disabled = true;
    if (iconCheck) iconCheck.className = 'fa-solid fa-spinner fa-spin';
    if (textCheck) textCheck.innerText = 'Checking payment status...';

    const token = window.currentUser?.getIdToken ? await window.currentUser.getIdToken() : '';
    const baseUrl = window.WORKER_BASE_URL || '';

    try {
        const res = await fetch(`${baseUrl}/api/billing-history`, {
            headers: { 'Authorization': `Bearer ${token}` }
        });
        
        if (!res.ok) throw new Error('Failed to fetch subscription data');

        const data = await res.json();
        const sub = data.subscription;
        const history = data.history || [];

        // STRICT VERIFICATION: Verify if subscription status is truly Active
        const isVerifiedActive = sub?.status === 'Active';
        const activePlanId = isVerifiedActive ? (sub?.planId || 'starter') : 'starter';

        // Evaluate transaction statuses
        const hasPendingInvoice = history.some(item => item.status === 'Pending');
        const latestTx = history[0];
        const isLatestFailed = latestTx && (latestTx.status === 'Failed' || latestTx.status === 'Cancelled' || latestTx.status === 'Declined');

        if (latestTx && latestTx.planId) {
            window.lastAttemptedPlanId = latestTx.planId;
        }

        // Update Top Active Plan Card
        const planNameEl = document.getElementById('active-plan-name');
        const planStatusEl = document.getElementById('active-plan-status');
        const planBadgeEl = document.getElementById('active-plan-badge');

        if (planNameEl) planNameEl.innerText = sub?.planName || 'Starter Plan';
        if (planStatusEl) planStatusEl.innerText = `Verified Status: ${sub?.status || 'Active'}`;
        if (planBadgeEl) {
            planBadgeEl.innerText = sub?.status || 'Active';
            planBadgeEl.className = isVerifiedActive
                ? 'px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                : 'px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20';
        }

        // Handle Pending / Failed Transaction Banner State
        const pendingBanner = document.getElementById('pending-transaction-banner');
        const bannerIcon = document.getElementById('pending-banner-icon');
        const bannerTitle = document.getElementById('pending-banner-title');
        const bannerDesc = document.getElementById('pending-banner-desc');

        if (pendingBanner) {
            if (hasPendingInvoice) {
                pendingBanner.className = 'bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 flex items-center justify-between gap-4 transition-all';
                if (bannerIcon) bannerIcon.className = 'fa-solid fa-clock text-amber-400 text-lg';
                if (bannerTitle) {
                    bannerTitle.innerText = 'Payment Pending Confirmation';
                    bannerTitle.className = 'text-xs font-bold text-amber-300';
                }
                if (bannerDesc) bannerDesc.innerText = 'An M-Pesa push was sent to your phone. Enter your PIN to activate your tier.';
                
                if (iconCheck) iconCheck.className = 'fa-solid fa-rotate-right';
                if (textCheck) textCheck.innerText = 'Check Payment Status';
                if (btnCheck) {
                    btnCheck.onclick = function() { window.fetchSubscriptionAndHistory(); };
                    btnCheck.className = 'px-3 py-1.5 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5';
                }
                pendingBanner.classList.remove('hidden');
            } else if (isLatestFailed && !isVerifiedActive) {
                pendingBanner.className = 'bg-red-500/10 border border-red-500/30 rounded-2xl p-4 flex items-center justify-between gap-4 transition-all';
                if (bannerIcon) bannerIcon.className = 'fa-solid fa-circle-xmark text-red-400 text-lg';
                if (bannerTitle) {
                    bannerTitle.innerText = 'Payment Failed';
                    bannerTitle.className = 'text-xs font-bold text-red-300';
                }
                if (bannerDesc) bannerDesc.innerText = 'Transaction was cancelled or declined. Please retry to upgrade.';
                
                if (iconCheck) iconCheck.className = 'fa-solid fa-rotate-right';
                if (textCheck) textCheck.innerText = 'Payment Failed - Retry';
                if (btnCheck) {
                    btnCheck.onclick = function() { window.openCheckoutModal(window.lastAttemptedPlanId || 'pro'); };
                    btnCheck.className = 'px-3 py-1.5 bg-red-500/20 hover:bg-red-500/30 text-red-300 rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5';
                }
                pendingBanner.classList.remove('hidden');
            } else {
                pendingBanner.classList.add('hidden');
            }
        }

        // Highlight Plan Selection Buttons based ONLY on active verified plan
        ['starter', 'pro', 'label'].forEach(planKey => {
            const btn = document.getElementById(`btn-plan-${planKey}`);
            if (btn) {
                if (planKey === activePlanId) {
                    btn.innerText = 'Current Plan';
                    btn.disabled = true;
                    btn.className = 'mt-6 w-full py-2.5 px-4 rounded-xl text-xs font-semibold bg-gray-800 text-gray-500 cursor-not-allowed';
                } else {
                    btn.disabled = false;
                    btn.innerText = (planKey === 'pro') ? 'Upgrade to Pro' : (planKey === 'label' ? 'Upgrade to Label' : 'Select Free Plan');
                    btn.className = (planKey === 'pro') 
                        ? 'mt-6 w-full py-2.5 px-4 rounded-xl text-xs font-semibold bg-brand-accent text-black hover:brightness-110 transition-all font-bold'
                        : 'mt-6 w-full py-2.5 px-4 rounded-xl text-xs font-semibold border border-brand-border text-gray-300 hover:text-white hover:bg-brand-border/40 transition-all';
                }
            }
        });

        // Render Billing History Table
        const tbody = document.getElementById('billing-history-tbody');
        if (tbody) {
            if (history.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-gray-500">No payment records found.</td></tr>`;
            } else {
                tbody.innerHTML = history.map(item => `
                    <tr>
                        <td class="py-3 px-4 font-mono font-bold text-white">${item.invoiceId || 'N/A'}</td>
                        <td class="py-3 px-4">${item.date || '-'}</td>
                        <td class="py-3 px-4 capitalize">${item.description || 'Subscription Upgrade'}</td>
                        <td class="py-3 px-4 uppercase font-bold text-gray-400">${item.gateway || 'Card'}</td>
                        <td class="py-3 px-4 font-bold text-white">$${item.amount || '0.00'}</td>
                        <td class="py-3 px-4">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
                                item.status === 'Paid' 
                                    ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' 
                                    : (item.status === 'Pending' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20')
                            }">
                                ${item.status}
                            </span>
                        </td>
                    </tr>
                `).join('');
            }
        }
    } catch (err) {
        console.error('Error fetching subscription history:', err);
    } finally {
        if (btnCheck) btnCheck.disabled = false;
    }
};

window.openCheckoutModal = function(planId) {
    const modal = document.getElementById('checkoutModal');
    const planInput = document.getElementById('selected_plan_id');
    const planDesc = document.getElementById('checkout-plan-desc');
    const msgEl = document.getElementById('checkout-status-msg');

    if (planInput) planInput.value = planId;
    if (planDesc) {
        const names = { starter: 'Starter Plan ($0.00)', pro: 'Pro Artist Plan ($19.99/yr)', label: 'Label Partner Plan ($49.99/yr)' };
        planDesc.innerText = `Upgrading to ${names[planId] || planId}`;
    }

    if (msgEl) {
        msgEl.innerText = '';
        msgEl.classList.add('hidden');
    }

    if (modal) modal.classList.remove('hidden');
};

window.closeCheckoutModal = function() {
    const modal = document.getElementById('checkoutModal');
    if (modal) modal.classList.add('hidden');
};

window.togglePaymentInputs = function(method) {
    const mpesaField = document.getElementById('mpesa-field');
    if (mpesaField) {
        mpesaField.style.display = (method === 'mpesa') ? 'block' : 'none';
    }
};

window.handleUpgradeSubmit = async function(e) {
    e.preventDefault();

    const planId = document.getElementById('selected_plan_id')?.value;
    const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value || 'mpesa';
    const phone = document.getElementById('checkout_phone')?.value?.trim();

    const submitBtn = document.getElementById('btn-submit-upgrade');
    const msgEl = document.getElementById('checkout-status-msg');

    if (paymentMethod === 'mpesa' && (!phone || phone.length < 10)) {
        if (msgEl) {
            msgEl.innerText = 'Please provide a valid M-Pesa phone number (e.g. 2547XXXXXXXX).';
            msgEl.classList.remove('hidden');
        }
        return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (msgEl) {
        msgEl.innerText = 'Subscribing...';
        msgEl.classList.remove('hidden');
    }

    try {
        const token = window.currentUser?.getIdToken ? await window.currentUser.getIdToken() : '';
        const baseUrl = window.WORKER_BASE_URL || '';

        const res = await fetch(`${baseUrl}/api/subscription/upgrade`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({
                planId: planId,
                paymentMethod: paymentMethod,
                phone: phone,
                email: window.currentUser?.email || '',
                displayName: window.currentUser?.displayName || 'Artist'
            })
        });

        const data = await res.json();

        if (!res.ok) {
            throw new Error(data?.error || 'Upgrade request failed');
        }

        // Redirects (PayPal/PesaPal)
        if (data.redirectUrl) {
            if (msgEl) msgEl.innerText = 'Redirecting to payment portal...';
            window.location.href = data.redirectUrl;
            return;
        }

        // M-Pesa STK Push
        if (data.requiresManualAction) {
            if (msgEl) {
                msgEl.innerText = 'STK Push sent! Please enter your M-Pesa PIN on your phone.';
            }
            setTimeout(() => {
                window.closeCheckoutModal();
                window.fetchSubscriptionAndHistory();
            }, 3000);
            return;
        }

        // Free Plan or Direct Confirmations
        if (msgEl) msgEl.innerText = 'Request processed successfully!';
        setTimeout(() => {
            window.closeCheckoutModal();
            window.fetchSubscriptionAndHistory();
        }, 1500);

    } catch (err) {
        if (msgEl) {
            msgEl.innerText = err.message || 'Payment processing failed.';
        }
    } finally {
        if (submitBtn) submitBtn.disabled = false;
    }
};
